<!-- Villain lines: dark silhouette with glowing red eyes, cape, and sinister speech bubble -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Dark background gradient -->
  <defs>
    <radialGradient id="villainBg" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#4a148c"/>
      <stop offset="100%" stop-color="#1a0033"/>
    </radialGradient>
  </defs>
  <rect width="200" height="160" rx="8" fill="url(#villainBg)"/>

  <!-- Distant moon -->
  <circle cx="160" cy="35" r="14" fill="#e1bee7" opacity="0.85"/>
  <circle cx="163" cy="32" r="3" fill="#b39ddb" opacity="0.6"/>
  <circle cx="156" cy="40" r="2" fill="#b39ddb" opacity="0.5"/>

  <!-- Cape/body silhouette (curved) -->
  <path d="M60,145 Q40,120 45,85 Q48,65 68,55 Q80,48 95,55 Q115,52 122,70 Q130,95 120,130 Q115,145 100,148 Z" fill="#0d0020"/>

  <!-- Collar (raised) -->
  <path d="M70,58 L75,40 L85,52 L95,40 L100,58" fill="#0d0020" stroke="#6a1b9a" stroke-width="1"/>

  <!-- Head (obscured under hood/collar) -->
  <ellipse cx="85" cy="68" rx="14" ry="12" fill="#1a0033"/>

  <!-- Glowing red eyes -->
  <ellipse cx="80" cy="66" rx="3" ry="1.8" fill="#ff1744"/>
  <ellipse cx="90" cy="66" rx="3" ry="1.8" fill="#ff1744"/>
  <!-- Eye glow -->
  <ellipse cx="80" cy="66" rx="5" ry="3" fill="#ff1744" opacity="0.3"/>
  <ellipse cx="90" cy="66" rx="5" ry="3" fill="#ff1744" opacity="0.3"/>

  <!-- Smirking mouth -->
  <path d="M76,80 Q85,86 94,78" fill="none" stroke="#ff1744" stroke-width="1.5" stroke-linecap="round"/>

  <!-- Raised hand (gesturing menacingly) -->
  <path d="M118,95 Q130,90 138,82 L142,78 L140,85 L145,82 L142,90 L148,88 L143,95 L148,96 L140,100 L132,103 Z" fill="#0d0020"/>

  <!-- Dark aura / wispy energy -->
  <path d="M45,90 Q35,80 30,65" fill="none" stroke="#9c27b0" stroke-width="1.5" opacity="0.6" stroke-linecap="round"/>
  <path d="M122,90 Q135,82 142,65" fill="none" stroke="#9c27b0" stroke-width="1.5" opacity="0.6" stroke-linecap="round"/>
  <path d="M50,50 Q45,42 40,40" fill="none" stroke="#7b1fa2" stroke-width="1.2" opacity="0.5" stroke-linecap="round"/>

  <!-- Sinister speech bubble: フフフ -->
  <path d="M118,110 Q118,102 128,102 L175,102 Q183,102 183,110 L183,128 Q183,136 175,136 L145,136 L138,143 L140,136 L128,136 Q118,136 118,128 Z" fill="#311b92" stroke="#b388ff" stroke-width="1.2"/>
  <text x="150" y="124" text-anchor="middle" font-family="sans-serif" font-size="14" fill="#e1bee7" font-weight="bold">フフフ…</text>

  <!-- Sparks of magic near hand -->
  <circle cx="148" cy="78" r="1.5" fill="#e040fb" opacity="0.8"/>
  <circle cx="152" cy="85" r="1" fill="#e040fb" opacity="0.7"/>
  <circle cx="143" cy="70" r="1.2" fill="#e040fb" opacity="0.6"/>

  <!-- Ground mist -->
  <ellipse cx="100" cy="150" rx="60" ry="4" fill="#1a0033" opacity="0.6"/>
</svg>
