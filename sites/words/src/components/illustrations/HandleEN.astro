<!-- Japanese ハンドル = steering wheel (not "handle") -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "handle?" crossed out -->
  <rect x="18" y="18" width="75" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="38,46 48,46 43,54" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="55" y="37" font-size="11" fill="#424242" text-anchor="middle">"handle?"</text>
  <!-- Red X over phrase -->
  <line x1="22" y1="20" x2="89" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="89" y1="20" x2="22" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="26" y="64" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="60" y="68" font-size="18" font-weight="bold" fill="#ff7043">?</text>
  <text x="92" y="58" font-size="12" font-weight="bold" fill="#ff7043">?</text>
  <!-- Confused English speaker -->
  <!-- Head -->
  <circle cx="45" cy="88" r="14" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M32,85 Q32,73 45,71 Q58,73 58,85 L55,81 Q45,77 35,81 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="40" cy="88" r="1.5" fill="#3e2723"/>
  <circle cx="50" cy="88" r="1.5" fill="#3e2723"/>
  <!-- Confused mouth (wavy) -->
  <path d="M40,95 Q43,93 46,95 Q49,97 52,95" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Body -->
  <rect x="35" y="102" width="20" height="22" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms (raised) -->
  <line x1="35" y1="105" x2="22" y2="96" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="55" y1="105" x2="68" y2="96" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Open palms -->
  <circle cx="20" cy="95" r="3" fill="#ffe0b2"/>
  <circle cx="70" cy="95" r="3" fill="#ffe0b2"/>
  <!-- Steering wheel (correct answer) -->
  <!-- Outer ring -->
  <circle cx="145" cy="88" r="26" fill="none" stroke="#37474f" stroke-width="5"/>
  <!-- Inner hub -->
  <circle cx="145" cy="88" r="7" fill="#546e7a"/>
  <!-- Spokes -->
  <line x1="145" y1="88" x2="122" y2="88" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <line x1="145" y1="88" x2="168" y2="88" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <line x1="145" y1="88" x2="145" y2="111" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <!-- Center logo -->
  <circle cx="145" cy="88" r="3" fill="#ffcc80"/>
  <!-- "steering wheel" label -->
  <text x="145" y="140" font-size="10" font-weight="bold" fill="#2e7d32" text-anchor="middle">steering wheel ✓</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
