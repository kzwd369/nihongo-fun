<!-- English "front glass" is wasei-eigo — correct: "windshield" (US) / "windscreen" (UK) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "front glass?" crossed out -->
  <rect x="15" y="15" width="80" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="35,43 45,43 40,51" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="55" y="33" font-size="10" fill="#424242" text-anchor="middle">"front glass?"</text>
  <!-- Red X over phrase -->
  <line x1="20" y1="18" x2="90" y2="41" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="90" y1="18" x2="20" y2="41" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Confused English speaker -->
  <!-- Head -->
  <circle cx="40" cy="80" r="13" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M28,77 Q28,66 40,64 Q52,66 52,77 L50,74 Q40,70 30,74 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="36" cy="80" r="1.5" fill="#3e2723"/>
  <circle cx="44" cy="80" r="1.5" fill="#3e2723"/>
  <!-- Confused mouth -->
  <path d="M35,87 Q38,85 41,87 Q44,89 47,87" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="22" y="62" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="56" y="66" font-size="16" font-weight="bold" fill="#ff7043">?</text>
  <!-- Body -->
  <rect x="31" y="93" width="18" height="20" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms -->
  <line x1="31" y1="96" x2="20" y2="88" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="49" y1="96" x2="60" y2="88" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Thought bubble: lone pane of glass (what speaker imagines) -->
  <rect x="66" y="100" width="26" height="20" fill="#b3e5fc" stroke="#0288d1" stroke-width="1.5" rx="1" opacity="0.85"/>
  <line x1="70" y1="104" x2="88" y2="116" stroke="white" stroke-width="1" opacity="0.8"/>
  <!-- Car with windshield on right side -->
  <!-- Car body -->
  <path d="M110,105 L118,85 Q120,82 124,82 L166,82 Q170,82 172,85 L180,105 Z" fill="#ef9a9a" stroke="#c62828" stroke-width="1.5"/>
  <!-- Windshield (front glass) highlighted -->
  <path d="M122,103 L128,88 Q129,86 132,86 L158,86 Q161,86 162,88 L168,103 Z" fill="#b3e5fc" stroke="#0277bd" stroke-width="1.5"/>
  <!-- Windshield pillar -->
  <line x1="145" y1="86" x2="145" y2="103" stroke="#0277bd" stroke-width="0.5" opacity="0.5"/>
  <!-- Wipers on windshield -->
  <line x1="135" y1="102" x2="130" y2="92" stroke="#37474f" stroke-width="1.5" stroke-linecap="round"/>
  <line x1="155" y1="102" x2="150" y2="92" stroke="#37474f" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Car bottom -->
  <rect x="108" y="105" width="74" height="12" fill="#e57373" stroke="#c62828" stroke-width="1.5" rx="2"/>
  <!-- Wheels -->
  <circle cx="122" cy="119" r="6" fill="#37474f"/>
  <circle cx="122" cy="119" r="2.5" fill="#90a4ae"/>
  <circle cx="168" cy="119" r="6" fill="#37474f"/>
  <circle cx="168" cy="119" r="2.5" fill="#90a4ae"/>
  <!-- Arrow pointing to windshield -->
  <line x1="145" y1="70" x2="145" y2="82" stroke="#2e7d32" stroke-width="1.5"/>
  <polygon points="142,80 148,80 145,85" fill="#2e7d32"/>
  <!-- "windshield ✓" label -->
  <text x="145" y="65" font-size="9" font-weight="bold" fill="#2e7d32" text-anchor="middle">windshield ✓</text>
  <text x="145" y="140" font-size="9" font-weight="bold" fill="#2e7d32" text-anchor="middle">windscreen ✓ (UK)</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
