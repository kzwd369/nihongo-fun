<!-- Pouting puffed-cheek face with steam — プンプン (huffy, cute anger) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#ffebee" rx="8"/>
  <!-- Faint angry glow -->
  <circle cx="100" cy="88" r="60" fill="#ffcdd2" opacity="0.5"/>
  <!-- Steam puffs rising from head -->
  <ellipse cx="72" cy="30" rx="9" ry="7" fill="#fff" opacity="0.85"/>
  <ellipse cx="66" cy="22" rx="6" ry="5" fill="#fff" opacity="0.7"/>
  <ellipse cx="128" cy="30" rx="9" ry="7" fill="#fff" opacity="0.85"/>
  <ellipse cx="134" cy="22" rx="6" ry="5" fill="#fff" opacity="0.7"/>
  <!-- Anger vein mark (top right of face) -->
  <path d="M132,52 L142,48 M137,46 L141,56 M127,50 L138,57" stroke="#e53935" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Face — puffed, slightly wide for huffy cheeks -->
  <ellipse cx="100" cy="90" rx="54" ry="50" fill="#ffe0b2"/>
  <!-- Puffed cheeks -->
  <circle cx="62" cy="98" r="18" fill="#ffab91" opacity="0.55"/>
  <circle cx="138" cy="98" r="18" fill="#ffab91" opacity="0.55"/>
  <!-- Angry slanted eyebrows -->
  <path d="M70,68 L92,78" stroke="#5d4037" stroke-width="3.5" stroke-linecap="round"/>
  <path d="M130,68 L108,78" stroke="#5d4037" stroke-width="3.5" stroke-linecap="round"/>
  <!-- Angry eyes (slanted down toward center) -->
  <path d="M76,86 Q84,80 92,84" fill="none" stroke="#5d4037" stroke-width="3" stroke-linecap="round"/>
  <path d="M124,86 Q116,80 108,84" fill="none" stroke="#5d4037" stroke-width="3" stroke-linecap="round"/>
  <!-- Pouting mouth -->
  <path d="M88,108 Q100,100 112,108" fill="none" stroke="#5d4037" stroke-width="3" stroke-linecap="round"/>
  <!-- Crossed-arm huff dashes around face -->
  <line x1="30" y1="70" x2="20" y2="64" stroke="#ef5350" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
  <line x1="28" y1="82" x2="17" y2="80" stroke="#ef5350" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
  <line x1="170" y1="70" x2="180" y2="64" stroke="#ef5350" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
  <line x1="172" y1="82" x2="183" y2="80" stroke="#ef5350" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
  <!-- Small "!" emphasis marks -->
  <text x="40" y="130" font-family="sans-serif" font-size="20" font-weight="bold" fill="#e53935" opacity="0.7">!</text>
  <text x="158" y="128" font-family="sans-serif" font-size="16" font-weight="bold" fill="#e53935" opacity="0.6">!</text>
</svg>
