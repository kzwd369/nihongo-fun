<!-- ペットボトル = plastic drink bottle for tea/water/juice (English: plastic bottle / water bottle). Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="pb-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e1f5fe"/>
      <stop offset="100%" stop-color="#b3e5fc"/>
    </linearGradient>
    <linearGradient id="pb-water" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#81d4fa"/>
      <stop offset="100%" stop-color="#4fc3f7"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#pb-bg)" rx="8"/>
  <!-- Plastic drink bottle (centered) -->
  <!-- Cap -->
  <rect x="90" y="20" width="20" height="12" rx="2" fill="#1976d2"/>
  <line x1="92" y1="22" x2="92" y2="30" stroke="#1565c0" stroke-width="0.8"/>
  <line x1="96" y1="22" x2="96" y2="30" stroke="#1565c0" stroke-width="0.8"/>
  <line x1="100" y1="22" x2="100" y2="30" stroke="#1565c0" stroke-width="0.8"/>
  <line x1="104" y1="22" x2="104" y2="30" stroke="#1565c0" stroke-width="0.8"/>
  <line x1="108" y1="22" x2="108" y2="30" stroke="#1565c0" stroke-width="0.8"/>
  <!-- Neck -->
  <rect x="92" y="32" width="16" height="10" fill="#cfd8dc" opacity="0.6"/>
  <!-- Bottle body outline -->
  <path d="M90 42 Q86 48 86 56 L86 130 Q86 142 100 142 Q114 142 114 130 L114 56 Q114 48 110 42 Z"
        fill="#e3f2fd" stroke="#90caf9" stroke-width="1.4" opacity="0.85"/>
  <!-- Water fill (lower portion) -->
  <path d="M86 70 L114 70 L114 130 Q114 142 100 142 Q86 142 86 130 Z" fill="url(#pb-water)" opacity="0.75"/>
  <!-- Water surface ellipse -->
  <ellipse cx="100" cy="70" rx="14" ry="3" fill="#b3e5fc" opacity="0.9"/>
  <!-- Grip ridges (the pinched middle ring) -->
  <line x1="86" y1="96" x2="114" y2="96" stroke="#90caf9" stroke-width="1"/>
  <line x1="86" y1="100" x2="114" y2="100" stroke="#90caf9" stroke-width="1"/>
  <line x1="86" y1="104" x2="114" y2="104" stroke="#90caf9" stroke-width="1"/>
  <!-- Label band (blank, no text) -->
  <rect x="86" y="78" width="28" height="14" fill="#ffffff" opacity="0.85"/>
  <rect x="86" y="80" width="28" height="3" fill="#43a047" opacity="0.8"/>
  <!-- Tea/leaf hint on label (shape only) -->
  <path d="M96 87 Q100 83 104 87 Q100 90 96 87 Z" fill="#66bb6a" opacity="0.8"/>
  <!-- Highlight reflection down the bottle -->
  <rect x="91" y="50" width="3" height="80" rx="1.5" fill="#ffffff" opacity="0.6"/>
  <!-- Recycle hint: small triangle of arrows (bottle recycling culture) -->
  <g transform="translate(150,118)" opacity="0.6">
    <path d="M0 -8 L7 4 L-7 4 Z" fill="none" stroke="#43a047" stroke-width="2" stroke-linejoin="round"/>
  </g>
  <!-- Water droplets / sparkles (shapes only) -->
  <path d="M44 110 Q41 116 47 116 Q50 116 44 110 Z" fill="#4fc3f7" opacity="0.7"/>
  <polygon points="140,44 141.5,40 143,44 147,45.5 143,47 141.5,51 140,47 136,45.5" fill="#4fc3f7" opacity="0.7"/>
  <polygon points="50,50 51,47 52,50 55,51 52,52 51,55 50,52 47,51" fill="#4fc3f7" opacity="0.6"/>
</svg>
