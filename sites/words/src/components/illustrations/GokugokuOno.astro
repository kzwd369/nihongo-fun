<!-- Glass of water being gulped down — ごくごく (gulping) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e3f2fd" rx="8"/>
  <!-- Glass body (tapered) -->
  <path d="M72 38 L128 38 L120 138 L80 138 Z" fill="#bbdefb" opacity="0.5"/>
  <path d="M72 38 L128 38 L120 138 L80 138 Z" fill="none" stroke="#64b5f6" stroke-width="2.5" stroke-linejoin="round"/>
  <!-- Water inside -->
  <path d="M77 62 L123 62 L120 138 L80 138 Z" fill="#42a5f5" opacity="0.7"/>
  <!-- Water surface -->
  <ellipse cx="100" cy="62" rx="23" ry="4" fill="#90caf9"/>
  <!-- Bubbles rising -->
  <circle cx="92" cy="90" r="4" fill="white" opacity="0.7"/>
  <circle cx="108" cy="105" r="3" fill="white" opacity="0.6"/>
  <circle cx="98" cy="118" r="2.5" fill="white" opacity="0.5"/>
  <!-- Splash droplets at top -->
  <path d="M100 30 C100 30 96 22 100 18 C104 22 100 30 100 30Z" fill="#64b5f6"/>
  <circle cx="84" cy="26" r="3" fill="#64b5f6" opacity="0.8"/>
  <circle cx="118" cy="28" r="2.5" fill="#64b5f6" opacity="0.7"/>
  <!-- Motion lines (gulping rhythm) -->
  <line x1="140" y1="70" x2="156" y2="70" stroke="#42a5f5" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
  <line x1="140" y1="84" x2="160" y2="84" stroke="#42a5f5" stroke-width="2.5" stroke-linecap="round" opacity="0.4"/>
  <line x1="140" y1="98" x2="154" y2="98" stroke="#42a5f5" stroke-width="2.5" stroke-linecap="round" opacity="0.3"/>
</svg>
