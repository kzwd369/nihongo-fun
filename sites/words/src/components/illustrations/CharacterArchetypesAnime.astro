<!-- Character archetypes: three faces showing tsundere (spikes), kuudere (cool), and dere (heart) -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Background -->
  <rect width="200" height="160" rx="8" fill="#f3e5f5"/>

  <!-- Left face: tsundere (pouty with spike lines) -->
  <circle cx="45" cy="78" r="22" fill="#ffccbc"/>
  <!-- Eyes (narrowed / annoyed) -->
  <line x1="37" y1="74" x2="43" y2="74" stroke="#4a148c" stroke-width="2" stroke-linecap="round"/>
  <line x1="47" y1="74" x2="53" y2="74" stroke="#4a148c" stroke-width="2" stroke-linecap="round"/>
  <!-- Cheek blush -->
  <circle cx="36" cy="82" r="2.5" fill="#f48fb1" opacity="0.6"/>
  <circle cx="54" cy="82" r="2.5" fill="#f48fb1" opacity="0.6"/>
  <!-- Frown mouth -->
  <path d="M40,88 Q45,85 50,88" fill="none" stroke="#4a148c" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Tsun spikes around head -->
  <path d="M25,58 L20,50 M65,58 L70,50 M30,98 L24,104 M60,98 L66,104" stroke="#ab47bc" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
  <!-- Label -->
  <text x="45" y="122" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#6a1b9a" font-weight="bold">ツン</text>

  <!-- Middle face: kuudere (stoic) -->
  <circle cx="100" cy="78" r="22" fill="#b3e5fc"/>
  <!-- Flat eyes -->
  <line x1="91" y1="74" x2="96" y2="74" stroke="#01579b" stroke-width="2" stroke-linecap="round"/>
  <line x1="104" y1="74" x2="109" y2="74" stroke="#01579b" stroke-width="2" stroke-linecap="round"/>
  <!-- Flat mouth -->
  <line x1="95" y1="88" x2="105" y2="88" stroke="#01579b" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Cool aura (snowflake-like) -->
  <circle cx="78" cy="64" r="1.5" fill="#4fc3f7" opacity="0.6"/>
  <circle cx="122" cy="64" r="1.5" fill="#4fc3f7" opacity="0.6"/>
  <circle cx="85" cy="100" r="1.2" fill="#4fc3f7" opacity="0.5"/>
  <!-- Label -->
  <text x="100" y="122" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#01579b" font-weight="bold">クー</text>

  <!-- Right face: dere (blushing, hearts) -->
  <circle cx="155" cy="78" r="22" fill="#f8bbd0"/>
  <!-- Happy/curved eyes -->
  <path d="M146,74 Q149,70 152,74" fill="none" stroke="#880e4f" stroke-width="2" stroke-linecap="round"/>
  <path d="M158,74 Q161,70 164,74" fill="none" stroke="#880e4f" stroke-width="2" stroke-linecap="round"/>
  <!-- Big blush -->
  <circle cx="144" cy="84" r="3.5" fill="#ec407a" opacity="0.6"/>
  <circle cx="166" cy="84" r="3.5" fill="#ec407a" opacity="0.6"/>
  <!-- Smiling mouth -->
  <path d="M150,88 Q155,93 160,88" fill="none" stroke="#880e4f" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Floating hearts -->
  <path d="M178,58 C178,58 176,56 174,57 C172,58 172,60 174,62 L178,65 L182,62 C184,60 184,58 182,57 C180,56 178,58 178,58Z" fill="#ec407a" opacity="0.7"/>
  <path d="M135,55 C135,55 134,54 133,54.5 C132,55 132,56 133,57 L135,58.5 L137,57 C138,56 138,55 137,54.5 C136,54 135,55 135,55Z" fill="#ec407a" opacity="0.6"/>
  <!-- Label -->
  <text x="155" y="122" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#880e4f" font-weight="bold">デレ</text>

  <!-- Base line -->
  <line x1="20" y1="140" x2="180" y2="140" stroke="#ce93d8" stroke-width="1" opacity="0.5"/>
</svg>
