<!-- English "Velcro" / hook-and-loop fastener = close-up of the two mating surfaces: a hook strip and a loop strip pressing together. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="mten-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#80cbc4"/>
      <stop offset="100%" stop-color="#e0f2f1"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#mten-bg)" rx="8"/>
  <!-- Upper strip: HOOK surface (little hooks on the underside) -->
  <rect x="38" y="42" width="124" height="26" rx="4" fill="#455a64"/>
  <rect x="38" y="42" width="124" height="6" rx="4" fill="#607d8b"/>
  <!-- hooks hanging from underside -->
  <path d="M48 68 q0 8 6 8 q4 0 4 -4" fill="none" stroke="#90a4ae" stroke-width="1.6"/>
  <path d="M64 68 q0 8 6 8 q4 0 4 -4" fill="none" stroke="#90a4ae" stroke-width="1.6"/>
  <path d="M80 68 q0 8 6 8 q4 0 4 -4" fill="none" stroke="#90a4ae" stroke-width="1.6"/>
  <path d="M96 68 q0 8 6 8 q4 0 4 -4" fill="none" stroke="#90a4ae" stroke-width="1.6"/>
  <path d="M112 68 q0 8 6 8 q4 0 4 -4" fill="none" stroke="#90a4ae" stroke-width="1.6"/>
  <path d="M128 68 q0 8 6 8 q4 0 4 -4" fill="none" stroke="#90a4ae" stroke-width="1.6"/>
  <path d="M144 68 q0 8 6 8 q4 0 4 -4" fill="none" stroke="#90a4ae" stroke-width="1.6"/>
  <!-- Lower strip: LOOP surface (little loops on top) -->
  <rect x="38" y="92" width="124" height="26" rx="4" fill="#37474f"/>
  <rect x="38" y="112" width="124" height="6" rx="4" fill="#263238"/>
  <!-- loops standing on top -->
  <path d="M48 92 q0 -8 6 -8 q6 0 6 8" fill="none" stroke="#b0bec5" stroke-width="1.6"/>
  <path d="M64 92 q0 -8 6 -8 q6 0 6 8" fill="none" stroke="#b0bec5" stroke-width="1.6"/>
  <path d="M80 92 q0 -8 6 -8 q6 0 6 8" fill="none" stroke="#b0bec5" stroke-width="1.6"/>
  <path d="M96 92 q0 -8 6 -8 q6 0 6 8" fill="none" stroke="#b0bec5" stroke-width="1.6"/>
  <path d="M112 92 q0 -8 6 -8 q6 0 6 8" fill="none" stroke="#b0bec5" stroke-width="1.6"/>
  <path d="M128 92 q0 -8 6 -8 q6 0 6 8" fill="none" stroke="#b0bec5" stroke-width="1.6"/>
  <path d="M144 92 q0 -8 6 -8 q6 0 6 8" fill="none" stroke="#b0bec5" stroke-width="1.6"/>
  <!-- arrows showing the two surfaces meeting -->
  <line x1="174" y1="64" x2="174" y2="78" stroke="#00695c" stroke-width="2" stroke-linecap="round"/>
  <polygon points="170,76 174,84 178,76" fill="#00695c"/>
  <line x1="26" y1="96" x2="26" y2="82" stroke="#00695c" stroke-width="2" stroke-linecap="round"/>
  <polygon points="22,84 26,76 30,84" fill="#00695c"/>
</svg>
