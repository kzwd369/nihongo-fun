<!-- English "doctor stop" is not a natural phrase — correct: "doctor's orders (to stop)" -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "doctor stop?" crossed out -->
  <rect x="12" y="18" width="82" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="30,46 40,46 35,54" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="53" y="36" font-size="10" fill="#424242" text-anchor="middle">"doctor stop?"</text>
  <!-- Red X over phrase -->
  <line x1="17" y1="20" x2="89" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="89" y1="20" x2="17" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Confused person on left -->
  <circle cx="35" cy="85" r="12" fill="#ffe0b2"/>
  <path d="M24,83 Q24,72 35,70 Q46,72 46,83 L43,79 Q35,75 27,79 Z" fill="#8d6e63"/>
  <circle cx="31" cy="85" r="1.3" fill="#3e2723"/>
  <circle cx="39" cy="85" r="1.3" fill="#3e2723"/>
  <path d="M31,91 Q33,89 35,91 Q37,93 39,91" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <text x="20" y="68" font-size="12" font-weight="bold" fill="#ff7043">?</text>
  <rect x="27" y="97" width="16" height="20" fill="#90caf9" rx="3"/>
  <line x1="27" y1="100" x2="18" y2="94" stroke="#90caf9" stroke-width="4" stroke-linecap="round"/>
  <line x1="43" y1="100" x2="52" y2="94" stroke="#90caf9" stroke-width="4" stroke-linecap="round"/>
  <!-- Doctor on right giving STOP gesture -->
  <!-- Head -->
  <circle cx="135" cy="62" r="12" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M124,60 Q124,48 135,47 Q146,48 146,60 L143,57 Q135,53 127,57 Z" fill="#3e2723"/>
  <!-- Eyes (stern) -->
  <path d="M129,62 Q131,60 133,62" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <path d="M137,62 Q139,60 141,62" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <!-- Serious mouth -->
  <line x1="132" y1="69" x2="138" y2="69" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <!-- White coat body -->
  <rect x="122" y="74" width="26" height="30" fill="white" stroke="#cfd8dc" stroke-width="1" rx="3"/>
  <!-- Collar V -->
  <polygon points="135,74 130,85 140,85" fill="#eceff1"/>
  <!-- Stethoscope -->
  <path d="M130,86 Q128,94 132,98" fill="none" stroke="#37474f" stroke-width="1.2"/>
  <path d="M140,86 Q142,94 138,98" fill="none" stroke="#37474f" stroke-width="1.2"/>
  <circle cx="135" cy="100" r="2" fill="#37474f"/>
  <!-- Left arm (at side) -->
  <line x1="122" y1="80" x2="118" y2="95" stroke="white" stroke-width="5" stroke-linecap="round"/>
  <!-- Right arm raised with palm STOP -->
  <line x1="148" y1="80" x2="165" y2="58" stroke="white" stroke-width="5" stroke-linecap="round"/>
  <!-- Palm -->
  <circle cx="168" cy="54" r="8" fill="#ffcc80" stroke="#ef6c00" stroke-width="1"/>
  <!-- STOP octagon behind palm -->
  <polygon points="172,40 180,40 186,46 186,54 180,60 172,60 166,54 166,46" fill="#e53935" stroke="#b71c1c" stroke-width="1" opacity="0.85"/>
  <text x="176" y="53" font-size="6" font-weight="bold" fill="white" text-anchor="middle">STOP</text>
  <!-- Legs -->
  <rect x="125" y="104" width="7" height="18" fill="#455a64"/>
  <rect x="138" y="104" width="7" height="18" fill="#455a64"/>
  <!-- Label "doctor's orders ✓" -->
  <text x="135" y="140" font-size="10" font-weight="bold" fill="#2e7d32" text-anchor="middle">doctor's orders ✓</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
