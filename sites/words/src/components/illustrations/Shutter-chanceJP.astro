<!-- Japanese シャッターチャンス = the perfect moment to take a photo -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Mt. Fuji in background -->
  <polygon points="115,95 145,45 175,95" fill="#90caf9" opacity="0.85"/>
  <!-- Snow cap -->
  <polygon points="135,60 145,45 155,60 152,63 148,58 145,62 142,58 138,63" fill="white"/>
  <!-- Sun -->
  <circle cx="175" cy="35" r="8" fill="#ffca28"/>
  <!-- Sun rays -->
  <g stroke="#ffca28" stroke-width="1.5" stroke-linecap="round">
    <line x1="175" y1="22" x2="175" y2="18"/>
    <line x1="186" y1="28" x2="190" y2="25"/>
    <line x1="164" y1="28" x2="160" y2="25"/>
  </g>
  <!-- Person holding camera -->
  <!-- Head -->
  <circle cx="55" cy="58" r="12" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M44,56 Q43,44 55,42 Q67,44 66,56 L63,52 Q55,48 47,52 Z" fill="#3e2723"/>
  <!-- Camera hides eyes area (held up to face) -->
  <!-- Camera body -->
  <rect x="40" y="58" width="38" height="22" fill="#37474f" rx="3"/>
  <!-- Top bump -->
  <rect x="54" y="53" width="12" height="6" fill="#263238" rx="1"/>
  <!-- Lens -->
  <circle cx="59" cy="69" r="9" fill="#546e7a"/>
  <circle cx="59" cy="69" r="6" fill="#263238"/>
  <circle cx="59" cy="69" r="3" fill="#90a4ae"/>
  <circle cx="57" cy="67" r="1" fill="white" opacity="0.8"/>
  <!-- Flash -->
  <rect x="42" y="55" width="6" height="5" fill="#fff59d" stroke="#fbc02d" stroke-width="0.8" rx="1"/>
  <!-- Shutter button -->
  <circle cx="74" cy="56" r="2" fill="#e53935"/>
  <!-- Flash burst star -->
  <text x="32" y="52" font-size="16" fill="#fbc02d" font-weight="bold">☆</text>
  <g stroke="#fdd835" stroke-width="1.8" stroke-linecap="round">
    <line x1="38" y1="48" x2="33" y2="44"/>
    <line x1="30" y1="58" x2="24" y2="58"/>
  </g>
  <!-- Body -->
  <rect x="45" y="80" width="22" height="26" fill="#ef9a9a" rx="3"/>
  <!-- Arms holding camera -->
  <line x1="45" y1="82" x2="40" y2="72" stroke="#ffcc80" stroke-width="5" stroke-linecap="round"/>
  <line x1="67" y1="82" x2="78" y2="72" stroke="#ffcc80" stroke-width="5" stroke-linecap="round"/>
  <!-- Legs -->
  <rect x="48" y="106" width="7" height="18" fill="#5d4037"/>
  <rect x="57" y="106" width="7" height="18" fill="#5d4037"/>
  <!-- Smiling child (subject) -->
  <!-- Head -->
  <circle cx="140" cy="98" r="10" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M131,96 Q131,86 140,85 Q149,86 149,96 L146,93 Q140,90 134,93 Z" fill="#3e2723"/>
  <!-- Smiling eyes -->
  <path d="M135,97 Q137,95 139,97" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <path d="M141,97 Q143,95 145,97" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <!-- Big smile -->
  <path d="M136,102 Q140,106 144,102" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Body -->
  <rect x="132" y="108" width="16" height="18" fill="#ffab91" rx="3"/>
  <!-- Arms up (waving) -->
  <line x1="132" y1="110" x2="126" y2="100" stroke="#ffcc80" stroke-width="4" stroke-linecap="round"/>
  <line x1="148" y1="110" x2="154" y2="100" stroke="#ffcc80" stroke-width="4" stroke-linecap="round"/>
  <!-- Sparkle near child (the magic moment) -->
  <text x="120" y="92" font-size="12" fill="#fbc02d" font-weight="bold">☆</text>
  <text x="155" y="95" font-size="10" fill="#fbc02d" font-weight="bold">☆</text>
  <!-- Sight line from lens to subject (dashed) -->
  <line x1="68" y1="69" x2="128" y2="98" stroke="#e53935" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.7"/>
  <!-- Floor -->
  <rect x="0" y="128" width="200" height="32" fill="#c8e6c9" rx="0"/>
  <!-- Label -->
  <text x="100" y="148" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">シャッターチャンス！</text>
</svg>
