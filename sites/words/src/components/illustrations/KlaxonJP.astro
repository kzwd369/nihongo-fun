<!-- 日本人ドライバーが住宅街で遠慮がちにクラクションを鳴らす -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Car body (front view) -->
  <!-- Roof -->
  <path d="M60,50 Q60,38 75,38 L125,38 Q140,38 140,50 L140,62 L60,62 Z" fill="#81c784"/>
  <!-- Windshield -->
  <path d="M68,52 Q70,44 78,44 L122,44 Q130,44 132,52 L132,62 L68,62 Z" fill="#b3e5fc" opacity="0.85"/>
  <!-- Hood/lower body -->
  <rect x="40" y="62" width="120" height="52" fill="#66bb6a" rx="6"/>
  <!-- Headlights -->
  <ellipse cx="55" cy="82" rx="7" ry="5" fill="#fff9c4" stroke="#fbc02d" stroke-width="1"/>
  <ellipse cx="145" cy="82" rx="7" ry="5" fill="#fff9c4" stroke="#fbc02d" stroke-width="1"/>
  <!-- Grille -->
  <rect x="75" y="92" width="50" height="14" fill="#37474f" rx="3"/>
  <line x1="80" y1="99" x2="120" y2="99" stroke="#90a4ae" stroke-width="1"/>
  <!-- Bumper -->
  <rect x="38" y="108" width="124" height="8" fill="#455a64" rx="3"/>
  <!-- Driver visible through windshield -->
  <!-- Head -->
  <circle cx="100" cy="56" r="8" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M92,55 Q92,48 100,47 Q108,48 108,55 L106,52 Q100,50 94,52 Z" fill="#3e2723"/>
  <!-- Eyes (slight squint, polite/hesitant) -->
  <path d="M95,56 Q97,54 99,56" fill="none" stroke="#3e2723" stroke-width="1" stroke-linecap="round"/>
  <path d="M101,56 Q103,54 105,56" fill="none" stroke="#3e2723" stroke-width="1" stroke-linecap="round"/>
  <!-- Hesitant mouth -->
  <path d="M97,60 Q100,61 103,60" fill="none" stroke="#3e2723" stroke-width="1" stroke-linecap="round"/>
  <!-- Steering wheel in front of driver -->
  <circle cx="100" cy="78" r="9" fill="none" stroke="#263238" stroke-width="2"/>
  <circle cx="100" cy="78" r="3.5" fill="#ffca28" stroke="#f57f17" stroke-width="1"/>
  <!-- "プッ！" text with music note -->
  <text x="155" y="40" font-size="13" font-weight="bold" fill="#e53935" text-anchor="middle">プッ！</text>
  <text x="178" y="42" font-size="14" font-weight="bold" fill="#e53935">♪</text>
  <!-- Sound wave arcs (concentric from horn) -->
  <path d="M148,55 Q156,62 148,70" fill="none" stroke="#ef6c00" stroke-width="2" stroke-linecap="round"/>
  <path d="M154,50 Q165,62 154,75" fill="none" stroke="#ef6c00" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
  <path d="M160,45 Q174,62 160,80" fill="none" stroke="#ef6c00" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
  <!-- Ground -->
  <rect x="0" y="128" width="200" height="32" fill="#c8e6c9" rx="0"/>
  <!-- Label -->
  <text x="100" y="148" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">クラクションを鳴らす</text>
</svg>
