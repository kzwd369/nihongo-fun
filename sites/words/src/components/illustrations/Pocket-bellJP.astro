<!-- Japanese ポケベル = an old pocket pager held in the hand, a small numeric-screen call device. Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="pbjpBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#311b92"/>
      <stop offset="100%" stop-color="#512da8"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#pbjpBg)" rx="8"/>
  <!-- Retro 90s sparkles -->
  <polygon points="26,38 28,32 30,38 28,44" fill="#ff80ab"/>
  <polygon points="22,40 28,38 34,40 28,42" fill="#ff80ab"/>
  <polygon points="176,46 178,40 180,46 178,52" fill="#80d8ff"/>
  <polygon points="172,48 178,46 184,48 178,50" fill="#80d8ff"/>
  <!-- A hand holding the pager -->
  <!-- palm -->
  <path d="M70 118 q-8 4 -10 16 q0 14 20 18 l44 0 q18 -2 18 -16 l0 -10 q-2 -8 -10 -8 Z" fill="#ffcc80" stroke="#e0a96d" stroke-width="0.8"/>
  <!-- thumb -->
  <path d="M62 124 q-10 -2 -12 6 q-1 7 8 8 q6 0 8 -6 Z" fill="#ffcc80" stroke="#e0a96d" stroke-width="0.8"/>
  <!-- Pager body resting in the hand -->
  <rect x="66" y="50" width="68" height="70" rx="10" fill="#263238" stroke="#000" stroke-width="1.5"/>
  <rect x="72" y="56" width="56" height="58" rx="6" fill="#37474f"/>
  <!-- clip top -->
  <rect x="90" y="44" width="20" height="7" rx="3" fill="#455a64"/>
  <!-- LCD screen with abstract digit blocks (segment-style, not real numbers) -->
  <rect x="78" y="62" width="44" height="22" rx="2" fill="#aed581" stroke="#1b5e20" stroke-width="1"/>
  <rect x="83" y="67" width="5" height="12" rx="1" fill="#33691e"/>
  <rect x="92" y="67" width="5" height="12" rx="1" fill="#33691e"/>
  <rect x="101" y="67" width="5" height="12" rx="1" fill="#33691e"/>
  <rect x="110" y="67" width="5" height="12" rx="1" fill="#33691e"/>
  <!-- Buttons -->
  <circle cx="84" cy="98" r="4" fill="#90a4ae"/>
  <circle cx="100" cy="98" r="4" fill="#90a4ae"/>
  <circle cx="116" cy="98" r="4" fill="#ef5350"/>
  <!-- Beep waves -->
  <path d="M138 64 q9 9 0 18" fill="none" stroke="#ffeb3b" stroke-width="1.5"/>
  <path d="M144 60 q14 13 0 26" fill="none" stroke="#ffeb3b" stroke-width="1.2" opacity="0.7"/>
  <!-- musical beep note -->
  <ellipse cx="150" cy="54" rx="3" ry="2.2" fill="#ffeb3b"/>
  <line x1="153" y1="54" x2="153" y2="44" stroke="#ffeb3b" stroke-width="1.4"/>
  <path d="M153 44 q4 0 4 3" fill="none" stroke="#ffeb3b" stroke-width="1.4"/>
</svg>
