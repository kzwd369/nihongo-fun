<!-- Japanese マイホーム = the dream of a newly-built detached house with a family and a car (home ownership goal). Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="mhjpSky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#bbdefb"/>
      <stop offset="100%" stop-color="#e3f2fd"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#mhjpSky)" rx="8"/>
  <!-- Sun -->
  <circle cx="172" cy="26" r="12" fill="#ffe082"/>
  <circle cx="172" cy="26" r="8" fill="#ffca28"/>
  <!-- Ground / lawn -->
  <rect x="0" y="124" width="200" height="36" fill="#a5d6a7"/>
  <!-- Dream sparkles around the new house -->
  <polygon points="40,42 42,36 44,42 42,48" fill="#ffd54f"/>
  <polygon points="36,44 42,42 48,44 42,46" fill="#ffd54f"/>
  <polygon points="150,54 152,49 154,54 152,59" fill="#fff59d"/>
  <polygon points="147,56 152,54 157,56 152,58" fill="#fff59d"/>
  <!-- New detached house body -->
  <rect x="50" y="78" width="78" height="48" fill="#fff3e0" stroke="#8d6e63" stroke-width="1.5"/>
  <!-- Roof -->
  <polygon points="45,78 89,50 133,78" fill="#c62828" stroke="#8d6e63" stroke-width="1.5"/>
  <!-- Chimney -->
  <rect x="112" y="56" width="8" height="14" fill="#8d6e63"/>
  <!-- Door -->
  <rect x="80" y="100" width="16" height="26" fill="#6d4c41"/>
  <circle cx="92" cy="114" r="1.2" fill="#ffd54f"/>
  <!-- Windows -->
  <rect x="58" y="88" width="15" height="13" fill="#90caf9" stroke="#8d6e63" stroke-width="0.8"/>
  <line x1="65.5" y1="88" x2="65.5" y2="101" stroke="#8d6e63" stroke-width="0.6"/>
  <line x1="58" y1="94.5" x2="73" y2="94.5" stroke="#8d6e63" stroke-width="0.6"/>
  <rect x="104" y="88" width="15" height="13" fill="#90caf9" stroke="#8d6e63" stroke-width="0.8"/>
  <line x1="111.5" y1="88" x2="111.5" y2="101" stroke="#8d6e63" stroke-width="0.6"/>
  <line x1="104" y1="94.5" x2="119" y2="94.5" stroke="#8d6e63" stroke-width="0.6"/>
  <!-- マイカー (own car) in the driveway -->
  <rect x="142" y="112" width="30" height="11" rx="2" fill="#42a5f5" stroke="#1565c0" stroke-width="0.8"/>
  <rect x="148" y="106" width="16" height="7" rx="1.5" fill="#64b5f6" stroke="#1565c0" stroke-width="0.6"/>
  <circle cx="149" cy="124" r="3" fill="#37474f"/>
  <circle cx="165" cy="124" r="3" fill="#37474f"/>
  <!-- Happy family in front of the house: parent, parent, child -->
  <!-- Parent 1 -->
  <circle cx="26" cy="106" r="5" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.6"/>
  <path d="M21 104 q5 -7 10 0" fill="#5d4037"/>
  <rect x="22" y="111" width="8" height="14" rx="2" fill="#5c6bc0"/>
  <!-- Parent 2 -->
  <circle cx="38" cy="106" r="5" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.6"/>
  <path d="M33 105 q5 -8 10 0 q-1 4 -5 4 q-4 0 -5 -4" fill="#8d6e63"/>
  <rect x="34" y="111" width="8" height="14" rx="2" fill="#ec407a"/>
  <!-- Child -->
  <circle cx="48" cy="112" r="3.5" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.6"/>
  <path d="M45 110 q3 -5 6 0" fill="#5d4037"/>
  <rect x="45" y="116" width="6" height="9" rx="1.5" fill="#66bb6a"/>
  <!-- Hearts above the family -->
  <path d="M30 92 q-3 -4 -6 -1 q-3 3 6 8 q9 -5 6 -8 q-3 -3 -6 1" fill="#e53935"/>
</svg>
