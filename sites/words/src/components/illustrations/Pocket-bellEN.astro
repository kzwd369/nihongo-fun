<!-- English "pager"/"beeper" = the same device clipped to a belt in a medical/business context. Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="pbenBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#004d40"/>
      <stop offset="100%" stop-color="#00695c"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#pbenBg)" rx="8"/>
  <!-- Lower torso / waist of a professional (white coat over trousers) -->
  <!-- white coat panel -->
  <path d="M40 30 L40 130 L160 130 L160 30 q-30 -8 -60 -8 q-30 0 -60 8 Z" fill="#f5f5f5" stroke="#cfd8dc" stroke-width="1"/>
  <!-- coat opening center -->
  <line x1="100" y1="24" x2="100" y2="92" stroke="#b0bec5" stroke-width="1.2"/>
  <!-- trousers showing below the coat -->
  <rect x="56" y="92" width="40" height="38" fill="#37474f"/>
  <rect x="104" y="92" width="40" height="38" fill="#37474f"/>
  <!-- Belt across the waist -->
  <rect x="40" y="86" width="120" height="10" fill="#3e2723"/>
  <rect x="94" y="86" width="12" height="10" fill="#bca16b" stroke="#8d6e63" stroke-width="0.8"/>
  <!-- Pager clipped onto the belt -->
  <rect x="118" y="80" width="36" height="26" rx="5" fill="#212121" stroke="#000" stroke-width="1.4"/>
  <rect x="122" y="84" width="28" height="18" rx="3" fill="#424242"/>
  <!-- belt clip -->
  <rect x="130" y="76" width="12" height="6" rx="2" fill="#616161"/>
  <!-- LCD with abstract segment blocks (no real text) -->
  <rect x="125" y="87" width="22" height="9" rx="1.5" fill="#80cbc4" stroke="#004d40" stroke-width="0.8"/>
  <rect x="127" y="89" width="3" height="5" rx="0.8" fill="#004d40"/>
  <rect x="131" y="89" width="3" height="5" rx="0.8" fill="#004d40"/>
  <rect x="135" y="89" width="3" height="5" rx="0.8" fill="#004d40"/>
  <rect x="139" y="89" width="3" height="5" rx="0.8" fill="#004d40"/>
  <!-- Beep waves coming off the pager -->
  <path d="M158 84 q7 7 0 16" fill="none" stroke="#ffd54f" stroke-width="1.5"/>
  <path d="M163 80 q12 11 0 24" fill="none" stroke="#ffd54f" stroke-width="1.2" opacity="0.7"/>
  <!-- A stethoscope in the coat pocket to signal the medical context -->
  <rect x="50" y="60" width="20" height="16" rx="2" fill="#eceff1" stroke="#b0bec5" stroke-width="0.8"/>
  <path d="M60 60 q-2 -16 -14 -16 q-6 0 -6 6" fill="none" stroke="#263238" stroke-width="2"/>
  <path d="M60 60 q2 -10 10 -10 q5 0 5 5" fill="none" stroke="#263238" stroke-width="2"/>
  <circle cx="40" cy="50" r="3" fill="#263238"/>
  <circle cx="75" cy="55" r="3" fill="#263238"/>
  <circle cx="60" cy="74" r="5" fill="#90a4ae" stroke="#263238" stroke-width="1.2"/>
</svg>
