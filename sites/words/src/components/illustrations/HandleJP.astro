<!-- Japanese ハンドル = steering wheel — driver holding the wheel -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Road in background (perspective) -->
  <polygon points="60,55 140,55 170,100 30,100" fill="#90a4ae" opacity="0.5"/>
  <!-- Road center dashes -->
  <line x1="100" y1="60" x2="100" y2="68" stroke="white" stroke-width="2" stroke-dasharray="3,3" opacity="0.7"/>
  <line x1="100" y1="75" x2="100" y2="85" stroke="white" stroke-width="2" stroke-dasharray="3,3" opacity="0.7"/>
  <!-- Dashboard (curved top) -->
  <path d="M0,100 Q100,88 200,100 L200,130 L0,130 Z" fill="#455a64"/>
  <!-- Dashboard dial left -->
  <circle cx="35" cy="115" r="7" fill="#263238" stroke="#90a4ae" stroke-width="1"/>
  <line x1="35" y1="115" x2="39" y2="111" stroke="#ffcc80" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Dashboard dial right -->
  <circle cx="165" cy="115" r="7" fill="#263238" stroke="#90a4ae" stroke-width="1"/>
  <line x1="165" y1="115" x2="169" y2="111" stroke="#ffcc80" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Driver head -->
  <circle cx="100" cy="42" r="14" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M87,40 Q86,27 100,25 Q114,27 113,40 L110,36 Q100,32 90,36 Z" fill="#3e2723"/>
  <!-- Eyes (smiling) -->
  <path d="M93,42 Q95,39 97,42" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <path d="M103,42 Q105,39 107,42" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Smile -->
  <path d="M95,49 Q100,53 105,49" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Body -->
  <rect x="85" y="56" width="30" height="30" fill="#1976d2" rx="4"/>
  <!-- Collar -->
  <polygon points="100,56 93,66 107,66" fill="white"/>
  <!-- Steering wheel (front view) -->
  <!-- Outer ring -->
  <circle cx="100" cy="105" r="28" fill="none" stroke="#212121" stroke-width="6"/>
  <!-- Hub -->
  <circle cx="100" cy="105" r="8" fill="#424242"/>
  <!-- Spokes -->
  <line x1="100" y1="105" x2="74" y2="105" stroke="#212121" stroke-width="5" stroke-linecap="round"/>
  <line x1="100" y1="105" x2="126" y2="105" stroke="#212121" stroke-width="5" stroke-linecap="round"/>
  <line x1="100" y1="105" x2="100" y2="131" stroke="#212121" stroke-width="5" stroke-linecap="round"/>
  <!-- Center logo -->
  <circle cx="100" cy="105" r="3" fill="#ffcc80"/>
  <!-- Left arm gripping wheel -->
  <line x1="85" y1="82" x2="76" y2="98" stroke="#1976d2" stroke-width="7" stroke-linecap="round"/>
  <circle cx="74" cy="100" r="5" fill="#ffcc80"/>
  <!-- Right arm gripping wheel -->
  <line x1="115" y1="82" x2="124" y2="98" stroke="#1976d2" stroke-width="7" stroke-linecap="round"/>
  <circle cx="126" cy="100" r="5" fill="#ffcc80"/>
  <!-- Label -->
  <text x="100" y="152" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">ハンドルを握る</text>
</svg>
