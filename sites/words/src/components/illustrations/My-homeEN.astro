<!-- English "my home" = wherever I live: a house, an apartment, a single room — all are "my home". Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="mhenSky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#d1c4e9"/>
      <stop offset="100%" stop-color="#ede7f6"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#mhenSky)" rx="8"/>
  <!-- Ground -->
  <rect x="0" y="128" width="200" height="32" fill="#cfd8dc"/>
  <!-- Three kinds of dwelling, each topped with a heart = "where I live" -->
  <!-- 1) A house -->
  <rect x="14" y="92" width="42" height="36" fill="#fff3e0" stroke="#6d4c41" stroke-width="1.2"/>
  <polygon points="10,92 35,73 60,92" fill="#ef9a9a" stroke="#6d4c41" stroke-width="1.2"/>
  <rect x="28" y="108" width="13" height="20" fill="#8d6e63"/>
  <rect x="18" y="98" width="9" height="9" fill="#90caf9" stroke="#6d4c41" stroke-width="0.5"/>
  <rect x="44" y="98" width="9" height="9" fill="#90caf9" stroke="#6d4c41" stroke-width="0.5"/>
  <path d="M35 70 q-3 -4 -6 -1 q-3 3 6 8 q9 -5 6 -8 q-3 -3 -6 1" fill="#e53935"/>
  <!-- 2) An apartment building -->
  <rect x="80" y="78" width="40" height="50" fill="#eceff1" stroke="#607d8b" stroke-width="1.2"/>
  <rect x="85" y="84" width="7" height="7" fill="#90caf9"/>
  <rect x="96" y="84" width="7" height="7" fill="#90caf9"/>
  <rect x="107" y="84" width="7" height="7" fill="#90caf9"/>
  <rect x="85" y="96" width="7" height="7" fill="#90caf9"/>
  <rect x="96" y="96" width="7" height="7" fill="#fff59d"/>
  <rect x="107" y="96" width="7" height="7" fill="#90caf9"/>
  <rect x="85" y="108" width="7" height="7" fill="#90caf9"/>
  <rect x="107" y="108" width="7" height="7" fill="#90caf9"/>
  <rect x="94" y="116" width="12" height="12" fill="#607d8b"/>
  <path d="M100 73 q-3 -4 -6 -1 q-3 3 6 8 q9 -5 6 -8 q-3 -3 -6 1" fill="#e53935"/>
  <!-- 3) A single rented room -->
  <rect x="144" y="98" width="46" height="30" fill="#f5f5f5" stroke="#5d4037" stroke-width="1.2"/>
  <!-- window -->
  <rect x="149" y="103" width="12" height="11" fill="#90caf9" stroke="#5d4037" stroke-width="0.6"/>
  <line x1="155" y1="103" x2="155" y2="114" stroke="#5d4037" stroke-width="0.5"/>
  <!-- bed -->
  <rect x="166" y="116" width="20" height="8" rx="1.5" fill="#a1887f" stroke="#5d4037" stroke-width="0.8"/>
  <rect x="166" y="112" width="8" height="6" rx="1.5" fill="#d7ccc8" stroke="#5d4037" stroke-width="0.6"/>
  <!-- little lamp -->
  <line x1="180" y1="103" x2="180" y2="116" stroke="#8d6e63" stroke-width="1"/>
  <polygon points="176,103 184,103 182,98 178,98" fill="#fff59d" stroke="#8d6e63" stroke-width="0.5"/>
  <path d="M167 94 q-3 -4 -6 -1 q-3 3 6 8 q9 -5 6 -8 q-3 -3 -6 1" fill="#e53935"/>
  <!-- Equals signs between them to show "all the same: my home" -->
  <rect x="64" y="100" width="10" height="2.5" rx="1" fill="#7e57c2"/>
  <rect x="64" y="106" width="10" height="2.5" rx="1" fill="#7e57c2"/>
  <rect x="126" y="100" width="10" height="2.5" rx="1" fill="#7e57c2"/>
  <rect x="126" y="106" width="10" height="2.5" rx="1" fill="#7e57c2"/>
</svg>
