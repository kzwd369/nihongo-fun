<!-- Japanese シルバーシート = a priority train seat with an elderly person holding a cane sitting on it. Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="ssjpBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#eceff1"/>
      <stop offset="100%" stop-color="#cfd8dc"/>
    </linearGradient>
    <linearGradient id="ssjpSeat" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#b0bec5"/>
      <stop offset="100%" stop-color="#90a4ae"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#ssjpBg)" rx="8"/>
  <!-- Train car window strip -->
  <rect x="14" y="26" width="172" height="24" rx="4" fill="#b3e5fc" stroke="#0288d1" stroke-width="1"/>
  <line x1="100" y1="26" x2="100" y2="50" stroke="#0288d1" stroke-width="1"/>
  <!-- Grab handles hanging from the ceiling -->
  <line x1="50" y1="50" x2="50" y2="64" stroke="#607d8b" stroke-width="1.2"/>
  <circle cx="50" cy="68" r="4" fill="none" stroke="#607d8b" stroke-width="1.5"/>
  <line x1="150" y1="50" x2="150" y2="64" stroke="#607d8b" stroke-width="1.2"/>
  <circle cx="150" cy="68" r="4" fill="none" stroke="#607d8b" stroke-width="1.5"/>
  <!-- Silver-gray priority seat -->
  <rect x="36" y="108" width="128" height="16" rx="2" fill="url(#ssjpSeat)" stroke="#607d8b" stroke-width="1.2"/>
  <rect x="36" y="82" width="128" height="28" rx="3" fill="url(#ssjpSeat)" stroke="#607d8b" stroke-width="1.2"/>
  <!-- seat dividers -->
  <line x1="80" y1="84" x2="80" y2="122" stroke="#607d8b" stroke-width="0.8"/>
  <line x1="120" y1="84" x2="120" y2="122" stroke="#607d8b" stroke-width="0.8"/>
  <!-- Elderly person seated in the middle, holding a cane -->
  <!-- head -->
  <circle cx="100" cy="78" r="9" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.8"/>
  <!-- white/gray hair -->
  <path d="M91 76 q9 -12 18 0 q-2 -2 -4 -2 q-5 -3 -10 0 q-2 0 -4 2" fill="#eceff1" stroke="#9e9e9e" stroke-width="0.7"/>
  <!-- small round glasses -->
  <circle cx="96" cy="79" r="2" fill="none" stroke="#5d4037" stroke-width="0.7"/>
  <circle cx="104" cy="79" r="2" fill="none" stroke="#5d4037" stroke-width="0.7"/>
  <line x1="98" y1="79" x2="102" y2="79" stroke="#5d4037" stroke-width="0.6"/>
  <!-- gentle smile -->
  <path d="M97 84 q3 3 6 0" fill="none" stroke="#5d4037" stroke-width="0.8"/>
  <!-- body (seated) -->
  <path d="M90 88 q10 -5 20 0 l0 18 l-20 0 Z" fill="#8d6e63"/>
  <!-- legs -->
  <rect x="92" y="106" width="6" height="16" rx="2" fill="#5d4037"/>
  <rect x="102" y="106" width="6" height="16" rx="2" fill="#5d4037"/>
  <!-- Cane held in hand -->
  <line x1="116" y1="92" x2="116" y2="122" stroke="#6d4c41" stroke-width="2" stroke-linecap="round"/>
  <path d="M116 92 q5 0 5 4" fill="none" stroke="#6d4c41" stroke-width="2" stroke-linecap="round"/>
  <circle cx="113" cy="98" r="2.5" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.6"/>
  <!-- Floor -->
  <rect x="0" y="124" width="200" height="36" fill="#90a4ae"/>
  <!-- Priority pictogram plate on the wall (elderly figure with cane) -->
  <rect x="138" y="58" width="26" height="22" rx="2" fill="#fff" stroke="#2e7d32" stroke-width="1"/>
  <circle cx="148" cy="64" r="2.2" fill="#2e7d32"/>
  <path d="M148 66 q-2 5 0 10" fill="none" stroke="#2e7d32" stroke-width="1.6"/>
  <path d="M148 70 q4 1 5 5" fill="none" stroke="#2e7d32" stroke-width="1.4"/>
  <line x1="153" y1="66" x2="153" y2="76" stroke="#2e7d32" stroke-width="1.2"/>
</svg>
