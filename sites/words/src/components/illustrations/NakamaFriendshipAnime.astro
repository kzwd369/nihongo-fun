<!-- Nakama / friendship / kizuna: three characters stacking their hands together in the center, with bond sparkles and a warm glow -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <defs>
    <radialGradient id="nakamaGlow" cx="50%" cy="55%" r="60%">
      <stop offset="0%" stop-color="#fff8e1"/>
      <stop offset="55%" stop-color="#ffe0b2"/>
      <stop offset="100%" stop-color="#ffcc80"/>
    </radialGradient>
  </defs>

  <!-- Warm background -->
  <rect width="200" height="160" rx="8" fill="url(#nakamaGlow)"/>

  <!-- Central radial bond glow behind the hands -->
  <circle cx="100" cy="92" r="42" fill="#fff59d" opacity="0.55"/>
  <circle cx="100" cy="92" r="28" fill="#fffde7" opacity="0.6"/>

  <!-- Three character heads forming a circle around the hands -->
  <!-- Left character -->
  <circle cx="40" cy="50" r="16" fill="#ffe0b2" stroke="#bf8f5a" stroke-width="1.5"/>
  <path d="M24,48 C24,32 56,32 56,48 C56,40 48,36 40,36 C32,36 24,40 24,48Z" fill="#5d4037"/>
  <circle cx="35" cy="50" r="1.8" fill="#3e2723"/>
  <circle cx="45" cy="50" r="1.8" fill="#3e2723"/>
  <path d="M36,56 Q40,59 44,56" fill="none" stroke="#8d4f3a" stroke-width="1.4" stroke-linecap="round"/>
  <!-- shoulders -->
  <path d="M22,90 Q40,66 58,90Z" fill="#ef9a9a"/>

  <!-- Center character -->
  <circle cx="100" cy="42" r="16" fill="#ffe0b2" stroke="#bf8f5a" stroke-width="1.5"/>
  <path d="M84,40 C84,24 116,24 116,40 C116,30 108,27 100,27 C92,27 84,30 84,40Z" fill="#3e2723"/>
  <circle cx="95" cy="42" r="1.8" fill="#3e2723"/>
  <circle cx="105" cy="42" r="1.8" fill="#3e2723"/>
  <path d="M96,48 Q100,51 104,48" fill="none" stroke="#8d4f3a" stroke-width="1.4" stroke-linecap="round"/>
  <path d="M82,84 Q100,58 118,84Z" fill="#64b5f6"/>

  <!-- Right character -->
  <circle cx="160" cy="50" r="16" fill="#ffe0b2" stroke="#bf8f5a" stroke-width="1.5"/>
  <path d="M144,48 C144,32 176,32 176,48 C176,40 168,36 160,36 C152,36 144,40 144,48Z" fill="#6d4c41"/>
  <circle cx="155" cy="50" r="1.8" fill="#3e2723"/>
  <circle cx="165" cy="50" r="1.8" fill="#3e2723"/>
  <path d="M156,56 Q160,59 164,56" fill="none" stroke="#8d4f3a" stroke-width="1.4" stroke-linecap="round"/>
  <path d="M142,90 Q160,66 178,90Z" fill="#a5d6a7"/>

  <!-- Arms reaching into the center -->
  <path d="M50,86 Q72,92 90,98" fill="none" stroke="#ffcc80" stroke-width="9" stroke-linecap="round"/>
  <path d="M100,80 Q100,88 100,96" fill="none" stroke="#ffcc80" stroke-width="9" stroke-linecap="round"/>
  <path d="M150,86 Q128,92 110,98" fill="none" stroke="#ffcc80" stroke-width="9" stroke-linecap="round"/>

  <!-- Stacked hands in the center -->
  <ellipse cx="92" cy="100" rx="13" ry="9" fill="#ffe0b2" stroke="#bf8f5a" stroke-width="1.4"/>
  <ellipse cx="100" cy="96" rx="13" ry="9" fill="#ffd9a0" stroke="#bf8f5a" stroke-width="1.4"/>
  <ellipse cx="108" cy="100" rx="13" ry="9" fill="#ffe0b2" stroke="#bf8f5a" stroke-width="1.4"/>

  <!-- Bond sparkles (four-point stars + dots) -->
  <path d="M100,58 L103,67 L112,70 L103,73 L100,82 L97,73 L88,70 L97,67Z" fill="#fffde7" opacity="0.85"/>
  <path d="M64,68 L66,73 L71,75 L66,77 L64,82 L62,77 L57,75 L62,73Z" fill="#ffffff" opacity="0.7"/>
  <path d="M138,72 L140,77 L145,79 L140,81 L138,86 L136,81 L131,79 L136,77Z" fill="#ffffff" opacity="0.7"/>
  <circle cx="78" cy="124" r="2.5" fill="#fff59d"/>
  <circle cx="122" cy="124" r="2.5" fill="#fff59d"/>
  <circle cx="100" cy="132" r="2" fill="#ffffff" opacity="0.8"/>
  <circle cx="50" cy="108" r="1.6" fill="#ffffff" opacity="0.7"/>
  <circle cx="150" cy="108" r="1.6" fill="#ffffff" opacity="0.7"/>

  <!-- Small floating hearts representing kizuna -->
  <path d="M30,118 C30,118 27,115 25,116 C23,117 23,120 25,122 L30,126 L35,122 C37,120 37,117 35,116 C33,115 30,118 30,118Z" fill="#ef5350" opacity="0.7"/>
  <path d="M170,116 C170,116 167,113 165,114 C163,115 163,118 165,120 L170,124 L175,120 C177,118 177,115 175,114 C173,113 170,116 170,116Z" fill="#ef5350" opacity="0.7"/>
</svg>
