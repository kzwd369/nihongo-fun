<!-- Japanese タレント = a TV celebrity in a studio under a spotlight, holding a mic, facing a camera. Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="tljpBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#4a148c"/>
      <stop offset="100%" stop-color="#880e4f"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#tljpBg)" rx="8"/>
  <!-- Spotlight beams from above -->
  <path d="M86 8 L40 150 L132 150 Z" fill="#fff59d" opacity="0.22"/>
  <path d="M86 8 L60 150 L112 150 Z" fill="#fff59d" opacity="0.18"/>
  <!-- Spotlight fixture -->
  <rect x="78" y="2" width="16" height="10" rx="2" fill="#263238"/>
  <ellipse cx="86" cy="12" rx="9" ry="3" fill="#fff59d"/>
  <!-- Sparkles -->
  <polygon points="30,44 32,38 34,44 32,50" fill="#ffd54f"/>
  <polygon points="26,46 32,44 38,46 32,48" fill="#ffd54f"/>
  <polygon points="170,52 172,46 174,52 172,58" fill="#ffd54f"/>
  <polygon points="166,54 172,52 178,54 172,56" fill="#ffd54f"/>
  <!-- Stage floor -->
  <ellipse cx="86" cy="150" rx="48" ry="10" fill="#fff59d" opacity="0.15"/>
  <!-- The celebrity in the spotlight -->
  <!-- head -->
  <circle cx="86" cy="58" r="13" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.8"/>
  <!-- stylish hair -->
  <path d="M73 56 q13 -16 26 0 q-3 -4 -6 -4 q-7 -4 -14 0 q-3 0 -6 4" fill="#3e2723"/>
  <!-- big smile -->
  <path d="M79 62 q7 7 14 0" fill="none" stroke="#5d4037" stroke-width="1.3" stroke-linecap="round"/>
  <circle cx="81" cy="56" r="1.4" fill="#3e2723"/>
  <circle cx="91" cy="56" r="1.4" fill="#3e2723"/>
  <!-- flashy jacket body -->
  <path d="M70 96 q16 -16 32 0 L102 130 L70 130 Z" fill="#e91e63"/>
  <polygon points="82,90 86,104 90,90" fill="#fff"/>
  <!-- arm holding a mic -->
  <line x1="98" y1="100" x2="112" y2="86" stroke="#e91e63" stroke-width="5" stroke-linecap="round"/>
  <circle cx="113" cy="85" r="3" fill="#ffe0b2"/>
  <line x1="113" y1="85" x2="120" y2="76" stroke="#9e9e9e" stroke-width="2"/>
  <circle cx="122" cy="74" r="4" fill="#bdbdbd" stroke="#757575" stroke-width="0.8"/>
  <!-- Studio TV camera on the right -->
  <rect x="150" y="92" width="34" height="22" rx="3" fill="#212121" stroke="#000" stroke-width="1"/>
  <circle cx="184" cy="103" r="2" fill="#212121"/>
  <circle cx="150" cy="98" r="6" fill="#37474f" stroke="#000" stroke-width="1"/>
  <circle cx="150" cy="98" r="3" fill="#90caf9"/>
  <!-- red record light -->
  <circle cx="178" cy="98" r="2.2" fill="#d50000"/>
  <!-- camera tripod -->
  <line x1="167" y1="114" x2="158" y2="140" stroke="#455a64" stroke-width="2.5"/>
  <line x1="167" y1="114" x2="176" y2="140" stroke="#455a64" stroke-width="2.5"/>
  <line x1="167" y1="114" x2="167" y2="140" stroke="#455a64" stroke-width="2.5"/>
</svg>
