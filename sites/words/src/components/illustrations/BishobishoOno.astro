<!-- Soaked person under heavy rain with dripping drops — ビショビショ (drenched / soaking wet) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="url(#rainBg)" rx="8"/>
  <!-- Rain cloud -->
  <ellipse cx="100" cy="32" rx="45" ry="18" fill="#90a4ae"/>
  <ellipse cx="68" cy="36" rx="22" ry="14" fill="#b0bec5"/>
  <ellipse cx="132" cy="36" rx="22" ry="14" fill="#b0bec5"/>
  <ellipse cx="100" cy="40" rx="50" ry="14" fill="#78909c"/>
  <!-- Diagonal rain streaks -->
  <line x1="40" y1="55" x2="34" y2="75" stroke="#4fc3f7" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
  <line x1="60" y1="55" x2="54" y2="80" stroke="#4fc3f7" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
  <line x1="140" y1="55" x2="134" y2="80" stroke="#4fc3f7" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
  <line x1="160" y1="55" x2="154" y2="75" stroke="#4fc3f7" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
  <line x1="48" y1="90" x2="42" y2="110" stroke="#4fc3f7" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
  <line x1="152" y1="90" x2="146" y2="110" stroke="#4fc3f7" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
  <!-- Drooping wet figure -->
  <!-- body -->
  <path d="M85 130 Q82 95 100 92 Q118 95 115 130 Z" fill="#5c6bc0"/>
  <!-- soaked highlight on body -->
  <path d="M92 100 Q95 118 94 128" fill="none" stroke="#9fa8da" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
  <!-- head -->
  <circle cx="100" cy="78" r="15" fill="#ffe0b2"/>
  <!-- wet flattened hair -->
  <path d="M85 76 Q88 62 100 62 Q112 62 115 76 Q108 70 100 71 Q92 70 85 76 Z" fill="#6d4c41"/>
  <!-- dripping wet hair strands -->
  <path d="M88 80 Q86 88 87 94" fill="none" stroke="#6d4c41" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M112 80 Q114 88 113 94" fill="none" stroke="#6d4c41" stroke-width="2.5" stroke-linecap="round"/>
  <!-- sad droopy eyes -->
  <path d="M92 78 Q95 81 98 78" fill="none" stroke="#5d4037" stroke-width="1.5" stroke-linecap="round"/>
  <path d="M102 78 Q105 81 108 78" fill="none" stroke="#5d4037" stroke-width="1.5" stroke-linecap="round"/>
  <!-- small frown -->
  <path d="M96 86 Q100 84 104 86" fill="none" stroke="#5d4037" stroke-width="1.5" stroke-linecap="round"/>
  <!-- drips off head and arms -->
  <path d="M87 96 Q85 100 87 102 Q89 100 87 96 Z" fill="#4fc3f7" opacity="0.8"/>
  <path d="M113 96 Q111 100 113 102 Q115 100 113 96 Z" fill="#4fc3f7" opacity="0.8"/>
  <path d="M100 132 Q98 136 100 138 Q102 136 100 132 Z" fill="#4fc3f7" opacity="0.8"/>
  <!-- puddle -->
  <ellipse cx="100" cy="142" rx="40" ry="6" fill="#4fc3f7" opacity="0.5"/>
  <ellipse cx="100" cy="142" rx="26" ry="4" fill="#81d4fa" opacity="0.5"/>
  <!-- splash dots in puddle -->
  <circle cx="70" cy="140" r="1.5" fill="#4fc3f7" opacity="0.6"/>
  <circle cx="130" cy="140" r="1.5" fill="#4fc3f7" opacity="0.6"/>
  <defs>
    <linearGradient id="rainBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e3f2fd"/>
      <stop offset="100%" stop-color="#cfd8dc"/>
    </linearGradient>
  </defs>
</svg>
