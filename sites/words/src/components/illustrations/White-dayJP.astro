<!-- ホワイトデー = White Day (March 14), when men give return gifts after Valentine's (Japan-originated custom). Picture only, no text/numbers. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="wd-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fce4ec"/>
      <stop offset="100%" stop-color="#f8bbd0"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#wd-bg)" rx="8"/>
  <!-- Floating hearts (return-gift romance vibe) -->
  <path d="M40 30 Q36 24 31 28 Q26 32 40 44 Q54 32 49 28 Q44 24 40 30 Z" fill="#f48fb1" opacity="0.7"/>
  <path d="M165 36 Q162 31 158 34 Q154 38 165 47 Q176 38 172 34 Q168 31 165 36 Z" fill="#f48fb1" opacity="0.55"/>
  <!-- White gift box (the return gift, お返し) -->
  <!-- Box body -->
  <rect x="62" y="78" width="76" height="56" fill="#ffffff" rx="4" stroke="#f8bbd0" stroke-width="1"/>
  <!-- Box lid -->
  <rect x="56" y="66" width="88" height="18" fill="#fafafa" rx="4" stroke="#f8bbd0" stroke-width="1"/>
  <!-- Vertical ribbon -->
  <rect x="94" y="66" width="12" height="68" fill="#f06292"/>
  <!-- Horizontal ribbon -->
  <rect x="56" y="71" width="88" height="9" fill="#f06292"/>
  <!-- Bow -->
  <path d="M100 64 Q82 50 80 64 Q82 76 100 66 Z" fill="#ec407a"/>
  <path d="M100 64 Q118 50 120 64 Q118 76 100 66 Z" fill="#ec407a"/>
  <circle cx="100" cy="65" r="4.5" fill="#d81b60"/>
  <!-- Small heart accent on the box face -->
  <path d="M100 104 Q96 98 91 102 Q86 106 100 118 Q114 106 109 102 Q104 98 100 104 Z" fill="#f8bbd0" opacity="0.9"/>
  <!-- White chocolate / marshmallow pieces beside the box -->
  <rect x="34" y="120" width="14" height="14" rx="2" fill="#ffffff" stroke="#e0b8c8" stroke-width="0.8"/>
  <circle cx="160" cy="124" r="8" fill="#ffffff" stroke="#e0b8c8" stroke-width="0.8"/>
  <circle cx="174" cy="130" r="6" fill="#ffffff" stroke="#e0b8c8" stroke-width="0.8"/>
  <!-- Calendar page (top-left): grid cells with a marked day, no numbers -->
  <g>
    <rect x="16" y="54" width="36" height="34" rx="3" fill="#ffffff" stroke="#f48fb1" stroke-width="1"/>
    <!-- Header band -->
    <rect x="16" y="54" width="36" height="8" rx="3" fill="#ec407a"/>
    <!-- Grid lines (cells only, no text) -->
    <line x1="16" y1="71" x2="52" y2="71" stroke="#f8bbd0" stroke-width="0.7"/>
    <line x1="16" y1="80" x2="52" y2="80" stroke="#f8bbd0" stroke-width="0.7"/>
    <line x1="25" y1="62" x2="25" y2="88" stroke="#f8bbd0" stroke-width="0.7"/>
    <line x1="34" y1="62" x2="34" y2="88" stroke="#f8bbd0" stroke-width="0.7"/>
    <line x1="43" y1="62" x2="43" y2="88" stroke="#f8bbd0" stroke-width="0.7"/>
    <!-- Circle marking the special day -->
    <circle cx="38.5" cy="75.5" r="4" fill="none" stroke="#ec407a" stroke-width="1.6"/>
  </g>
  <!-- Sparkles (four-point stars as shapes) -->
  <polygon points="132,44 133.5,40 135,44 139,45.5 135,47 133.5,51 132,47 128,45.5" fill="#ffffff" opacity="0.9"/>
  <polygon points="52,100 53,97 54,100 57,101 54,102 53,105 52,102 49,101" fill="#ffffff" opacity="0.8"/>
  <polygon points="150,92 151.5,88 153,92 157,93.5 153,95 151.5,99 150,95 146,93.5" fill="#ffffff" opacity="0.85"/>
</svg>
