<!-- Sticky dripping honey — べたべた (sticky) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff8e1" rx="8"/>
  <!-- Honey dipper handle -->
  <rect x="96" y="18" width="8" height="40" rx="4" fill="#a1887f"/>
  <circle cx="100" cy="64" r="18" fill="#d7a86e"/>
  <!-- Dipper grooves -->
  <line x1="86" y1="58" x2="114" y2="58" stroke="#a1887f" stroke-width="1.5" opacity="0.6"/>
  <line x1="85" y1="66" x2="115" y2="66" stroke="#a1887f" stroke-width="1.5" opacity="0.6"/>
  <line x1="88" y1="74" x2="112" y2="74" stroke="#a1887f" stroke-width="1.5" opacity="0.6"/>
  <!-- Sticky honey stretching down -->
  <path d="M92 80 C90 100 88 110 96 124 C100 132 100 140 100 140 C100 140 100 132 104 124 C112 110 110 100 108 80 C104 86 96 86 92 80Z" fill="#ffb300" opacity="0.85"/>
  <!-- Honey pool -->
  <ellipse cx="100" cy="142" rx="34" ry="10" fill="#ffca28" opacity="0.8"/>
  <ellipse cx="100" cy="140" rx="22" ry="6" fill="#ffb300" opacity="0.6"/>
  <!-- Sticky strands to the side -->
  <path d="M70 90 C66 104 70 112 64 122" fill="none" stroke="#ffb300" stroke-width="4" stroke-linecap="round" opacity="0.5"/>
  <path d="M132 92 C138 104 134 114 140 124" fill="none" stroke="#ffb300" stroke-width="4" stroke-linecap="round" opacity="0.5"/>
  <!-- Shine -->
  <circle cx="94" cy="58" r="4" fill="white" opacity="0.5"/>
  <circle cx="98" cy="110" r="3" fill="white" opacity="0.5"/>
</svg>
