<!-- ガッツポーズ = triumphant victory pose with clenched, raised fists (Japanese; English: fist pump / victory pose). Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <radialGradient id="gp-bg" cx="50%" cy="40%" r="70%">
      <stop offset="0%" stop-color="#fff8e1"/>
      <stop offset="100%" stop-color="#ffe0b2"/>
    </radialGradient>
  </defs>
  <rect width="200" height="160" fill="url(#gp-bg)" rx="8"/>
  <!-- Radiating victory burst lines behind -->
  <g stroke="#ffca28" stroke-width="3" stroke-linecap="round" opacity="0.55">
    <line x1="100" y1="70" x2="100" y2="18"/>
    <line x1="100" y1="70" x2="60" y2="28"/>
    <line x1="100" y1="70" x2="140" y2="28"/>
    <line x1="100" y1="70" x2="36" y2="58"/>
    <line x1="100" y1="70" x2="164" y2="58"/>
    <line x1="100" y1="70" x2="26" y2="92"/>
    <line x1="100" y1="70" x2="174" y2="92"/>
  </g>
  <!-- Head -->
  <circle cx="100" cy="62" r="15" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M85 58 Q85 44 100 42 Q115 44 115 58 Q108 50 100 50 Q92 50 85 58 Z" fill="#3e2723"/>
  <!-- Fierce determined eyebrows -->
  <line x1="91" y1="56" x2="97" y2="58" stroke="#3e2723" stroke-width="1.6" stroke-linecap="round"/>
  <line x1="109" y1="56" x2="103" y2="58" stroke="#3e2723" stroke-width="1.6" stroke-linecap="round"/>
  <!-- Eyes (squeezed in triumph) -->
  <path d="M92 62 Q95 60 98 62" fill="none" stroke="#37474f" stroke-width="1.4" stroke-linecap="round"/>
  <path d="M102 62 Q105 60 108 62" fill="none" stroke="#37474f" stroke-width="1.4" stroke-linecap="round"/>
  <!-- Open triumphant shout / grin -->
  <path d="M94 68 Q100 76 106 68 Q100 71 94 68 Z" fill="#bf360c"/>
  <!-- Body / tank top -->
  <path d="M86 78 Q100 74 114 78 L116 108 L84 108 Z" fill="#ef5350"/>
  <!-- Left arm raised with clenched fist -->
  <line x1="88" y1="82" x2="68" y2="50" stroke="#ffe0b2" stroke-width="8" stroke-linecap="round"/>
  <circle cx="65" cy="46" r="9" fill="#ffe0b2"/>
  <!-- knuckle lines on left fist -->
  <line x1="60" y1="44" x2="70" y2="44" stroke="#e0a878" stroke-width="1" stroke-linecap="round"/>
  <line x1="61" y1="48" x2="69" y2="48" stroke="#e0a878" stroke-width="1" stroke-linecap="round"/>
  <!-- Right arm raised with clenched fist -->
  <line x1="112" y1="82" x2="132" y2="50" stroke="#ffe0b2" stroke-width="8" stroke-linecap="round"/>
  <circle cx="135" cy="46" r="9" fill="#ffe0b2"/>
  <!-- knuckle lines on right fist -->
  <line x1="130" y1="44" x2="140" y2="44" stroke="#e0a878" stroke-width="1" stroke-linecap="round"/>
  <line x1="131" y1="48" x2="139" y2="48" stroke="#e0a878" stroke-width="1" stroke-linecap="round"/>
  <!-- Legs -->
  <line x1="93" y1="108" x2="89" y2="132" stroke="#37474f" stroke-width="7" stroke-linecap="round"/>
  <line x1="107" y1="108" x2="111" y2="132" stroke="#37474f" stroke-width="7" stroke-linecap="round"/>
  <!-- Motion sparkles near fists (four-point stars, drawn as shapes) -->
  <polygon points="48,40 50,34 52,40 58,42 52,44 50,50 48,44 42,42" fill="#ffb300" opacity="0.85"/>
  <polygon points="152,40 154,34 156,40 162,42 156,44 154,50 152,44 146,42" fill="#ffb300" opacity="0.85"/>
  <polygon points="100,20 101.5,16 103,20 107,21.5 103,23 101.5,27 100,23 96,21.5" fill="#ffb300" opacity="0.7"/>
</svg>
