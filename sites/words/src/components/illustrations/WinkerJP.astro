<!-- Japanese ウィンカー = turn signal (used as noun, often with 出す) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Road lines in background -->
  <line x1="0" y1="115" x2="200" y2="115" stroke="#a5d6a7" stroke-width="1" stroke-dasharray="4,4" opacity="0.6"/>
  <!-- Car viewed from rear -->
  <!-- Car body -->
  <rect x="55" y="50" width="90" height="65" fill="#42a5f5" rx="8"/>
  <!-- Rear window -->
  <rect x="63" y="58" width="74" height="22" fill="#b3e5fc" rx="4"/>
  <!-- Window divider -->
  <line x1="100" y1="58" x2="100" y2="80" stroke="#81d4fa" stroke-width="1"/>
  <!-- Trunk line -->
  <line x1="60" y1="88" x2="140" y2="88" stroke="#1e88e5" stroke-width="1" opacity="0.5"/>
  <!-- License plate -->
  <rect x="85" y="95" width="30" height="12" fill="white" stroke="#424242" stroke-width="0.5" rx="1"/>
  <text x="100" y="104" font-size="7" fill="#424242" text-anchor="middle">品川</text>
  <!-- Left tail light (red) -->
  <rect x="57" y="92" width="11" height="13" fill="#c62828" rx="2"/>
  <!-- Right turn signal (amber, flashing - this is the winker) -->
  <rect x="132" y="92" width="11" height="13" fill="#ffa726" rx="2"/>
  <!-- Flashing glow around turn signal -->
  <circle cx="137" cy="98" r="11" fill="#ffb74d" opacity="0.55"/>
  <circle cx="137" cy="98" r="16" fill="#ffcc80" opacity="0.35"/>
  <circle cx="137" cy="98" r="21" fill="#ffe0b2" opacity="0.2"/>
  <!-- Flash lines radiating -->
  <line x1="152" y1="88" x2="158" y2="83" stroke="#ff9800" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="155" y1="98" x2="162" y2="98" stroke="#ff9800" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="152" y1="108" x2="158" y2="114" stroke="#ff9800" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="148" y1="82" x2="151" y2="76" stroke="#ff9800" stroke-width="2" stroke-linecap="round"/>
  <!-- Wheels -->
  <circle cx="68" cy="118" r="8" fill="#263238"/>
  <circle cx="68" cy="118" r="3.5" fill="#607d8b"/>
  <circle cx="132" cy="118" r="8" fill="#263238"/>
  <circle cx="132" cy="118" r="3.5" fill="#607d8b"/>
  <!-- Curved arrow showing right turn direction -->
  <path d="M150 40 Q178 40 178 68" fill="none" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <polygon points="178,68 173,62 183,62" fill="#e53935"/>
  <!-- Small "右折" text near arrow -->
  <text x="165" y="35" font-size="10" font-weight="bold" fill="#e53935" text-anchor="middle">右折</text>
  <!-- Floor -->
  <rect x="0" y="132" width="200" height="28" fill="#c8e6c9" rx="0"/>
  <!-- Label -->
  <text x="100" y="150" font-size="12" font-weight="bold" fill="#2e7d32" text-anchor="middle">ウィンカーを出す</text>
</svg>
