  <path d="M60 130 C68 126 80 126 88 130" fill="none" stroke="#90a4ae" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
  <path d="M110 132 C118 128 130 128 138 132" fill="none" stroke="#90a4ae" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
  <!-- "fatigue" puff -->
  <circle cx="158" cy="100" r="6" fill="#b0bec5" opacity="0.5"/>
  <circle cx="168" cy="92" r="4" fill="#b0bec5" opacity="0.4"/>
</svg>
