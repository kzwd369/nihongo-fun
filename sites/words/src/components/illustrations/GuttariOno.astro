  <rect width="200" height="160" fill="#eceff1" rx="8"/>
  <!-- Slumped head tilted -->
  <g transform="rotate(18 100 80)">
    <circle cx="100" cy="80" r="44" fill="#cfd8dc"/>
    <circle cx="100" cy="80" r="44" fill="none" stroke="#90a4ae" stroke-width="2"/>
    <!-- Drained spiral eyes -->
    <path d="M78 74 a5 5 0 1 1 -1 5 a8 8 0 1 1 9 -3" fill="none" stroke="#546e7a" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M118 74 a5 5 0 1 1 -1 5 a8 8 0 1 1 9 -3" fill="none" stroke="#546e7a" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Limp wavy mouth -->
    <path d="M84 100 q8 6 16 0 q8 -6 16 0" fill="none" stroke="#546e7a" stroke-width="3" stroke-linecap="round"/>
  </g>
  <!-- Heavy sweat drops -->
  <path d="M150 50 C150 50 144 60 144 66 C144 71 148 74 152 74 C156 74 160 71 160 66 C160 60 150 50 150 50Z" fill="#81d4fa"/>
  <path d="M44 64 C44 64 40 71 40 75 C40 79 43 81 46 81 C49 81 52 79 52 75 C52 71 44 64 44 64Z" fill="#81d4fa" opacity="0.8"/>
