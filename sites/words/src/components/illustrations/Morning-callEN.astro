<!-- English "morning call" is archaic/unclear — correct modern English: "wake-up call" -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "morning call?" crossed out -->
  <rect x="15" y="18" width="82" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="38,46 48,46 43,54" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="56" y="36" font-size="10" fill="#424242" text-anchor="middle">"morning call?"</text>
  <!-- Red X over phrase -->
  <line x1="20" y1="20" x2="92" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="92" y1="20" x2="20" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Confused English speaker -->
  <!-- Head -->
  <circle cx="45" cy="82" r="13" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M33,80 Q33,68 45,66 Q57,68 57,80 L54,76 Q45,72 36,76 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="40" cy="82" r="1.5" fill="#3e2723"/>
  <circle cx="50" cy="82" r="1.5" fill="#3e2723"/>
  <!-- Wavy mouth -->
  <path d="M40,89 Q43,87 46,89 Q49,91 52,89" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="26" y="62" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="62" y="68" font-size="18" font-weight="bold" fill="#ff7043">?</text>
  <!-- Body -->
  <rect x="35" y="95" width="20" height="22" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms -->
  <line x1="35" y1="98" x2="22" y2="90" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="55" y1="98" x2="68" y2="90" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Hotel phone and bed scene (correct) -->
  <!-- Bed -->
  <rect x="112" y="92" width="70" height="18" fill="#b3e5fc" stroke="#0288d1" stroke-width="1" rx="2"/>
  <rect x="112" y="102" width="70" height="8" fill="#81d4fa" stroke="#0288d1" stroke-width="1"/>
  <!-- Pillow -->
  <rect x="116" y="88" width="18" height="10" fill="white" stroke="#bdbdbd" stroke-width="1" rx="2"/>
  <!-- Sleeping head on pillow -->
  <circle cx="125" cy="90" r="6" fill="#ffcc80"/>
  <path d="M122,90 Q123,89 124,90" fill="none" stroke="#3e2723" stroke-width="1" stroke-linecap="round"/>
  <path d="M126,90 Q127,89 128,90" fill="none" stroke="#3e2723" stroke-width="1" stroke-linecap="round"/>
  <!-- Phone on bedside -->
  <rect x="150" y="78" width="22" height="12" fill="#546e7a" rx="2"/>
  <rect x="154" y="72" width="14" height="7" fill="#37474f" rx="2"/>
  <!-- Phone cord curl -->
  <path d="M172,80 Q178,74 176,68" stroke="#37474f" stroke-width="1.5" fill="none"/>
  <!-- Ring waves -->
  <path d="M145,70 Q141,74 145,78" stroke="#ff7043" stroke-width="1.5" fill="none"/>
  <path d="M142,66 Q135,74 142,82" stroke="#ff7043" stroke-width="1.5" fill="none"/>
  <!-- Bell icon above phone -->
  <path d="M158,58 Q158,52 163,52 Q168,52 168,58 L170,64 L156,64 Z" fill="#ffb74d" stroke="#f57c00" stroke-width="1"/>
  <circle cx="163" cy="66" r="1.5" fill="#f57c00"/>
  <!-- "wake-up call ✓" label -->
  <text x="147" y="128" font-size="10" font-weight="bold" fill="#2e7d32" text-anchor="middle">wake-up call ✓</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
