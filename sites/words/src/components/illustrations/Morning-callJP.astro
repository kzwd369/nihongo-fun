<!-- Japanese モーニングコール = hotel wake-up call service (noun) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Wall clock showing 7:00 -->
  <circle cx="40" cy="35" r="18" fill="white" stroke="#546e7a" stroke-width="2"/>
  <circle cx="40" cy="35" r="1.5" fill="#263238"/>
  <!-- Hour marks -->
  <line x1="40" y1="20" x2="40" y2="23" stroke="#546e7a" stroke-width="1.5"/>
  <line x1="40" y1="47" x2="40" y2="50" stroke="#546e7a" stroke-width="1.5"/>
  <line x1="25" y1="35" x2="28" y2="35" stroke="#546e7a" stroke-width="1.5"/>
  <line x1="52" y1="35" x2="55" y2="35" stroke="#546e7a" stroke-width="1.5"/>
  <!-- Hour hand pointing to 7 -->
  <line x1="40" y1="35" x2="33" y2="43" stroke="#263238" stroke-width="2" stroke-linecap="round"/>
  <!-- Minute hand pointing to 12 -->
  <line x1="40" y1="35" x2="40" y2="22" stroke="#263238" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Digital label under clock -->
  <text x="40" y="63" font-size="9" font-weight="bold" fill="#37474f" text-anchor="middle">7:00 AM</text>
  <!-- Sunrise rays (morning) -->
  <line x1="15" y1="15" x2="22" y2="22" stroke="#ffb74d" stroke-width="2" stroke-linecap="round"/>
  <line x1="65" y1="15" x2="58" y2="22" stroke="#ffb74d" stroke-width="2" stroke-linecap="round"/>
  <line x1="12" y1="35" x2="18" y2="35" stroke="#ffb74d" stroke-width="2" stroke-linecap="round"/>
  <!-- Bed -->
  <rect x="75" y="95" width="110" height="22" fill="#b3e5fc" stroke="#0288d1" stroke-width="1.5" rx="3"/>
  <rect x="75" y="108" width="110" height="9" fill="#81d4fa" stroke="#0288d1" stroke-width="1"/>
  <!-- Headboard -->
  <rect x="75" y="78" width="10" height="22" fill="#8d6e63" rx="2"/>
  <!-- Pillow -->
  <rect x="88" y="88" width="22" height="12" fill="white" stroke="#bdbdbd" stroke-width="1" rx="2"/>
  <!-- Person's head on pillow (just woke up) -->
  <circle cx="100" cy="90" r="8" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M92,88 Q92,80 100,78 Q108,80 108,88 L105,85 Q100,82 95,85 Z" fill="#3e2723"/>
  <!-- Surprised open eyes -->
  <circle cx="97" cy="90" r="1.5" fill="#3e2723"/>
  <circle cx="103" cy="90" r="1.5" fill="#3e2723"/>
  <!-- Small O mouth -->
  <ellipse cx="100" cy="94" rx="1.5" ry="1" fill="#3e2723"/>
  <!-- Blanket line -->
  <path d="M108,98 L180,98" stroke="#0277bd" stroke-width="1" fill="none"/>
  <!-- Bedside table -->
  <rect x="140" y="82" width="34" height="16" fill="#a1887f" rx="1"/>
  <!-- Phone on table -->
  <rect x="146" y="70" width="22" height="12" fill="#e53935" rx="2"/>
  <rect x="150" y="64" width="14" height="7" fill="#c62828" rx="2"/>
  <!-- Phone cord curl -->
  <path d="M168,72 Q174,66 172,60" stroke="#c62828" stroke-width="1.5" fill="none"/>
  <!-- Ring waves (phone ringing) -->
  <path d="M143,64 Q138,69 143,74" stroke="#ff7043" stroke-width="1.5" fill="none"/>
  <path d="M140,60 Q132,68 140,76" stroke="#ff7043" stroke-width="1.5" fill="none"/>
  <path d="M173,64 Q178,69 173,74" stroke="#ff7043" stroke-width="1.5" fill="none"/>
  <path d="M176,60 Q184,68 176,76" stroke="#ff7043" stroke-width="1.5" fill="none"/>
  <!-- Bell/ring notation -->
  <text x="128" y="62" font-size="14" font-weight="bold" fill="#ff7043">♪</text>
  <text x="182" y="58" font-size="12" font-weight="bold" fill="#ff7043">♪</text>
  <!-- Floor -->
  <rect x="0" y="128" width="200" height="32" fill="#c8e6c9" rx="0"/>
  <!-- Label -->
  <text x="100" y="148" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">モーニングコール</text>
</svg>
