<!-- 日本語「サービス」= 無料・おまけ（居酒屋や寿司屋で店主が出す一品） -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Sushi counter (wooden) -->
  <rect x="0" y="105" width="200" height="10" fill="#a1887f"/>
  <rect x="0" y="115" width="200" height="30" fill="#8d6e63"/>
  <!-- Noren curtain behind -->
  <rect x="15" y="15" width="55" height="20" fill="#1565c0" opacity="0.8" rx="2"/>
  <line x1="30" y1="15" x2="30" y2="35" stroke="#0d47a1" stroke-width="1"/>
  <line x1="45" y1="15" x2="45" y2="35" stroke="#0d47a1" stroke-width="1"/>
  <line x1="60" y1="15" x2="60" y2="35" stroke="#0d47a1" stroke-width="1"/>
  <text x="42" y="29" font-size="9" fill="white" text-anchor="middle" font-weight="bold">寿司</text>
  <!-- Sushi chef (itamae) on left -->
  <!-- Head -->
  <circle cx="55" cy="60" r="12" fill="#ffcc80"/>
  <!-- Chef hat band (hachimaki - white headband) -->
  <rect x="43" y="50" width="24" height="5" fill="white" stroke="#bdbdbd" stroke-width="0.5"/>
  <circle cx="45" cy="52" r="1" fill="#e53935"/>
  <!-- Hair under band -->
  <path d="M44,58 Q44,55 55,55 Q66,55 66,58 L64,58 Q55,56 46,58 Z" fill="#3e2723"/>
  <!-- Smile eyes (happy) -->
  <path d="M48,61 Q51,58 54,61" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <path d="M57,61 Q60,58 63,61" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <!-- Big smile -->
  <path d="M49,67 Q55,72 61,67" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Chef white uniform -->
  <rect x="43" y="72" width="24" height="30" fill="white" stroke="#bdbdbd" stroke-width="1" rx="2"/>
  <!-- Uniform collar V -->
  <polygon points="55,72 49,82 61,82" fill="#e8f5e9"/>
  <!-- Arm extending plate -->
  <line x1="67" y1="80" x2="85" y2="95" stroke="white" stroke-width="6" stroke-linecap="round"/>
  <line x1="67" y1="80" x2="85" y2="95" stroke="#bdbdbd" stroke-width="6" stroke-linecap="round" fill="none" opacity="0.3"/>
  <!-- Hand -->
  <circle cx="86" cy="96" r="3" fill="#ffcc80"/>
  <!-- Small plate with otsumami (side dish) -->
  <ellipse cx="100" cy="100" rx="16" ry="4" fill="#ffffff" stroke="#bdbdbd" stroke-width="1"/>
  <ellipse cx="100" cy="99" rx="14" ry="3" fill="#fff8e1"/>
  <!-- Edamame on plate -->
  <ellipse cx="95" cy="97" rx="3" ry="2" fill="#8bc34a"/>
  <ellipse cx="102" cy="96" rx="3" ry="2" fill="#8bc34a"/>
  <ellipse cx="107" cy="98" rx="3" ry="2" fill="#8bc34a"/>
  <!-- Sparkles around plate (おまけ感) -->
  <text x="82" y="88" font-size="12" fill="#ffb300" font-weight="bold">★</text>
  <text x="118" y="90" font-size="14" fill="#ffb300" font-weight="bold">★</text>
  <text x="105" y="82" font-size="9" fill="#ffd54f" font-weight="bold">★</text>
  <text x="88" y="78" font-size="8" fill="#ffd54f">★</text>
  <!-- Customer on right -->
  <!-- Head -->
  <circle cx="155" cy="70" r="12" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M144,68 Q143,57 155,55 Q167,57 166,68 L164,65 Q155,62 146,65 Z" fill="#5d4037"/>
  <!-- Happy eyes -->
  <path d="M148,70 Q151,67 154,70" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <path d="M157,70 Q160,67 163,70" fill="none" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <!-- Big smile -->
  <path d="M150,76 Q155,80 160,76" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Rosy cheeks -->
  <circle cx="146" cy="75" r="2" fill="#ffab91" opacity="0.6"/>
  <circle cx="164" cy="75" r="2" fill="#ffab91" opacity="0.6"/>
  <!-- Body -->
  <rect x="144" y="82" width="22" height="23" fill="#ef9a9a" rx="3"/>
  <!-- Arm reaching -->
  <line x1="144" y1="90" x2="128" y2="98" stroke="#ef9a9a" stroke-width="5" stroke-linecap="round"/>
  <circle cx="127" cy="98" r="3" fill="#ffe0b2"/>
  <!-- Happy expression mark above customer -->
  <text x="172" y="55" font-size="12" fill="#e53935" font-weight="bold">♡</text>
  <!-- Label at bottom -->
  <text x="100" y="135" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">これサービスね！</text>
  <text x="100" y="155" font-size="8" fill="#558b2f" text-anchor="middle">(= おまけ・無料)</text>
</svg>
