<!-- Japanese キャッチボール = playing catch, used as a metaphor for back-and-forth conversation. Two people toss speech bubbles to each other while wearing gloves. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="cbjp-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#aed581"/>
      <stop offset="60%" stop-color="#dcedc8"/>
      <stop offset="100%" stop-color="#f1f8e9"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#cbjp-sky)" rx="8"/>
  <!-- Sun -->
  <circle cx="172" cy="26" r="11" fill="#ffd54f"/>
  <!-- Ground -->
  <rect x="0" y="124" width="200" height="36" fill="#8d6e63"/>
  <ellipse cx="100" cy="124" rx="100" ry="9" fill="#a1887f"/>
  <!-- Left player -->
  <circle cx="40" cy="86" r="9" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.6"/>
  <path d="M31 84 Q40 74 49 84 Q49 78 40 76 Q31 78 31 84 Z" fill="#5d4037"/>
  <rect x="32" y="95" width="16" height="24" rx="3" fill="#42a5f5"/>
  <line x1="48" y1="100" x2="60" y2="92" stroke="#ffe0b2" stroke-width="4" stroke-linecap="round"/>
  <line x1="32" y1="100" x2="22" y2="94" stroke="#ffe0b2" stroke-width="4" stroke-linecap="round"/>
  <!-- glove (left) -->
  <ellipse cx="19" cy="92" rx="6" ry="7" fill="#8d6e63" stroke="#5d4037" stroke-width="0.9"/>
  <path d="M16 88 L16 96" stroke="#5d4037" stroke-width="0.8"/>
  <path d="M22 88 L22 96" stroke="#5d4037" stroke-width="0.8"/>
  <line x1="36" y1="119" x2="31" y2="123" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <line x1="44" y1="119" x2="49" y2="123" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <!-- Right player -->
  <circle cx="160" cy="86" r="9" fill="#ffe0b2" stroke="#5d4037" stroke-width="0.6"/>
  <path d="M151 84 Q160 74 169 84 Q169 78 160 76 Q151 78 151 84 Z" fill="#5d4037"/>
  <rect x="152" y="95" width="16" height="24" rx="3" fill="#ef5350"/>
  <line x1="152" y1="100" x2="140" y2="92" stroke="#ffe0b2" stroke-width="4" stroke-linecap="round"/>
  <line x1="168" y1="100" x2="178" y2="94" stroke="#ffe0b2" stroke-width="4" stroke-linecap="round"/>
  <!-- glove (right) -->
  <ellipse cx="181" cy="92" rx="6" ry="7" fill="#8d6e63" stroke="#5d4037" stroke-width="0.9"/>
  <path d="M178 88 L178 96" stroke="#5d4037" stroke-width="0.8"/>
  <path d="M184 88 L184 96" stroke="#5d4037" stroke-width="0.8"/>
  <line x1="156" y1="119" x2="151" y2="123" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <line x1="164" y1="119" x2="169" y2="123" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <!-- Two speech bubbles passing each other = conversation metaphor -->
  <path d="M70 60 Q70 52 82 52 L100 52 Q112 52 112 60 Q112 68 100 68 L92 68 L86 74 L88 68 L82 68 Q70 68 70 60 Z" fill="#fff" stroke="#7cb342" stroke-width="1"/>
  <path d="M88 50 Q88 44 98 44 L116 44 Q126 44 126 50 Q126 56 116 56 L112 56 L116 62 L108 56 L98 56 Q88 56 88 50 Z" fill="#e8f5e9" stroke="#558b2f" stroke-width="1"/>
  <!-- Exchange arrows between the bubbles -->
  <path d="M64 56 Q56 40 96 38" fill="none" stroke="#558b2f" stroke-width="1.2" stroke-dasharray="3 3"/>
  <polygon points="94,34 100,38 93,41" fill="#558b2f"/>
  <path d="M132 50 Q140 66 104 70" fill="none" stroke="#7cb342" stroke-width="1.2" stroke-dasharray="3 3"/>
  <polygon points="106,74 100,70 107,67" fill="#7cb342"/>
</svg>
