<!-- Japanese ホームページ = the WHOLE website (every page). A browser frame containing multiple overlapping pages. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="hpjp-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e1bee7"/>
      <stop offset="100%" stop-color="#f3e5f5"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#hpjp-bg)" rx="8"/>
  <!-- Browser window framing the whole site -->
  <rect x="26" y="24" width="148" height="112" rx="6" fill="#fff" stroke="#6a1b9a" stroke-width="2"/>
  <!-- Browser chrome -->
  <rect x="26" y="24" width="148" height="13" rx="6" fill="#ce93d8"/>
  <circle cx="34" cy="30.5" r="1.6" fill="#fff"/>
  <circle cx="40" cy="30.5" r="1.6" fill="#fff"/>
  <circle cx="46" cy="30.5" r="1.6" fill="#fff"/>
  <rect x="54" y="27.5" width="114" height="6" rx="3" fill="#fff" opacity="0.85"/>
  <!-- Multiple overlapping pages inside = the entire site -->
  <!-- back page 1 -->
  <rect x="48" y="50" width="60" height="76" rx="3" fill="#f3e5f5" stroke="#9c27b0" stroke-width="1"/>
  <rect x="54" y="56" width="48" height="8" rx="1" fill="#ce93d8"/>
  <rect x="54" y="68" width="32" height="4" rx="1" fill="#e1bee7"/>
  <rect x="54" y="75" width="40" height="4" rx="1" fill="#e1bee7"/>
  <!-- back page 2 -->
  <rect x="64" y="44" width="60" height="76" rx="3" fill="#f8eafc" stroke="#9c27b0" stroke-width="1"/>
  <rect x="70" y="50" width="48" height="8" rx="1" fill="#ce93d8"/>
  <rect x="70" y="62" width="36" height="4" rx="1" fill="#e1bee7"/>
  <rect x="70" y="69" width="44" height="4" rx="1" fill="#e1bee7"/>
  <!-- front page (top) -->
  <rect x="82" y="48" width="64" height="80" rx="4" fill="#fff" stroke="#6a1b9a" stroke-width="1.5"/>
  <rect x="88" y="54" width="52" height="9" rx="1" fill="#9c27b0"/>
  <rect x="88" y="68" width="22" height="22" rx="1" fill="#e1bee7"/>
  <rect x="114" y="68" width="26" height="5" rx="1" fill="#ce93d8"/>
  <rect x="114" y="77" width="26" height="5" rx="1" fill="#ce93d8"/>
  <rect x="114" y="86" width="20" height="5" rx="1" fill="#ce93d8"/>
  <rect x="88" y="96" width="52" height="5" rx="1" fill="#ce93d8"/>
  <rect x="88" y="105" width="38" height="5" rx="1" fill="#ce93d8"/>
  <!-- linking arrows connecting the stacked pages = one whole site -->
  <path d="M60 132 Q72 142 92 134" fill="none" stroke="#6a1b9a" stroke-width="1.2" stroke-dasharray="3 3"/>
  <path d="M114 132 Q132 142 150 134" fill="none" stroke="#6a1b9a" stroke-width="1.2" stroke-dasharray="3 3"/>
</svg>
