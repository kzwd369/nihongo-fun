<!-- Japanese driver's POV through the "front glass" (windshield) in the rain -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Dashboard (bottom interior) -->
  <path d="M0,130 L200,130 L200,145 L0,145 Z" fill="#5d4037"/>
  <!-- Steering wheel hint -->
  <ellipse cx="100" cy="148" rx="32" ry="8" fill="#3e2723"/>
  <circle cx="100" cy="147" r="4" fill="#6d4c41"/>
  <!-- Windshield frame (A-pillars and roof) -->
  <path d="M18,30 L182,30 L180,128 L20,128 Z" fill="none" stroke="#455a64" stroke-width="4" stroke-linejoin="round"/>
  <!-- Glass area (the windshield itself) -->
  <path d="M22,32 L178,32 L176,126 L24,126 Z" fill="#bbdefb" opacity="0.7"/>
  <!-- Sky visible through windshield -->
  <path d="M22,32 L178,32 L177,70 L23,70 Z" fill="#90a4ae" opacity="0.5"/>
  <!-- Road ahead (perspective) -->
  <path d="M65,126 L135,126 L115,70 L85,70 Z" fill="#546e7a"/>
  <!-- Road center lines (dashed, perspective) -->
  <polygon points="98,120 102,120 101,110 99,110" fill="#fff59d"/>
  <polygon points="98,102 101,102 100,94 99,94" fill="#fff59d"/>
  <polygon points="99,88 100,88 100,82 99,82" fill="#fff59d"/>
  <!-- Road edges -->
  <line x1="65" y1="126" x2="85" y2="70" stroke="#eceff1" stroke-width="1.5"/>
  <line x1="135" y1="126" x2="115" y2="70" stroke="#eceff1" stroke-width="1.5"/>
  <!-- Distant horizon hills -->
  <path d="M23,70 Q50,62 80,68 Q110,60 140,66 Q165,62 177,68 L177,70 Z" fill="#81c784" opacity="0.6"/>
  <!-- Raindrops on glass -->
  <ellipse cx="40" cy="50" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="60" cy="45" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="80" cy="55" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="120" cy="48" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="140" cy="52" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="160" cy="46" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="50" cy="85" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="150" cy="88" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="35" cy="110" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <ellipse cx="165" cy="108" rx="1.5" ry="3" fill="#4fc3f7" opacity="0.8"/>
  <!-- Falling rain streaks -->
  <line x1="30" y1="35" x2="28" y2="42" stroke="#4fc3f7" stroke-width="1" opacity="0.6"/>
  <line x1="70" y1="33" x2="68" y2="40" stroke="#4fc3f7" stroke-width="1" opacity="0.6"/>
  <line x1="110" y1="36" x2="108" y2="43" stroke="#4fc3f7" stroke-width="1" opacity="0.6"/>
  <line x1="150" y1="34" x2="148" y2="41" stroke="#4fc3f7" stroke-width="1" opacity="0.6"/>
  <!-- Two windshield wipers -->
  <!-- Left wiper -->
  <circle cx="70" cy="126" r="2.5" fill="#37474f"/>
  <line x1="70" y1="126" x2="55" y2="80" stroke="#263238" stroke-width="2" stroke-linecap="round"/>
  <line x1="52" y1="78" x2="62" y2="82" stroke="#37474f" stroke-width="3" stroke-linecap="round"/>
  <!-- Right wiper -->
  <circle cx="130" cy="126" r="2.5" fill="#37474f"/>
  <line x1="130" y1="126" x2="145" y2="80" stroke="#263238" stroke-width="2" stroke-linecap="round"/>
  <line x1="138" y1="82" x2="148" y2="78" stroke="#37474f" stroke-width="3" stroke-linecap="round"/>
  <!-- Label background -->
  <rect x="55" y="133" width="90" height="10" fill="#2e7d32" rx="3"/>
  <text x="100" y="141" font-size="8" font-weight="bold" fill="white" text-anchor="middle">フロントガラス</text>
</svg>
