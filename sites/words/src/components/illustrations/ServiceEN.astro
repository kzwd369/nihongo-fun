<!-- English "service" means duty/assistance, NOT free — correct: "on the house" / "complimentary" -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble: "Is this service free?" -->
  <rect x="8" y="15" width="86" height="32" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="30,47 40,47 35,55" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="51" y="28" font-size="8" fill="#424242" text-anchor="middle">Is this "service"</text>
  <text x="51" y="40" font-size="8" fill="#424242" text-anchor="middle">free? <tspan fill="#e53935" font-weight="bold">?</tspan></text>
  <!-- Confused English speaker -->
  <!-- Head -->
  <circle cx="40" cy="85" r="14" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M27,82 Q27,70 40,68 Q53,70 53,82 L50,78 Q40,74 30,78 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="35" cy="85" r="1.5" fill="#3e2723"/>
  <circle cx="45" cy="85" r="1.5" fill="#3e2723"/>
  <!-- Confused wavy mouth -->
  <path d="M35,92 Q38,90 41,92 Q44,94 47,92" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="22" y="68" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="57" y="72" font-size="16" font-weight="bold" fill="#ff7043">?</text>
  <!-- Body -->
  <rect x="30" y="99" width="20" height="22" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms -->
  <line x1="30" y1="102" x2="18" y2="94" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="50" y1="102" x2="62" y2="94" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Bartender presenting complimentary drink -->
  <!-- Bartender head -->
  <circle cx="135" cy="62" r="11" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M125,60 Q124,50 135,48 Q146,50 145,60 L142,57 Q135,54 128,57 Z" fill="#3e2723"/>
  <!-- Mustache -->
  <path d="M131,68 Q135,70 139,68" fill="none" stroke="#3e2723" stroke-width="2" stroke-linecap="round"/>
  <!-- Eyes -->
  <circle cx="131" cy="62" r="1.2" fill="#3e2723"/>
  <circle cx="139" cy="62" r="1.2" fill="#3e2723"/>
  <!-- Smile -->
  <path d="M131,71 Q135,73 139,71" fill="none" stroke="#3e2723" stroke-width="1.2" stroke-linecap="round" opacity="0.6"/>
  <!-- Bartender vest/body -->
  <rect x="123" y="73" width="24" height="28" fill="#546e7a" rx="3"/>
  <!-- White shirt V -->
  <polygon points="135,73 130,84 140,84" fill="white"/>
  <!-- Bow tie -->
  <polygon points="132,79 135,82 138,79 138,84 135,82 132,84" fill="#e53935"/>
  <!-- Arm holding drink -->
  <line x1="125" y1="82" x2="112" y2="95" stroke="#546e7a" stroke-width="5" stroke-linecap="round"/>
  <!-- Cocktail glass -->
  <polygon points="103,92 121,92 112,106" fill="#ffccbc" stroke="#ef6c00" stroke-width="1"/>
  <line x1="112" y1="106" x2="112" y2="115" stroke="#ef6c00" stroke-width="1.5"/>
  <line x1="107" y1="115" x2="117" y2="115" stroke="#ef6c00" stroke-width="1.5"/>
  <!-- Cherry -->
  <circle cx="118" cy="93" r="2" fill="#e53935"/>
  <!-- Sparkles around drink -->
  <text x="100" y="88" font-size="10" fill="#ffb300">★</text>
  <text x="122" y="86" font-size="8" fill="#ffb300">★</text>
  <!-- "on the house ✓" label -->
  <text x="150" y="128" font-size="9" font-weight="bold" fill="#2e7d32" text-anchor="middle">on the house ✓</text>
  <text x="150" y="140" font-size="8" fill="#2e7d32" text-anchor="middle">complimentary</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
