<!-- Tsundere: a girl turns away with arms crossed and an anger mark (tsun), while blushing and glancing back with a heart (dere) — the two-sided nature in one image -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="tsunBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fce4ec"/>
      <stop offset="100%" stop-color="#e1f5fe"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" rx="8" fill="url(#tsunBg)"/>

  <!-- Body: she stands turned to her left, torso angled away -->
  <path d="M76,150 L74,104 Q76,90 92,86 L112,86 Q128,90 130,104 L128,150 Z" fill="#ef9a9a" stroke="#c62828" stroke-width="1.2"/>
  <!-- Collar of blouse -->
  <path d="M92,87 L102,96 L112,87" fill="#fff" stroke="#c62828" stroke-width="0.8"/>

  <!-- Crossed arms over the chest -->
  <path d="M78,108 Q100,118 122,108 Q120,120 100,122 Q80,120 78,108 Z" fill="#e57373" stroke="#c62828" stroke-width="1"/>
  <path d="M122,110 Q100,100 78,110 Q80,124 100,124 Q120,124 122,110 Z" fill="#ef9a9a" stroke="#c62828" stroke-width="1"/>
  <!-- Hands tucked -->
  <ellipse cx="80" cy="112" rx="5" ry="4" fill="#ffe0b2"/>
  <ellipse cx="120" cy="112" rx="5" ry="4" fill="#ffe0b2"/>

  <!-- Neck -->
  <rect x="95" y="78" width="10" height="11" fill="#ffe0b2"/>

  <!-- Head turned to side (3/4 facing away, glancing back) -->
  <circle cx="100" cy="62" r="22" fill="#ffe0b2"/>

  <!-- Long hair with twin-tail flicked to the turned side -->
  <path d="M78,62 Q74,36 100,36 Q126,36 122,62 Q120,50 110,46 Q116,56 100,48 Q92,56 84,50 Q80,56 78,62 Z" fill="#ffb300"/>
  <!-- Side twintail swinging out (motion of turning away) -->
  <path d="M122,52 Q140,54 144,74 Q146,92 134,100 Q140,84 130,76 Q138,66 122,64 Z" fill="#ffb300" stroke="#fb8c00" stroke-width="0.6"/>
  <path d="M78,54 Q66,58 66,72 Q66,84 74,90 Q70,78 76,72 Q70,64 80,62 Z" fill="#ffb300" stroke="#fb8c00" stroke-width="0.6"/>
  <!-- Hair ribbons -->
  <path d="M120,52 l-6,-4 l6,-1 l5,4 z" fill="#e91e63"/>
  <path d="M80,56 l6,-4 l-6,-1 l-5,4 z" fill="#e91e63"/>

  <!-- Eyes: glancing back (pupils shifted toward the viewer), one brow up = tsun annoyance -->
  <ellipse cx="92" cy="62" rx="3.6" ry="4.6" fill="#fff"/>
  <ellipse cx="104" cy="62" rx="3.6" ry="4.6" fill="#fff"/>
  <circle cx="90" cy="63" r="2.2" fill="#5d4037"/>
  <circle cx="102" cy="63" r="2.2" fill="#5d4037"/>
  <circle cx="89" cy="62" r="0.8" fill="#fff"/>
  <circle cx="101" cy="62" r="0.8" fill="#fff"/>
  <!-- Annoyed angled brows -->
  <path d="M87,55 L95,57" stroke="#8d6e38" stroke-width="1.6" stroke-linecap="round"/>
  <path d="M101,57 L109,55" stroke="#8d6e38" stroke-width="1.6" stroke-linecap="round"/>

  <!-- Heavy blush on both cheeks (dere) -->
  <ellipse cx="86" cy="70" rx="4.5" ry="3" fill="#f06292" opacity="0.65"/>
  <ellipse cx="110" cy="70" rx="4.5" ry="3" fill="#f06292" opacity="0.65"/>
  <!-- blush hatch lines -->
  <path d="M84,68 l4,1 M84,71 l4,1 M108,68 l4,1 M108,71 l4,1" stroke="#ec407a" stroke-width="0.6" opacity="0.6"/>

  <!-- Pouty small mouth (holding back) -->
  <path d="M95,76 Q100,73 105,76" fill="none" stroke="#bf6a4a" stroke-width="1.4" stroke-linecap="round"/>

  <!-- TSUN side: anger mark (popping vein) top-left -->
  <g transform="translate(46,40)">
    <path d="M0,4 L4,0 L4,4 L8,4 L4,8 L4,12 L0,8 L-4,8 Z" fill="#e53935"/>
    <path d="M6,-4 L9,-1 L7,1 L10,4" fill="none" stroke="#e53935" stroke-width="1.6" stroke-linecap="round"/>
  </g>
  <!-- Tsun spike lines around her on the turned-away side -->
  <path d="M58,60 L50,56 M60,74 L52,74 M62,46 L56,40" stroke="#e57373" stroke-width="2" stroke-linecap="round" opacity="0.7"/>

  <!-- DERE side: floating hearts top-right -->
  <path d="M156,42 C156,42 152,37 147,39 C142,41 142,48 147,52 L156,60 L165,52 C170,48 170,41 165,39 C160,37 156,42 156,42Z" fill="#ec407a" opacity="0.85"/>
  <path d="M138,66 C138,66 136,63 133,64 C130,65 130,69 133,71 L138,75 L143,71 C146,69 146,65 143,64 C140,63 138,66 138,66Z" fill="#f48fb1" opacity="0.75"/>
  <path d="M168,72 C168,72 167,70 165,70.5 C163,71 163,73 165,75 L168,77 L171,75 C173,73 173,71 171,70.5 C169,70 168,72 168,72Z" fill="#f48fb1" opacity="0.6"/>

  <!-- Sparkle on the dere side -->
  <path d="M150,30 L152,26 L154,30 L152,34Z" fill="#f06292" opacity="0.6"/>
</svg>
