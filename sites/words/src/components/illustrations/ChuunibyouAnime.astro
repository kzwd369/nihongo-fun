<!-- Chuunibyou: a uniformed boy strikes the "evil eye" pose, covering one eye with a bandaged hand, surrounded by dark aura, flames and edgy effects -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <defs>
    <radialGradient id="chuuniBg" cx="50%" cy="40%" r="75%">
      <stop offset="0%" stop-color="#4527a0"/>
      <stop offset="100%" stop-color="#12002e"/>
    </radialGradient>
    <radialGradient id="chuuniEye" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fff59d"/>
      <stop offset="60%" stop-color="#ffca28"/>
      <stop offset="100%" stop-color="#e65100"/>
    </radialGradient>
  </defs>
  <rect width="200" height="160" rx="8" fill="url(#chuuniBg)"/>

  <!-- Dark aura swirls behind -->
  <path d="M40,150 Q22,110 34,72 Q42,46 58,38" fill="none" stroke="#7c4dff" stroke-width="3" opacity="0.45" stroke-linecap="round"/>
  <path d="M160,150 Q178,108 166,70 Q158,46 142,38" fill="none" stroke="#7c4dff" stroke-width="3" opacity="0.45" stroke-linecap="round"/>
  <path d="M52,30 Q60,16 76,14" fill="none" stroke="#b388ff" stroke-width="2" opacity="0.4" stroke-linecap="round"/>
  <path d="M148,30 Q140,16 124,14" fill="none" stroke="#b388ff" stroke-width="2" opacity="0.4" stroke-linecap="round"/>

  <!-- Rising flames at the base -->
  <path d="M55,150 Q50,130 58,118 Q60,132 66,126 Q64,140 70,150 Z" fill="#ff7043" opacity="0.85"/>
  <path d="M58,150 Q56,134 62,126 Q63,138 66,150 Z" fill="#ffd54f" opacity="0.85"/>
  <path d="M145,150 Q150,130 142,118 Q140,132 134,126 Q136,140 130,150 Z" fill="#ff7043" opacity="0.85"/>
  <path d="M142,150 Q144,134 138,126 Q137,138 134,150 Z" fill="#ffd54f" opacity="0.85"/>

  <!-- Body / school uniform jacket (gakuran) -->
  <path d="M72,150 L70,108 Q72,96 85,92 L115,92 Q128,96 130,108 L128,150 Z" fill="#1a237e" stroke="#0d113d" stroke-width="1.5"/>
  <!-- Jacket center line + collar -->
  <line x1="100" y1="96" x2="100" y2="150" stroke="#0d113d" stroke-width="1.5"/>
  <path d="M88,93 L100,102 L112,93" fill="#283593" stroke="#0d113d" stroke-width="1"/>
  <!-- Gold buttons -->
  <circle cx="100" cy="110" r="1.6" fill="#ffd54f"/>
  <circle cx="100" cy="122" r="1.6" fill="#ffd54f"/>
  <circle cx="100" cy="134" r="1.6" fill="#ffd54f"/>

  <!-- Neck -->
  <rect x="94" y="84" width="12" height="12" fill="#ffe0b2"/>

  <!-- Head -->
  <circle cx="100" cy="68" r="22" fill="#ffe0b2"/>
  <!-- Spiky edgy hair -->
  <path d="M78,66 Q74,40 96,42 Q88,36 104,36 Q98,30 116,40 Q126,46 122,66 Q118,52 108,50 Q112,58 100,52 Q102,60 90,52 Q88,60 82,54 Q80,62 78,66 Z" fill="#311b92"/>

  <!-- Open visible eye (left): intense, glowing -->
  <ellipse cx="91" cy="68" rx="4" ry="5" fill="#fff"/>
  <circle cx="91" cy="68" r="3" fill="#7c4dff"/>
  <circle cx="91" cy="68" r="1.3" fill="#1a0033"/>
  <!-- Sharp angry brow over open eye -->
  <path d="M85,60 L96,63" stroke="#311b92" stroke-width="2" stroke-linecap="round"/>

  <!-- Smug grin -->
  <path d="M94,80 Q100,85 107,79" fill="none" stroke="#8d4e00" stroke-width="1.6" stroke-linecap="round"/>

  <!-- Bandaged right arm raised across face -->
  <path d="M126,128 Q138,112 130,92 Q124,78 112,74" fill="none" stroke="#fafafa" stroke-width="9" stroke-linecap="round"/>
  <!-- Bandage wrap lines -->
  <path d="M118,80 L124,84 M122,92 L130,94 M127,104 L134,106 M129,116 L136,118" stroke="#bdbdbd" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>

  <!-- Hand covering the right eye (jakigan pose) -->
  <path d="M104,62 Q116,58 122,66 Q124,74 116,78 Q108,80 104,74 Z" fill="#ffe0b2" stroke="#e0b083" stroke-width="0.8"/>
  <!-- Finger gaps -->
  <path d="M108,62 L110,76 M114,61 L116,77 M119,63 L120,76" stroke="#e0b083" stroke-width="0.8" stroke-linecap="round"/>

  <!-- Glowing "evil eye" peeking between fingers -->
  <circle cx="112" cy="69" r="3.2" fill="url(#chuuniEye)"/>
  <circle cx="112" cy="69" r="1" fill="#bf360c"/>
  <!-- Eye glow rays -->
  <path d="M112,62 L112,58 M118,69 L122,69 M116,64 L119,61 M116,74 L119,77" stroke="#ffca28" stroke-width="1.4" stroke-linecap="round" opacity="0.85"/>

  <!-- Speed / focus lines emphasizing the pose -->
  <path d="M40,68 L60,70 M44,82 L62,82 M48,52 L64,58" stroke="#b388ff" stroke-width="1.2" opacity="0.5" stroke-linecap="round"/>
  <path d="M160,68 L140,70 M156,82 L138,82" stroke="#b388ff" stroke-width="1.2" opacity="0.5" stroke-linecap="round"/>

  <!-- Sparks of dark energy -->
  <circle cx="50" cy="40" r="1.6" fill="#e040fb" opacity="0.8"/>
  <circle cx="150" cy="44" r="1.6" fill="#e040fb" opacity="0.8"/>
  <circle cx="62" cy="100" r="1.2" fill="#b388ff" opacity="0.7"/>
  <circle cx="138" cy="100" r="1.2" fill="#b388ff" opacity="0.7"/>

  <!-- Ground mist -->
  <ellipse cx="100" cy="152" rx="58" ry="4" fill="#12002e" opacity="0.6"/>
</svg>
