<!-- Staring eyes — じろじろ (staring intently) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#ede7f6" rx="8"/>
  <!-- Big central eye -->
  <ellipse cx="100" cy="80" rx="56" ry="34" fill="white"/>
  <ellipse cx="100" cy="80" rx="56" ry="34" fill="none" stroke="#7e57c2" stroke-width="2.5"/>
  <!-- Iris (looking to the side, scrutinizing) -->
  <circle cx="116" cy="80" r="22" fill="#5e35b1"/>
  <circle cx="116" cy="80" r="11" fill="#311b92"/>
  <circle cx="122" cy="73" r="4" fill="white" opacity="0.8"/>
  <!-- Heavy stare brow -->
  <path d="M48 52 C70 42 100 42 120 50" fill="none" stroke="#5e35b1" stroke-width="3.5" stroke-linecap="round"/>
  <!-- Smaller darting eyes around (multiple gazes) -->
  <ellipse cx="42" cy="34" rx="16" ry="9" fill="white" stroke="#9575cd" stroke-width="1.5"/>
  <circle cx="48" cy="34" r="5" fill="#5e35b1"/>
  <ellipse cx="162" cy="36" rx="16" ry="9" fill="white" stroke="#9575cd" stroke-width="1.5"/>
  <circle cx="156" cy="36" r="5" fill="#5e35b1"/>
  <ellipse cx="40" cy="126" rx="15" ry="8" fill="white" stroke="#9575cd" stroke-width="1.5"/>
  <circle cx="46" cy="126" r="4.5" fill="#5e35b1"/>
  <ellipse cx="160" cy="124" rx="15" ry="8" fill="white" stroke="#9575cd" stroke-width="1.5"/>
  <circle cx="154" cy="124" r="4.5" fill="#5e35b1"/>
</svg>
