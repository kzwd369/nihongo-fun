<!-- Japanese イメチェン = makeover. Same person shown before -> after (hair and clothes change across two panels). -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="icjp-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f8bbd0"/>
      <stop offset="100%" stop-color="#fce4ec"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#icjp-bg)" rx="8"/>
  <!-- BEFORE panel (left) -->
  <rect x="14" y="28" width="68" height="110" rx="6" fill="#fff" opacity="0.55"/>
  <!-- long plain hair -->
  <path d="M33 64 Q48 48 63 64 L63 100 L33 100 Z" fill="#5d4037"/>
  <circle cx="48" cy="68" r="13" fill="#ffe0b2"/>
  <path d="M33 64 Q48 52 63 64 L63 72 Q48 64 33 72 Z" fill="#5d4037"/>
  <!-- neutral eyes -->
  <circle cx="43" cy="68" r="1.6" fill="#5d4037"/>
  <circle cx="53" cy="68" r="1.6" fill="#5d4037"/>
  <path d="M44 75 L52 75" stroke="#5d4037" stroke-width="1" stroke-linecap="round"/>
  <!-- glasses -->
  <circle cx="43" cy="68" r="3.4" fill="none" stroke="#37474f" stroke-width="0.9"/>
  <circle cx="53" cy="68" r="3.4" fill="none" stroke="#37474f" stroke-width="0.9"/>
  <line x1="46.4" y1="68" x2="49.6" y2="68" stroke="#37474f" stroke-width="0.9"/>
  <!-- plain gray clothes -->
  <rect x="37" y="84" width="22" height="44" rx="4" fill="#90a4ae"/>
  <!-- Transformation arrow -->
  <path d="M86 84 L114 84" stroke="#e91e63" stroke-width="4" stroke-linecap="round"/>
  <polygon points="112,77 124,84 112,91" fill="#e91e63"/>
  <!-- sparkles around arrow -->
  <path d="M100 64 l1.6 4 4 1.6 -4 1.6 -1.6 4 -1.6 -4 -4 -1.6 4 -1.6 Z" fill="#ffd54f"/>
  <path d="M108 102 l1.2 3 3 1.2 -3 1.2 -1.2 3 -1.2 -3 -3 -1.2 3 -1.2 Z" fill="#ffd54f"/>
  <!-- AFTER panel (right) -->
  <rect x="118" y="28" width="68" height="110" rx="6" fill="#fff" opacity="0.55"/>
  <!-- short stylish dyed hair -->
  <path d="M139 62 Q152 46 165 62 Q167 70 162 72 L142 72 Q137 70 139 62 Z" fill="#ff7043"/>
  <circle cx="152" cy="68" r="13" fill="#ffe0b2"/>
  <path d="M140 63 Q152 52 164 63 Q160 66 152 65 Q144 66 140 63 Z" fill="#ff7043"/>
  <!-- confident eyes -->
  <circle cx="147" cy="68" r="1.6" fill="#5d4037"/>
  <circle cx="157" cy="68" r="1.6" fill="#5d4037"/>
  <path d="M147 75 Q152 79 157 75" fill="none" stroke="#5d4037" stroke-width="1.1" stroke-linecap="round"/>
  <!-- stylish clothes -->
  <rect x="141" y="84" width="22" height="44" rx="4" fill="#ec407a"/>
  <polygon points="147,84 152,96 157,84" fill="#fff"/>
  <line x1="152" y1="96" x2="152" y2="128" stroke="#fff" stroke-width="0.8" opacity="0.7"/>
  <!-- after sparkle -->
  <path d="M170 50 l1.4 3.6 3.6 1.4 -3.6 1.4 -1.4 3.6 -1.4 -3.6 -3.6 -1.4 3.6 -1.4 Z" fill="#ffd54f"/>
</svg>
