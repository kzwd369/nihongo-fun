<!-- English priority seat = a sign with pictograms (elderly, pregnant, wheelchair, parent-with-baby). Picture only, no text. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="ssenBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e3f2fd"/>
      <stop offset="100%" stop-color="#bbdefb"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#ssenBg)" rx="8"/>
  <!-- Train window strip -->
  <rect x="14" y="22" width="172" height="20" rx="4" fill="#90caf9" stroke="#1565c0" stroke-width="1"/>
  <line x1="100" y1="22" x2="100" y2="42" stroke="#1565c0" stroke-width="1"/>
  <!-- Large priority-seat sign panel -->
  <rect x="28" y="52" width="144" height="56" rx="4" fill="#fff" stroke="#1565c0" stroke-width="2"/>
  <rect x="28" y="52" width="144" height="56" rx="4" fill="#1565c0" opacity="0.06"/>
  <!-- Pictogram 1: elderly with cane -->
  <circle cx="54" cy="66" r="3.5" fill="#1565c0"/>
  <path d="M54 69 q-2 8 0 16" fill="none" stroke="#1565c0" stroke-width="2.4"/>
  <path d="M54 74 q5 2 7 8" fill="none" stroke="#1565c0" stroke-width="2.2"/>
  <line x1="61" y1="70" x2="61" y2="86" stroke="#1565c0" stroke-width="1.8"/>
  <!-- Pictogram 2: pregnant person -->
  <circle cx="88" cy="66" r="3.5" fill="#1565c0"/>
  <path d="M88 69 l0 16" fill="none" stroke="#1565c0" stroke-width="2.4"/>
  <path d="M88 72 q9 4 0 10" fill="#1565c0"/>
  <!-- Pictogram 3: wheelchair -->
  <circle cx="120" cy="64" r="3.2" fill="#1565c0"/>
  <path d="M120 67 l0 7 l8 0" fill="none" stroke="#1565c0" stroke-width="2.2"/>
  <circle cx="120" cy="80" r="6.5" fill="none" stroke="#1565c0" stroke-width="2"/>
  <circle cx="120" cy="80" r="1.5" fill="#1565c0"/>
  <line x1="120" y1="74" x2="129" y2="74" stroke="#1565c0" stroke-width="2"/>
  <!-- Pictogram 4: parent holding a baby -->
  <circle cx="150" cy="64" r="3.5" fill="#1565c0"/>
  <path d="M150 67 l0 16" fill="none" stroke="#1565c0" stroke-width="2.4"/>
  <circle cx="156" cy="74" r="2.4" fill="#1565c0"/>
  <path d="M150 72 q6 0 6 4" fill="none" stroke="#1565c0" stroke-width="2"/>
  <!-- The actual blue priority seat below the sign -->
  <rect x="46" y="116" width="108" height="12" rx="2" fill="#1565c0" stroke="#0d47a1" stroke-width="1.2"/>
  <rect x="46" y="108" width="108" height="10" rx="3" fill="#1976d2" stroke="#0d47a1" stroke-width="1.2"/>
  <line x1="100" y1="109" x2="100" y2="128" stroke="#0d47a1" stroke-width="0.8"/>
  <!-- Floor -->
  <rect x="0" y="128" width="200" height="32" fill="#90a4ae"/>
</svg>
