<!-- English "back mirror" is not used — correct: "rearview mirror" (inside) / "side mirror" or "wing mirror" (outside) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "back mirror?" crossed out -->
  <rect x="10" y="15" width="82" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="30,43 40,43 35,51" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="51" y="33" font-size="10" fill="#424242" text-anchor="middle">"back mirror"</text>
  <!-- Red X over phrase -->
  <line x1="15" y1="18" x2="87" y2="41" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="87" y1="18" x2="15" y2="41" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Confused English speaker -->
  <!-- Head -->
  <circle cx="40" cy="85" r="13" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M28,82 Q28,70 40,68 Q52,70 52,82 L49,78 Q40,74 31,78 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="35" cy="85" r="1.5" fill="#3e2723"/>
  <circle cx="45" cy="85" r="1.5" fill="#3e2723"/>
  <!-- Confused mouth -->
  <path d="M35,92 Q38,90 41,92 Q44,94 47,92" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="22" y="65" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="57" y="70" font-size="18" font-weight="bold" fill="#ff7043">?</text>
  <!-- Body -->
  <rect x="30" y="98" width="20" height="22" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms -->
  <line x1="30" y1="101" x2="18" y2="93" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="50" y1="101" x2="62" y2="93" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Correct: rearview mirror (trapezoid) -->
  <!-- Mirror body -->
  <polygon points="110,45 180,45 175,72 115,72" fill="#b3e5fc" stroke="#0288d1" stroke-width="1.5"/>
  <!-- Mirror stem -->
  <rect x="142" y="38" width="6" height="9" fill="#546e7a"/>
  <!-- Reflection lines -->
  <line x1="120" y1="52" x2="170" y2="52" stroke="white" stroke-width="1" opacity="0.7"/>
  <line x1="122" y1="60" x2="168" y2="60" stroke="white" stroke-width="1" opacity="0.5"/>
  <!-- Check mark on mirror -->
  <path d="M118,55 L123,60 L132,50" fill="none" stroke="#2e7d32" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Side mirror (small) -->
  <rect x="118" y="95" width="18" height="12" fill="#b3e5fc" stroke="#0288d1" stroke-width="1" rx="2"/>
  <rect x="134" y="98" width="4" height="6" fill="#546e7a"/>
  <text x="127" y="119" font-size="7" fill="#0277bd" text-anchor="middle">side mirror</text>
  <!-- "rearview mirror ✓" label -->
  <text x="145" y="85" font-size="10" font-weight="bold" fill="#2e7d32" text-anchor="middle">rearview mirror ✓</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
