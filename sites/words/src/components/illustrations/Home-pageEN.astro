<!-- English "home page" = ONLY the front/landing page. A browser frame with a single page bearing a home (house) icon. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="hpen-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#b3e5fc"/>
      <stop offset="100%" stop-color="#e1f5fe"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#hpen-bg)" rx="8"/>
  <!-- Single browser window: the home page only -->
  <rect x="34" y="30" width="132" height="100" rx="6" fill="#fff" stroke="#0277bd" stroke-width="2"/>
  <!-- Browser chrome -->
  <rect x="34" y="30" width="132" height="13" rx="6" fill="#4fc3f7"/>
  <circle cx="42" cy="36.5" r="1.6" fill="#fff"/>
  <circle cx="48" cy="36.5" r="1.6" fill="#fff"/>
  <circle cx="54" cy="36.5" r="1.6" fill="#fff"/>
  <rect x="62" y="33.5" width="98" height="6" rx="3" fill="#fff" opacity="0.85"/>
  <!-- home / house icon in address bar -->
  <polygon points="68,38 71,34.5 74,38" fill="#0277bd"/>
  <rect x="69" y="37" width="4" height="3" fill="#0277bd"/>
  <!-- Big home / house icon as the single page hero -->
  <polygon points="100,54 78,76 122,76" fill="#0288d1"/>
  <rect x="84" y="76" width="32" height="30" fill="#4fc3f7"/>
  <rect x="84" y="76" width="32" height="30" fill="none" stroke="#0277bd" stroke-width="1.5"/>
  <!-- door -->
  <rect x="95" y="90" width="10" height="16" rx="1" fill="#01579b"/>
  <circle cx="103" cy="98" r="0.9" fill="#ffd54f"/>
  <!-- window on house -->
  <rect x="88" y="82" width="6" height="6" fill="#e1f5fe" stroke="#0277bd" stroke-width="0.6"/>
  <rect x="106" y="82" width="6" height="6" fill="#e1f5fe" stroke="#0277bd" stroke-width="0.6"/>
  <!-- chimney -->
  <rect x="110" y="60" width="5" height="9" fill="#0277bd"/>
  <!-- nav bar of just this one page -->
  <rect x="42" y="114" width="22" height="6" rx="1" fill="#b3e5fc"/>
  <rect x="68" y="114" width="22" height="6" rx="1" fill="#b3e5fc"/>
  <rect x="94" y="114" width="22" height="6" rx="1" fill="#b3e5fc"/>
  <rect x="120" y="114" width="22" height="6" rx="1" fill="#b3e5fc"/>
</svg>
