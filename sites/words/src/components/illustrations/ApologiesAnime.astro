<!-- Apologies: a figure in deep dogeza (forehead on floor) with motion lines and a "sorry" speech cloud -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Background -->
  <rect width="200" height="160" rx="8" fill="#fff8e1"/>

  <!-- Floor line -->
  <line x1="15" y1="125" x2="185" y2="125" stroke="#ffd54f" stroke-width="1.5"/>

  <!-- Dogeza figure: back/body (arched forward) -->
  <path d="M70,120 Q85,80 115,95 Q130,105 135,120 Z" fill="#8d6e63"/>

  <!-- Head (forehead to ground) -->
  <circle cx="72" cy="118" r="11" fill="#ffab91"/>

  <!-- Arms extended forward on the ground -->
  <rect x="60" y="118" width="22" height="7" rx="3" fill="#ff8a65"/>

  <!-- Legs folded under -->
  <path d="M125,120 Q135,128 145,122" fill="none" stroke="#6d4c41" stroke-width="6" stroke-linecap="round"/>

  <!-- Motion / emphasis lines above head -->
  <line x1="72" y1="100" x2="72" y2="92" stroke="#ef6c00" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
  <line x1="58" y1="103" x2="52" y2="97" stroke="#ef6c00" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
  <line x1="86" y1="103" x2="92" y2="97" stroke="#ef6c00" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>

  <!-- Sweat drop -->
  <path d="M55,110 Q53,114 55,117 Q57,114 55,110Z" fill="#4fc3f7" opacity="0.8"/>

  <!-- Speech cloud with ごめん -->
  <ellipse cx="145" cy="55" rx="38" ry="22" fill="#fff" stroke="#ef6c00" stroke-width="1.5"/>
  <ellipse cx="125" cy="73" rx="5" ry="3" fill="#fff" stroke="#ef6c00" stroke-width="1.2"/>
  <ellipse cx="118" cy="82" rx="3" ry="2" fill="#fff" stroke="#ef6c00" stroke-width="1"/>
  <text x="145" y="60" text-anchor="middle" font-family="sans-serif" font-size="16" fill="#d84315" font-weight="bold">ごめん</text>

  <!-- Ground shadow under forehead -->
  <ellipse cx="72" cy="128" rx="10" ry="2" fill="#8d6e63" opacity="0.3"/>
</svg>
