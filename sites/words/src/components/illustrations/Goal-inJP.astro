<!-- Japanese ゴールイン = getting married (metaphor: crossing finish line together) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Cherry blossom petals scattered -->
  <circle cx="25" cy="20" r="2.5" fill="#f8bbd0"/>
  <circle cx="40" cy="35" r="2" fill="#f48fb1"/>
  <circle cx="170" cy="18" r="2.5" fill="#f8bbd0"/>
  <circle cx="185" cy="40" r="2" fill="#f48fb1"/>
  <circle cx="15" cy="60" r="2" fill="#f8bbd0"/>
  <circle cx="190" cy="70" r="2" fill="#f48fb1"/>
  <circle cx="30" cy="90" r="1.8" fill="#f8bbd0"/>
  <circle cx="180" cy="100" r="2" fill="#f8bbd0"/>
  <!-- Hearts floating -->
  <path d="M50,25 Q47,22 50,20 Q53,22 50,25 Z" fill="#e57373"/>
  <path d="M50,25 Q53,22 56,25 Q53,28 50,25 Z" fill="#e57373"/>
  <path d="M160,30 Q157,27 160,25 Q163,27 160,30 Z" fill="#e57373"/>
  <path d="M160,30 Q163,27 166,30 Q163,33 160,30 Z" fill="#e57373"/>
  <path d="M100,15 Q97,12 100,10 Q103,12 100,15 Z" fill="#ec407a"/>
  <path d="M100,15 Q103,12 106,15 Q103,18 100,15 Z" fill="#ec407a"/>
  <!-- Finish line poles -->
  <rect x="28" y="55" width="3" height="75" fill="#616161"/>
  <rect x="168" y="55" width="3" height="75" fill="#616161"/>
  <!-- Red goal tape being broken -->
  <path d="M31,95 Q75,100 90,98" stroke="#e53935" stroke-width="3" fill="none"/>
  <path d="M110,98 Q140,100 168,95" stroke="#e53935" stroke-width="3" fill="none"/>
  <!-- Tape fragments flying (broken effect) -->
  <path d="M90,98 Q95,92 92,88" stroke="#e53935" stroke-width="2" fill="none"/>
  <path d="M110,98 Q105,92 108,88" stroke="#e53935" stroke-width="2" fill="none"/>
  <!-- Groom (tuxedo) -->
  <!-- Head -->
  <circle cx="78" cy="75" r="11" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M68,73 Q67,62 78,60 Q89,62 88,73 L85,69 Q78,66 71,69 Z" fill="#3e2723"/>
  <!-- Happy eyes -->
  <path d="M72,75 Q74,72 76,75" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <path d="M80,75 Q82,72 84,75" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Smile -->
  <path d="M74,80 Q78,83 82,80" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Tuxedo body -->
  <rect x="67" y="86" width="22" height="28" fill="#212121" rx="3"/>
  <!-- White shirt -->
  <polygon points="78,86 73,100 83,100" fill="white"/>
  <!-- Bow tie -->
  <polygon points="75,88 78,91 81,88 81,93 78,91 75,93" fill="#e53935"/>
  <!-- Right arm holding hands -->
  <line x1="89" y1="92" x2="100" y2="98" stroke="#212121" stroke-width="5" stroke-linecap="round"/>
  <!-- Left arm -->
  <line x1="67" y1="92" x2="60" y2="102" stroke="#212121" stroke-width="5" stroke-linecap="round"/>
  <!-- Legs -->
  <rect x="70" y="114" width="7" height="16" fill="#212121"/>
  <rect x="80" y="114" width="7" height="16" fill="#212121"/>
  <!-- Bride (wedding dress) -->
  <!-- Head -->
  <circle cx="122" cy="75" r="11" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M111,75 Q110,62 122,59 Q134,62 133,76 Q130,70 125,68 Q118,68 114,72 Z" fill="#6d4c41"/>
  <!-- Veil -->
  <path d="M110,65 Q108,78 112,90 L122,70 Q116,60 110,65 Z" fill="white" opacity="0.7" stroke="#e0e0e0" stroke-width="0.5"/>
  <!-- Happy eyes -->
  <path d="M116,75 Q118,72 120,75" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <path d="M124,75 Q126,72 128,75" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Smile -->
  <path d="M118,80 Q122,83 126,80" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Lips -->
  <path d="M120,81 Q122,82 124,81" fill="#f48fb1"/>
  <!-- Wedding dress (triangular) -->
  <polygon points="122,86 108,130 136,130" fill="white" stroke="#e0e0e0" stroke-width="1"/>
  <!-- Dress details -->
  <path d="M114,110 Q122,108 130,110" fill="none" stroke="#e0e0e0" stroke-width="1"/>
  <path d="M112,120 Q122,118 132,120" fill="none" stroke="#e0e0e0" stroke-width="1"/>
  <!-- Neckline -->
  <path d="M117,86 Q122,89 127,86" fill="#ffe0b2"/>
  <!-- Left arm holding hands -->
  <line x1="112" y1="92" x2="100" y2="98" stroke="#ffe0b2" stroke-width="5" stroke-linecap="round"/>
  <!-- Right arm with bouquet -->
  <line x1="132" y1="92" x2="140" y2="100" stroke="#ffe0b2" stroke-width="5" stroke-linecap="round"/>
  <!-- Bouquet -->
  <circle cx="142" cy="101" r="5" fill="#f48fb1"/>
  <circle cx="139" cy="99" r="3" fill="#e57373"/>
  <circle cx="145" cy="99" r="3" fill="#fff59d"/>
  <circle cx="142" cy="104" r="3" fill="#ce93d8"/>
  <!-- Held hands heart -->
  <path d="M98,95 Q96,92 99,91 Q102,92 100,95 Z" fill="#e53935"/>
  <path d="M100,95 Q102,92 105,91 Q104,94 100,95 Z" fill="#e53935"/>
  <!-- Sparkles -->
  <text x="55" y="50" font-size="10" fill="#fbc02d">✦</text>
  <text x="145" y="55" font-size="10" fill="#fbc02d">✦</text>
  <text x="95" y="45" font-size="8" fill="#fbc02d">✦</text>
  <!-- Floor -->
  <rect x="0" y="130" width="200" height="30" fill="#c8e6c9" rx="0"/>
  <!-- Label -->
  <text x="100" y="150" font-size="12" font-weight="bold" fill="#2e7d32" text-anchor="middle">ゴールイン！</text>
</svg>
