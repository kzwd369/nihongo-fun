<!-- Modern slang: smartphone with chat bubbles containing casual Japanese slang -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Background -->
  <rect width="200" height="160" rx="8" fill="#e0f7fa"/>

  <!-- Smartphone body -->
  <rect x="70" y="25" width="60" height="110" rx="10" fill="#263238" stroke="#000" stroke-width="1.5"/>
  <!-- Screen -->
  <rect x="74" y="35" width="52" height="90" rx="2" fill="#eceff1"/>
  <!-- Top notch / camera -->
  <circle cx="100" cy="31" r="1.5" fill="#455a64"/>
  <!-- Home button -->
  <circle cx="100" cy="130" r="3" fill="#455a64"/>

  <!-- Chat bubble 1 (left-aligned, other person) -->
  <rect x="77" y="42" width="36" height="14" rx="7" fill="#b2ebf2"/>
  <text x="95" y="52" text-anchor="middle" font-family="sans-serif" font-size="8" fill="#006064" font-weight="bold">ヤバい</text>

  <!-- Chat bubble 2 (right-aligned, user) -->
  <rect x="87" y="60" width="36" height="14" rx="7" fill="#80deea"/>
  <text x="105" y="70" text-anchor="middle" font-family="sans-serif" font-size="8" fill="#004d40" font-weight="bold">マジで</text>

  <!-- Chat bubble 3 -->
  <rect x="77" y="78" width="40" height="14" rx="7" fill="#b2ebf2"/>
  <text x="97" y="88" text-anchor="middle" font-family="sans-serif" font-size="8" fill="#006064" font-weight="bold">草www</text>

  <!-- Chat bubble 4 -->
  <rect x="87" y="96" width="36" height="14" rx="7" fill="#80deea"/>
  <text x="105" y="106" text-anchor="middle" font-family="sans-serif" font-size="8" fill="#004d40" font-weight="bold">それな</text>

  <!-- Typing indicator dots -->
  <circle cx="84" cy="117" r="1.5" fill="#b0bec5"/>
  <circle cx="90" cy="117" r="1.5" fill="#b0bec5"/>
  <circle cx="96" cy="117" r="1.5" fill="#b0bec5"/>

  <!-- Decorative: heart emoji floating -->
  <path d="M40,60 C40,60 37,57 34,58 C31,59 31,63 34,65 L40,70 L46,65 C49,63 49,59 46,58 C43,57 40,60 40,60Z" fill="#ff4081" opacity="0.75"/>

  <!-- Decorative: star emoji -->
  <path d="M160,45 L162,50 L168,50 L163,53 L165,59 L160,55 L155,59 L157,53 L152,50 L158,50 Z" fill="#ffc107" opacity="0.8"/>

  <!-- Laughing face emoji (simple) -->
  <circle cx="45" cy="110" r="9" fill="#fff176"/>
  <path d="M41,108 Q43,106 45,108 M49,108 Q51,106 53,108" fill="none" stroke="#5d4037" stroke-width="1.2" stroke-linecap="round"/>
  <path d="M41,114 Q45,118 49,114" fill="none" stroke="#5d4037" stroke-width="1.5" stroke-linecap="round"/>

  <!-- Small sparkle -->
  <path d="M155,100 L157,96 L159,100 L157,104Z" fill="#00bcd4" opacity="0.6"/>
  <path d="M150,120 L152,117 L154,120 L152,123Z" fill="#00bcd4" opacity="0.5"/>
</svg>
