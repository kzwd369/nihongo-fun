<!-- Senpai-kouhai: a taller senior student stands upright while a junior student bows deeply in respect, both in school uniforms -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="senpaiBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#e3f2fd"/>
      <stop offset="100%" stop-color="#e8f5e9"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" rx="8" fill="url(#senpaiBg)"/>

  <!-- Floor line -->
  <line x1="14" y1="146" x2="186" y2="146" stroke="#a5d6a7" stroke-width="1.5" opacity="0.7"/>

  <!-- ===== SENPAI (left, taller, standing upright) ===== -->
  <!-- Legs / slacks -->
  <rect x="48" y="116" width="9" height="30" fill="#37474f"/>
  <rect x="60" y="116" width="9" height="30" fill="#37474f"/>
  <!-- Shoes -->
  <ellipse cx="52" cy="147" rx="6" ry="2.5" fill="#212121"/>
  <ellipse cx="64" cy="147" rx="6" ry="2.5" fill="#212121"/>
  <!-- Torso: gakuran jacket -->
  <path d="M44,118 L44,82 Q46,72 58,70 L60,70 Q72,72 74,82 L74,118 Z" fill="#1a237e" stroke="#0d113d" stroke-width="1.2"/>
  <line x1="59" y1="74" x2="59" y2="118" stroke="#0d113d" stroke-width="1.2"/>
  <path d="M51,71 L59,79 L67,71" fill="#283593" stroke="#0d113d" stroke-width="0.8"/>
  <circle cx="59" cy="88" r="1.3" fill="#ffd54f"/>
  <circle cx="59" cy="98" r="1.3" fill="#ffd54f"/>
  <circle cx="59" cy="108" r="1.3" fill="#ffd54f"/>
  <!-- Arms relaxed at sides -->
  <path d="M44,84 Q38,98 40,116" fill="none" stroke="#1a237e" stroke-width="7" stroke-linecap="round"/>
  <path d="M74,84 Q80,98 78,116" fill="none" stroke="#1a237e" stroke-width="7" stroke-linecap="round"/>
  <circle cx="40" cy="118" r="3.5" fill="#ffe0b2"/>
  <circle cx="78" cy="118" r="3.5" fill="#ffe0b2"/>
  <!-- Neck -->
  <rect x="55" y="62" width="8" height="9" fill="#ffe0b2"/>
  <!-- Head -->
  <circle cx="59" cy="50" r="16" fill="#ffe0b2"/>
  <!-- Hair (neat) -->
  <path d="M43,50 Q41,30 59,30 Q77,30 75,50 Q72,40 59,38 Q46,40 43,50 Z" fill="#4e342e"/>
  <!-- Confident eyes -->
  <ellipse cx="53" cy="50" rx="2.4" ry="3" fill="#fff"/>
  <ellipse cx="65" cy="50" rx="2.4" ry="3" fill="#fff"/>
  <circle cx="53" cy="50" r="1.4" fill="#3e2723"/>
  <circle cx="65" cy="50" r="1.4" fill="#3e2723"/>
  <!-- Calm smile -->
  <path d="M54,58 Q59,61 64,58" fill="none" stroke="#8d4e00" stroke-width="1.3" stroke-linecap="round"/>

  <!-- Upward chevrons over senpai = senior / higher rank -->
  <path d="M50,20 L59,12 L68,20" fill="none" stroke="#42a5f5" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
  <path d="M53,26 L59,21 L65,26" fill="none" stroke="#90caf9" stroke-width="1.6" stroke-linecap="round" opacity="0.6"/>

  <!-- ===== KOUHAI (right, shorter, bowing deeply) ===== -->
  <!-- Legs (standing, slightly bent) -->
  <rect x="132" y="120" width="8" height="26" fill="#5d4037"/>
  <rect x="143" y="120" width="8" height="26" fill="#5d4037"/>
  <ellipse cx="136" cy="147" rx="5.5" ry="2.3" fill="#212121"/>
  <ellipse cx="147" cy="147" rx="5.5" ry="2.3" fill="#212121"/>

  <!-- Bowed torso: bent forward ~45deg, sailor uniform -->
  <path d="M128,122 L120,96 Q120,88 130,84 L150,90 Q158,94 156,102 L150,122 Z" fill="#fff" stroke="#90a4ae" stroke-width="1.2"/>
  <!-- Sailor collar (navy) flopping forward over the bow -->
  <path d="M120,96 Q130,86 150,90 L146,100 Q132,94 124,102 Z" fill="#283593"/>
  <path d="M132,90 L137,100 L130,99 Z" fill="#e53935"/>
  <!-- Arms hanging straight down as the body bows -->
  <path d="M124,100 Q120,114 122,128" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"/>
  <path d="M124,100 Q120,114 122,128" fill="none" stroke="#90a4ae" stroke-width="0.6" stroke-linecap="round"/>
  <path d="M150,104 Q150,118 150,130" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"/>
  <circle cx="122" cy="130" r="3.2" fill="#ffe0b2"/>
  <circle cx="150" cy="131" r="3.2" fill="#ffe0b2"/>

  <!-- Head lowered (bowing) — positioned low and forward -->
  <circle cx="124" cy="78" r="14" fill="#ffe0b2"/>
  <!-- Hair tipping down -->
  <path d="M110,80 Q108,62 124,62 Q140,62 138,80 Q134,70 124,76 Q116,70 110,80 Z" fill="#3e2723"/>
  <!-- Face angled down: eyes shut, respectful -->
  <path d="M116,82 Q119,84 122,82" fill="none" stroke="#5d4037" stroke-width="1.3" stroke-linecap="round"/>
  <path d="M126,82 Q129,84 132,82" fill="none" stroke="#5d4037" stroke-width="1.3" stroke-linecap="round"/>
  <!-- small earnest mouth -->
  <path d="M121,87 Q124,89 127,87" fill="none" stroke="#bf6a4a" stroke-width="1.1" stroke-linecap="round"/>
  <!-- Nervous sweat drop -->
  <path d="M137,74 Q140,80 137,82 Q134,80 137,74 Z" fill="#4fc3f7" opacity="0.8"/>

  <!-- Motion lines showing the bow direction -->
  <path d="M150,70 Q140,68 134,72 M154,78 Q146,76 140,79" fill="none" stroke="#bdbdbd" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
</svg>
