<!-- Japanese ドクターストップ = a doctor's order to stop (work, alcohol, smoking, exercise, etc.) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Doctor on left -->
  <!-- Head -->
  <circle cx="50" cy="55" r="13" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M38,53 Q37,40 50,38 Q63,40 62,53 L59,49 Q50,45 41,49 Z" fill="#3e2723"/>
  <!-- Eyes (stern) -->
  <path d="M43,56 Q45,53 47,56" fill="none" stroke="#3e2723" stroke-width="1.4" stroke-linecap="round"/>
  <path d="M53,56 Q55,53 57,56" fill="none" stroke="#3e2723" stroke-width="1.4" stroke-linecap="round"/>
  <!-- Eyebrows (furrowed) -->
  <line x1="42" y1="50" x2="48" y2="51" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <line x1="52" y1="51" x2="58" y2="50" stroke="#3e2723" stroke-width="1.3" stroke-linecap="round"/>
  <!-- Mouth (firm) -->
  <line x1="46" y1="62" x2="54" y2="62" stroke="#3e2723" stroke-width="1.4" stroke-linecap="round"/>
  <!-- White coat body -->
  <rect x="35" y="68" width="30" height="34" fill="white" stroke="#cfd8dc" stroke-width="1" rx="3"/>
  <!-- Collar V -->
  <polygon points="50,68 44,80 56,80" fill="#eceff1"/>
  <!-- Stethoscope around neck -->
  <path d="M44,80 Q40,90 45,96" fill="none" stroke="#37474f" stroke-width="1.3"/>
  <path d="M56,80 Q60,90 55,96" fill="none" stroke="#37474f" stroke-width="1.3"/>
  <circle cx="50" cy="98" r="2.5" fill="#37474f"/>
  <!-- Left arm at side -->
  <line x1="35" y1="74" x2="30" y2="92" stroke="white" stroke-width="5" stroke-linecap="round"/>
  <!-- Right arm raised, index finger pointing up "ダメ！" -->
  <line x1="65" y1="74" x2="82" y2="52" stroke="white" stroke-width="5" stroke-linecap="round"/>
  <!-- Hand -->
  <circle cx="84" cy="48" r="5" fill="#ffcc80"/>
  <!-- Index finger raised -->
  <rect x="82" y="36" width="4" height="12" fill="#ffcc80" rx="1.5"/>
  <!-- Legs -->
  <rect x="39" y="102" width="8" height="22" fill="#455a64"/>
  <rect x="53" y="102" width="8" height="22" fill="#455a64"/>
  <!-- ダメ！ speech mark -->
  <path d="M90,32 L108,32 L108,46 L104,46 L100,52 L100,46 L90,46 Z" fill="#fff59d" stroke="#f9a825" stroke-width="1"/>
  <text x="99" y="42" font-size="9" font-weight="bold" fill="#e53935" text-anchor="middle">ダメ！</text>
  <!-- Items being stopped with red X -->
  <!-- Beer mug (alcohol) -->
  <rect x="120" y="40" width="16" height="22" fill="#ffcc80" stroke="#8d6e63" stroke-width="1" rx="1"/>
  <rect x="120" y="40" width="16" height="6" fill="#fff9c4"/>
  <path d="M136,45 Q142,45 142,52 Q142,58 136,58" fill="none" stroke="#8d6e63" stroke-width="1.5"/>
  <circle cx="128" cy="35" r="28" fill="none" stroke="#e53935" stroke-width="2.5"/>
  <line x1="110" y1="20" x2="148" y2="55" stroke="#e53935" stroke-width="2.5"/>
  <!-- Cigarette (smoking) -->
  <rect x="155" y="75" width="22" height="5" fill="white" stroke="#9e9e9e" stroke-width="0.8"/>
  <rect x="172" y="75" width="5" height="5" fill="#ef6c00"/>
  <path d="M178,75 Q181,70 178,65 Q176,62 179,58" fill="none" stroke="#b0bec5" stroke-width="1.2"/>
  <circle cx="165" cy="77" r="16" fill="none" stroke="#e53935" stroke-width="2.5"/>
  <line x1="153" y1="65" x2="178" y2="90" stroke="#e53935" stroke-width="2.5"/>
  <!-- Laptop (overtime work) -->
  <rect x="118" y="95" width="24" height="16" fill="#607d8b" rx="1"/>
  <rect x="120" y="97" width="20" height="12" fill="#90caf9"/>
  <rect x="115" y="111" width="30" height="2" fill="#455a64"/>
  <circle cx="130" cy="103" r="14" fill="none" stroke="#e53935" stroke-width="2.5"/>
  <line x1="120" y1="93" x2="140" y2="113" stroke="#e53935" stroke-width="2.5"/>
  <!-- Floor -->
  <rect x="0" y="128" width="200" height="32" fill="#c8e6c9" rx="0"/>
  <!-- Label -->
  <text x="100" y="148" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">ドクターストップ</text>
</svg>
