    <linearGradient id="icen-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ce93d8"/>
      <stop offset="100%" stop-color="#f3e5f5"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#icen-bg)" rx="8"/>
  <!-- Salon mirror (left) -->
  <rect x="26" y="32" width="62" height="96" rx="4" fill="#e1f5fe" stroke="#7b1fa2" stroke-width="2.5"/>
  <line x1="34" y1="42" x2="46" y2="42" stroke="#fff" stroke-width="3" opacity="0.7"/>
  <line x1="34" y1="50" x2="42" y2="50" stroke="#fff" stroke-width="2" opacity="0.6"/>
  <!-- reflection of the new stylish look -->
  <path d="M44 70 Q57 54 70 70 Q72 78 67 80 L47 80 Q42 78 44 70 Z" fill="#6d4c41"/>
  <circle cx="57" cy="76" r="13" fill="#ffe0b2"/>
  <circle cx="52" cy="76" r="1.5" fill="#5d4037"/>
  <circle cx="62" cy="76" r="1.5" fill="#5d4037"/>
  <path d="M52 82 Q57 86 62 82" fill="none" stroke="#5d4037" stroke-width="1" stroke-linecap="round"/>
  <rect x="46" y="92" width="22" height="34" rx="3" fill="#ab47bc"/>
  <!-- Person in salon chair (right) -->
  <circle cx="140" cy="74" r="14" fill="#ffe0b2"/>
  <path d="M126 70 Q140 52 154 70 Q156 78 151 80 L129 80 Q124 78 126 70 Z" fill="#6d4c41"/>
  <circle cx="135" cy="74" r="1.5" fill="#5d4037"/>
  <circle cx="145" cy="74" r="1.5" fill="#5d4037"/>
  <!-- salon cape -->
  <path d="M122 88 Q140 82 158 88 L162 128 L118 128 Z" fill="#9575cd"/>
  <!-- chair back -->
  <rect x="116" y="92" width="6" height="40" rx="2" fill="#5e35b1"/>
  <!-- comb -->
  <rect x="100" y="56" width="14" height="4" rx="1" fill="#616161" transform="rotate(-20 107 58)"/>
  <line x1="98" y1="62" x2="98" y2="66" stroke="#616161" stroke-width="0.8"/>
  <line x1="101" y1="61" x2="101" y2="65" stroke="#616161" stroke-width="0.8"/>
  <line x1="104" y1="60" x2="104" y2="64" stroke="#616161" stroke-width="0.8"/>
  <line x1="107" y1="59" x2="107" y2="63" stroke="#616161" stroke-width="0.8"/>
  <!-- scissors -->
  <line x1="172" y1="58" x2="160" y2="70" stroke="#616161" stroke-width="2"/>
  <line x1="172" y1="72" x2="160" y2="60" stroke="#616161" stroke-width="2"/>
  <circle cx="174" cy="56" r="2.4" fill="none" stroke="#616161" stroke-width="1.4"/>
  <circle cx="174" cy="74" r="2.4" fill="none" stroke="#616161" stroke-width="1.4"/>
  <!-- sparkles -->
  <path d="M150 50 l1.4 3.6 3.6 1.4 -3.6 1.4 -1.4 3.6 -1.4 -3.6 -3.6 -1.4 3.6 -1.4 Z" fill="#ffd54f"/>
  <path d="M102 92 l1.2 3 3 1.2 -3 1.2 -1.2 3 -1.2 -3 -3 -1.2 3 -1.2 Z" fill="#ffd54f"/>
</svg>
