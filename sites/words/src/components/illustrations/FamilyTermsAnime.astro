<!-- Family terms: four figures of decreasing height (dad, mom, older sibling, younger sibling) holding hands -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Background -->
  <rect width="200" height="160" rx="8" fill="#fff3e0"/>

  <!-- Ground line -->
  <line x1="15" y1="135" x2="185" y2="135" stroke="#ffcc80" stroke-width="1.5"/>

  <!-- Dad (tallest, left) -->
  <circle cx="40" cy="50" r="11" fill="#ffb74d"/>
  <!-- Hair tuft -->
  <path d="M31,46 Q40,38 49,46" fill="#6d4c41"/>
  <!-- Body -->
  <path d="M30,62 L50,62 L52,110 L28,110 Z" fill="#5c6bc0"/>
  <!-- Legs -->
  <rect x="32" y="110" width="7" height="25" fill="#37474f"/>
  <rect x="41" y="110" width="7" height="25" fill="#37474f"/>
  <!-- Arm reaching right -->
  <line x1="50" y1="75" x2="70" y2="85" stroke="#ffb74d" stroke-width="5" stroke-linecap="round"/>

  <!-- Mom (second, slightly shorter) -->
  <circle cx="80" cy="56" r="10" fill="#ffb74d"/>
  <!-- Long hair -->
  <path d="M70,55 Q68,70 72,78 M90,55 Q92,70 88,78" stroke="#5d4037" stroke-width="3" fill="none" stroke-linecap="round"/>
  <path d="M71,48 Q80,40 89,48 Q88,54 80,54 Q72,54 71,48" fill="#5d4037"/>
  <!-- Body (dress) -->
  <path d="M72,67 L88,67 L93,112 L67,112 Z" fill="#ec407a"/>
  <!-- Legs -->
  <line x1="76" y1="112" x2="75" y2="135" stroke="#ffb74d" stroke-width="5" stroke-linecap="round"/>
  <line x1="84" y1="112" x2="85" y2="135" stroke="#ffb74d" stroke-width="5" stroke-linecap="round"/>
  <!-- Arms holding hands -->
  <line x1="70" y1="78" x2="55" y2="82" stroke="#ffb74d" stroke-width="4" stroke-linecap="round"/>
  <line x1="90" y1="78" x2="108" y2="90" stroke="#ffb74d" stroke-width="4" stroke-linecap="round"/>

  <!-- Onii-chan (older sibling, third) -->
  <circle cx="120" cy="68" r="9" fill="#ffb74d"/>
  <path d="M112,64 Q120,58 128,64" fill="#4e342e"/>
  <!-- Body -->
  <path d="M113,78 L127,78 L130,118 L110,118 Z" fill="#26a69a"/>
  <!-- Legs -->
  <line x1="116" y1="118" x2="116" y2="135" stroke="#8d6e63" stroke-width="4" stroke-linecap="round"/>
  <line x1="124" y1="118" x2="124" y2="135" stroke="#8d6e63" stroke-width="4" stroke-linecap="round"/>
  <!-- Arms -->
  <line x1="111" y1="88" x2="100" y2="92" stroke="#ffb74d" stroke-width="3.5" stroke-linecap="round"/>
  <line x1="129" y1="88" x2="142" y2="100" stroke="#ffb74d" stroke-width="3.5" stroke-linecap="round"/>

  <!-- Imouto (youngest, smallest, right) with twin tails -->
  <circle cx="155" cy="85" r="8" fill="#ffb74d"/>
  <!-- Twin tails -->
  <ellipse cx="146" cy="86" rx="4" ry="8" fill="#8d6e63"/>
  <ellipse cx="164" cy="86" rx="4" ry="8" fill="#8d6e63"/>
  <!-- Body (dress) -->
  <path d="M148,93 L162,93 L166,122 L144,122 Z" fill="#ff80ab"/>
  <!-- Legs -->
  <line x1="151" y1="122" x2="151" y2="135" stroke="#ffb74d" stroke-width="3.5" stroke-linecap="round"/>
  <line x1="159" y1="122" x2="159" y2="135" stroke="#ffb74d" stroke-width="3.5" stroke-linecap="round"/>
  <!-- Arms -->
  <line x1="146" y1="102" x2="138" y2="102" stroke="#ffb74d" stroke-width="3" stroke-linecap="round"/>
  <line x1="164" y1="102" x2="172" y2="98" stroke="#ffb74d" stroke-width="3" stroke-linecap="round"/>

  <!-- Heart floating above -->
  <path d="M100,25 C100,25 96,20 92,22 C88,24 88,30 92,33 L100,40 L108,33 C112,30 112,24 108,22 C104,20 100,25 100,25Z" fill="#e91e63" opacity="0.7"/>
</svg>
