<!-- English "shutter chance" is not a natural compound — correct: "photo opportunity" / "photo op" -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "shutter chance?" crossed out -->
  <rect x="12" y="16" width="92" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="35,44 45,44 40,52" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="58" y="34" font-size="10" fill="#424242" text-anchor="middle">"shutter chance?"</text>
  <!-- Red X over phrase -->
  <line x1="17" y1="18" x2="99" y2="42" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="99" y1="18" x2="17" y2="42" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Confused English speaker -->
  <!-- Head -->
  <circle cx="40" cy="82" r="13" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M28,80 Q28,68 40,66 Q52,68 52,80 L49,76 Q40,72 31,76 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="35" cy="82" r="1.5" fill="#3e2723"/>
  <circle cx="45" cy="82" r="1.5" fill="#3e2723"/>
  <!-- Wavy mouth -->
  <path d="M35,89 Q38,87 41,89 Q44,91 47,89" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="22" y="62" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="56" y="66" font-size="17" font-weight="bold" fill="#ff7043">?</text>
  <!-- Body -->
  <rect x="30" y="95" width="20" height="22" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms -->
  <line x1="30" y1="98" x2="18" y2="90" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="50" y1="98" x2="62" y2="90" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Reporter with camera (correct: photo op) -->
  <!-- Camera body -->
  <rect x="118" y="70" width="55" height="34" fill="#37474f" rx="4"/>
  <!-- Top viewfinder bump -->
  <rect x="135" y="63" width="20" height="9" fill="#263238" rx="2"/>
  <!-- Lens -->
  <circle cx="145" cy="87" r="13" fill="#546e7a"/>
  <circle cx="145" cy="87" r="9" fill="#263238"/>
  <circle cx="145" cy="87" r="5" fill="#90a4ae"/>
  <circle cx="142" cy="84" r="2" fill="white" opacity="0.8"/>
  <!-- Flash on top-left of camera -->
  <rect x="120" y="66" width="8" height="6" fill="#fff59d" stroke="#fbc02d" stroke-width="1" rx="1"/>
  <!-- Flash burst -->
  <g stroke="#fdd835" stroke-width="2" stroke-linecap="round">
    <line x1="124" y1="60" x2="124" y2="52"/>
    <line x1="116" y1="64" x2="110" y2="60"/>
    <line x1="132" y1="64" x2="138" y2="60"/>
  </g>
  <text x="108" y="54" font-size="12" fill="#fbc02d" font-weight="bold">☆</text>
  <!-- Shutter button -->
  <circle cx="164" cy="68" r="2.5" fill="#e53935"/>
  <!-- "photo op" label -->
  <text x="145" y="122" font-size="10" font-weight="bold" fill="#2e7d32" text-anchor="middle">photo op ✓</text>
  <text x="145" y="134" font-size="8" fill="#2e7d32" text-anchor="middle">(photo opportunity)</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
