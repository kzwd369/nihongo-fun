<!-- Cozy sun shining warm rays over a sleepy cat — ポカポカ (pleasant warmth) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="url(#pokaSky)" rx="8"/>
  <!-- Warm glow filling the scene -->
  <circle cx="150" cy="45" r="70" fill="#ffe082" opacity="0.35"/>
  <!-- Sun rays -->
  <line x1="150" y1="45" x2="150" y2="8" stroke="#ffca28" stroke-width="3" stroke-linecap="round" opacity="0.7"/>
  <line x1="150" y1="45" x2="186" y2="20" stroke="#ffca28" stroke-width="3" stroke-linecap="round" opacity="0.7"/>
  <line x1="150" y1="45" x2="196" y2="55" stroke="#ffca28" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
  <line x1="150" y1="45" x2="112" y2="18" stroke="#ffca28" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
  <line x1="150" y1="45" x2="100" y2="55" stroke="#ffca28" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
  <line x1="150" y1="45" x2="120" y2="85" stroke="#ffca28" stroke-width="2.5" stroke-linecap="round" opacity="0.45"/>
  <!-- Sun body -->
  <circle cx="150" cy="45" r="26" fill="#ffd54f"/>
  <circle cx="150" cy="45" r="26" fill="url(#pokaSun)"/>
  <!-- Sun gentle face -->
  <path d="M141,42 Q144,38 147,42" fill="none" stroke="#ef9a9a" stroke-width="2" stroke-linecap="round"/>
  <path d="M153,42 Q156,38 159,42" fill="none" stroke="#ef9a9a" stroke-width="2" stroke-linecap="round"/>
  <path d="M143,50 Q150,57 157,50" fill="none" stroke="#ef9a9a" stroke-width="2" stroke-linecap="round"/>
  <ellipse cx="138" cy="49" rx="5" ry="3" fill="#ffab91" opacity="0.5"/>
  <ellipse cx="162" cy="49" rx="5" ry="3" fill="#ffab91" opacity="0.5"/>
  <!-- Warm floor / ground -->
  <rect x="0" y="120" width="200" height="40" fill="#ffe0b2" rx="0"/>
  <!-- Sleeping cat curled up in the warmth -->
  <ellipse cx="70" cy="125" rx="42" ry="22" fill="#ffb74d"/>
  <ellipse cx="70" cy="125" rx="42" ry="22" fill="url(#pokaCat)"/>
  <!-- Cat ears -->
  <polygon points="40,108 38,94 52,104" fill="#ffb74d"/>
  <polygon points="62,103 64,90 76,102" fill="#ffb74d"/>
  <!-- Cat head tucked -->
  <circle cx="50" cy="116" r="16" fill="#ffcc80"/>
  <!-- Closed sleepy eyes -->
  <path d="M40,114 Q44,118 48,114" fill="none" stroke="#8d6e63" stroke-width="1.8" stroke-linecap="round"/>
  <path d="M52,114 Q56,118 60,114" fill="none" stroke="#8d6e63" stroke-width="1.8" stroke-linecap="round"/>
  <!-- Cat nose -->
  <path d="M48,120 L52,120 L50,123 Z" fill="#ef9a9a"/>
  <!-- Cat tail curled around -->
  <path d="M108,128 Q124,124 118,108" fill="none" stroke="#ffb74d" stroke-width="9" stroke-linecap="round"/>
  <!-- Rosy cheek on cat -->
  <ellipse cx="42" cy="122" rx="4" ry="3" fill="#ffab91" opacity="0.5"/>
  <!-- Sleepy "z" warmth marks -->
  <text x="86" y="92" font-family="sans-serif" font-size="13" fill="#ff8a65" opacity="0.6">z</text>
  <text x="96" y="82" font-family="sans-serif" font-size="9" fill="#ff8a65" opacity="0.5">z</text>
  <!-- Floating warm air shimmer -->
  <path d="M30 70 Q34 64 38 70 Q42 76 46 70" fill="none" stroke="#ffb74d" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
  <path d="M105 105 Q109 99 113 105 Q117 111 121 105" fill="none" stroke="#ffb74d" stroke-width="1.5" stroke-linecap="round" opacity="0.35"/>
  <defs>
    <linearGradient id="pokaSky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff3e0"/>
      <stop offset="100%" stop-color="#ffe0b2"/>
    </linearGradient>
    <radialGradient id="pokaSun" cx="40%" cy="35%" r="70%">
      <stop offset="0%" stop-color="white" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#ffb300" stop-opacity="0.1"/>
    </radialGradient>
    <linearGradient id="pokaCat" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="white" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="black" stop-opacity="0.05"/>
    </linearGradient>
  </defs>
</svg>
