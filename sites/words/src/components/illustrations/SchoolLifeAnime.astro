<!-- School life: a Japanese school building with cherry blossoms and a sakura petal breeze -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Background (sky) -->
  <rect width="200" height="160" rx="8" fill="#e3f2fd"/>

  <!-- Ground -->
  <rect x="0" y="130" width="200" height="30" fill="#c8e6c9"/>

  <!-- School building: main block -->
  <rect x="55" y="70" width="90" height="60" fill="#f5f5f5" stroke="#90a4ae" stroke-width="1.5"/>
  <!-- Roof -->
  <polygon points="50,70 100,55 150,70" fill="#78909c" stroke="#546e7a" stroke-width="1.5"/>
  <!-- Clock tower / central top -->
  <rect x="92" y="40" width="16" height="20" fill="#cfd8dc" stroke="#546e7a" stroke-width="1.2"/>
  <polygon points="88,40 100,30 112,40" fill="#546e7a"/>
  <!-- Clock face -->
  <circle cx="100" cy="50" r="4" fill="#fff" stroke="#546e7a" stroke-width="0.8"/>
  <line x1="100" y1="50" x2="100" y2="47.5" stroke="#546e7a" stroke-width="0.8"/>
  <line x1="100" y1="50" x2="102" y2="50" stroke="#546e7a" stroke-width="0.8"/>

  <!-- Windows (rows) -->
  <rect x="62" y="78" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>
  <rect x="76" y="78" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>
  <rect x="114" y="78" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>
  <rect x="128" y="78" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>

  <rect x="62" y="94" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>
  <rect x="76" y="94" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>
  <rect x="114" y="94" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>
  <rect x="128" y="94" width="10" height="10" fill="#81d4fa" stroke="#0277bd" stroke-width="0.8"/>

  <!-- Entrance -->
  <rect x="93" y="108" width="14" height="22" fill="#8d6e63" stroke="#4e342e" stroke-width="1"/>

  <!-- Cherry tree trunk (left) -->
  <rect x="22" y="100" width="6" height="30" fill="#6d4c41"/>
  <!-- Cherry blossom cloud (left) -->
  <circle cx="25" cy="95" r="12" fill="#f8bbd0"/>
  <circle cx="18" cy="102" r="9" fill="#f48fb1"/>
  <circle cx="32" cy="102" r="9" fill="#f8bbd0"/>
  <circle cx="25" cy="108" r="7" fill="#f48fb1"/>

  <!-- Cherry tree trunk (right) -->
  <rect x="172" y="100" width="6" height="30" fill="#6d4c41"/>
  <circle cx="175" cy="95" r="12" fill="#f8bbd0"/>
  <circle cx="168" cy="102" r="9" fill="#f48fb1"/>
  <circle cx="182" cy="102" r="9" fill="#f8bbd0"/>

  <!-- Floating petals -->
  <ellipse cx="45" cy="45" rx="3" ry="1.5" fill="#f48fb1" transform="rotate(30 45 45)"/>
  <ellipse cx="65" cy="30" rx="3" ry="1.5" fill="#f8bbd0" transform="rotate(-20 65 30)"/>
  <ellipse cx="155" cy="40" rx="3" ry="1.5" fill="#f48fb1" transform="rotate(40 155 40)"/>
  <ellipse cx="130" cy="25" rx="3" ry="1.5" fill="#f8bbd0" transform="rotate(-35 130 25)"/>
  <ellipse cx="50" cy="115" rx="2.5" ry="1.2" fill="#f48fb1" transform="rotate(-25 50 115)" opacity="0.7"/>
  <ellipse cx="160" cy="120" rx="2.5" ry="1.2" fill="#f48fb1" transform="rotate(15 160 120)" opacity="0.7"/>
</svg>
