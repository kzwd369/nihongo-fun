<!-- Open mouth eating heartily — ぱくぱく (munching) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff8e1" rx="8"/>
  <!-- Round face -->
  <circle cx="100" cy="80" r="52" fill="#ffe0b2"/>
  <circle cx="100" cy="80" r="52" fill="none" stroke="#ffb74d" stroke-width="2"/>
  <!-- Eyes (happy closed) -->
  <path d="M74 64 C78 60 86 60 90 64" fill="none" stroke="#5d4037" stroke-width="3" stroke-linecap="round"/>
  <path d="M110 64 C114 60 122 60 126 64" fill="none" stroke="#5d4037" stroke-width="3" stroke-linecap="round"/>
  <!-- Big open mouth -->
  <ellipse cx="100" cy="100" rx="22" ry="18" fill="#c62828"/>
  <ellipse cx="100" cy="108" rx="14" ry="9" fill="#ef9a9a"/>
  <!-- Cheeks -->
  <circle cx="66" cy="92" r="7" fill="#ffab91" opacity="0.6"/>
  <circle cx="134" cy="92" r="7" fill="#ffab91" opacity="0.6"/>
  <!-- Food bits going in -->
  <circle cx="150" cy="60" r="8" fill="#8d6e63"/>
  <circle cx="166" cy="44" r="6" fill="#a1887f"/>
  <rect x="40" y="40" width="14" height="14" rx="3" fill="#aed581" transform="rotate(-20 47 47)"/>
  <!-- Motion marks -->
  <line x1="100" y1="14" x2="100" y2="24" stroke="#ffb74d" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
  <line x1="80" y1="18" x2="84" y2="27" stroke="#ffb74d" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
  <line x1="120" y1="18" x2="116" y2="27" stroke="#ffb74d" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
</svg>
