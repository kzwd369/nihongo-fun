<!-- Japanese マジックテープ = hook-and-loop fastener. A kid's shoe fastened with a hook-and-loop strap. -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="mtjp-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffe082"/>
      <stop offset="100%" stop-color="#fff8e1"/>
    </linearGradient>
  </defs>
  <rect width="200" height="160" fill="url(#mtjp-bg)" rx="8"/>
  <!-- A kid's shoe with a hook-and-loop strap -->
  <!-- shoe body -->
  <path d="M22 116 Q26 80 66 78 Q98 77 120 88 L162 100 Q176 104 176 116 L176 124 Q176 128 172 128 L28 128 Q22 128 22 122 Z" fill="#ef5350" stroke="#b71c1c" stroke-width="1.2"/>
  <!-- sole -->
  <rect x="22" y="124" width="154" height="9" rx="4" fill="#fff" stroke="#bdbdbd" stroke-width="0.8"/>
  <!-- shoe opening -->
  <path d="M66 78 Q84 86 100 88 L100 106 Q80 104 68 96 Z" fill="#fff" opacity="0.85"/>
  <!-- loop side strap on shoe -->
  <rect x="86" y="104" width="46" height="13" rx="2" fill="#37474f"/>
  <!-- texture dots = the scratchy surface -->
  <circle cx="92" cy="108" r="1" fill="#90a4ae"/>
  <circle cx="99" cy="108" r="1" fill="#90a4ae"/>
  <circle cx="106" cy="108" r="1" fill="#90a4ae"/>
  <circle cx="113" cy="108" r="1" fill="#90a4ae"/>
  <circle cx="120" cy="108" r="1" fill="#90a4ae"/>
  <circle cx="127" cy="108" r="1" fill="#90a4ae"/>
  <circle cx="95" cy="113" r="1" fill="#90a4ae"/>
  <circle cx="102" cy="113" r="1" fill="#90a4ae"/>
  <circle cx="109" cy="113" r="1" fill="#90a4ae"/>
  <circle cx="116" cy="113" r="1" fill="#90a4ae"/>
  <circle cx="123" cy="113" r="1" fill="#90a4ae"/>
  <!-- peeled-up strap end -->
  <path d="M130 104 Q154 96 162 78 L154 73 Q142 92 126 100 Z" fill="#455a64"/>
  <circle cx="146" cy="86" r="1" fill="#cfd8dc"/>
  <circle cx="150" cy="82" r="1" fill="#cfd8dc"/>
  <circle cx="142" cy="90" r="1" fill="#cfd8dc"/>
  <circle cx="153" cy="78" r="1" fill="#cfd8dc"/>
  <!-- "rip!" motion lines (symbolic, no text) -->
  <line x1="164" y1="70" x2="172" y2="64" stroke="#e64a19" stroke-width="2" stroke-linecap="round"/>
  <line x1="166" y1="76" x2="176" y2="74" stroke="#e64a19" stroke-width="2" stroke-linecap="round"/>
  <line x1="160" y1="64" x2="166" y2="56" stroke="#e64a19" stroke-width="2" stroke-linecap="round"/>
</svg>
