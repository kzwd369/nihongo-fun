<!-- English "klaxon" evokes an alarm siren — correct for Japanese クラクション: "car horn" -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble "klaxon?" -->
  <rect x="10" y="12" width="70" height="22" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="30,34 40,34 35,42" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="45" y="27" font-size="11" fill="#424242" text-anchor="middle">"klaxon?"</text>
  <!-- Old-fashioned alarm horn (factory/ship siren) on left -->
  <!-- Mounting bracket -->
  <rect x="14" y="92" width="6" height="24" fill="#78909c"/>
  <!-- Horn bell (flared cone) -->
  <path d="M20,80 L20,118 L62,130 L62,68 Z" fill="#90a4ae" stroke="#546e7a" stroke-width="1.5"/>
  <!-- Inner cone shading -->
  <path d="M20,85 L20,113 L58,124 L58,74 Z" fill="#b0bec5" opacity="0.6"/>
  <!-- Horn rim highlight -->
  <ellipse cx="62" cy="99" rx="3" ry="31" fill="#607d8b"/>
  <!-- Back cylinder -->
  <rect x="10" y="88" width="12" height="22" fill="#546e7a" rx="2"/>
  <!-- Loud alarm waves -->
  <path d="M70,75 Q80,99 70,123" fill="none" stroke="#e53935" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M78,70 Q92,99 78,128" fill="none" stroke="#e53935" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Alarm text -->
  <text x="52" y="58" font-size="12" font-weight="bold" fill="#e53935" text-anchor="middle">ALARM!</text>
  <!-- Red X over alarm horn (wrong association) -->
  <line x1="14" y1="66" x2="68" y2="132" stroke="#e53935" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
  <line x1="68" y1="66" x2="14" y2="132" stroke="#e53935" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
  <!-- Steering wheel with horn button (right = correct) -->
  <!-- Outer wheel -->
  <circle cx="140" cy="90" r="28" fill="none" stroke="#37474f" stroke-width="5"/>
  <!-- Inner hub -->
  <circle cx="140" cy="90" r="12" fill="#546e7a" stroke="#263238" stroke-width="1"/>
  <!-- Horn button center -->
  <circle cx="140" cy="90" r="7" fill="#ffca28" stroke="#f57f17" stroke-width="1"/>
  <!-- Spokes -->
  <line x1="140" y1="78" x2="140" y2="62" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <line x1="128" y1="90" x2="112" y2="90" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <line x1="152" y1="90" x2="168" y2="90" stroke="#37474f" stroke-width="4" stroke-linecap="round"/>
  <!-- Honk! with music note -->
  <text x="178" y="60" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">honk!</text>
  <text x="178" y="74" font-size="14" font-weight="bold" fill="#2e7d32" text-anchor="middle">♪</text>
  <!-- "car horn ✓" label -->
  <text x="140" y="140" font-size="10" font-weight="bold" fill="#2e7d32" text-anchor="middle">car horn ✓</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
