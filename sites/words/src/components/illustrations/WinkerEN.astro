<!-- English "winker" is not standard — correct: "turn signal" (US) / "indicator" (UK) / "blinker" (informal US) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "winker?" crossed out -->
  <rect x="15" y="18" width="75" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="35,46 45,46 40,54" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="52" y="37" font-size="11" fill="#424242" text-anchor="middle">"winker?"</text>
  <!-- Red X over phrase -->
  <line x1="20" y1="20" x2="85" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="85" y1="20" x2="20" y2="44" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Confused English speaker imagining a winking person -->
  <!-- Head -->
  <circle cx="40" cy="80" r="13" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M28,78 Q28,66 40,64 Q52,66 52,78 L49,74 Q40,70 31,74 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="36" cy="80" r="1.5" fill="#3e2723"/>
  <circle cx="44" cy="80" r="1.5" fill="#3e2723"/>
  <!-- Confused mouth -->
  <path d="M35,87 Q38,85 41,87 Q44,89 47,87" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="22" y="62" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="56" y="66" font-size="16" font-weight="bold" fill="#ff7043">?</text>
  <!-- Body -->
  <rect x="30" y="93" width="20" height="22" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms -->
  <line x1="30" y1="96" x2="18" y2="88" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="50" y1="96" x2="62" y2="88" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Thought bubble with winking face -->
  <circle cx="72" cy="118" r="3" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <circle cx="80" cy="125" r="4" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <!-- "winking person?" label -->
  <text x="40" y="135" font-size="8" fill="#e53935" text-anchor="middle">winking person?</text>
  <!-- Right side: car rear with turn signal -->
  <!-- Car body -->
  <rect x="108" y="60" width="80" height="45" fill="#ef5350" rx="6"/>
  <!-- Rear window -->
  <rect x="115" y="65" width="66" height="15" fill="#b3e5fc" rx="3"/>
  <!-- License plate -->
  <rect x="135" y="88" width="28" height="10" fill="white" stroke="#424242" stroke-width="0.5" rx="1"/>
  <!-- Left tail light (red) -->
  <rect x="110" y="85" width="10" height="12" fill="#c62828" rx="2"/>
  <!-- Right turn signal (amber, flashing) -->
  <rect x="178" y="85" width="10" height="12" fill="#ffa726" rx="2"/>
  <!-- Flashing glow around turn signal -->
  <circle cx="183" cy="91" r="10" fill="#ffb74d" opacity="0.5"/>
  <circle cx="183" cy="91" r="14" fill="#ffcc80" opacity="0.3"/>
  <!-- Flash lines -->
  <line x1="195" y1="82" x2="199" y2="78" stroke="#ff9800" stroke-width="2" stroke-linecap="round"/>
  <line x1="195" y1="91" x2="200" y2="91" stroke="#ff9800" stroke-width="2" stroke-linecap="round"/>
  <line x1="195" y1="100" x2="199" y2="104" stroke="#ff9800" stroke-width="2" stroke-linecap="round"/>
  <!-- Wheels -->
  <circle cx="120" cy="108" r="7" fill="#263238"/>
  <circle cx="120" cy="108" r="3" fill="#607d8b"/>
  <circle cx="176" cy="108" r="7" fill="#263238"/>
  <circle cx="176" cy="108" r="3" fill="#607d8b"/>
  <!-- "turn signal ✓" label -->
  <text x="148" y="128" font-size="10" font-weight="bold" fill="#2e7d32" text-anchor="middle">turn signal ✓</text>
  <text x="148" y="140" font-size="9" fill="#2e7d32" text-anchor="middle">/ blinker ✓</text>
  <!-- Floor -->
  <rect x="0" y="148" width="200" height="12" fill="#ffccbc" rx="0"/>
</svg>
