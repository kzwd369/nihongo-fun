<!-- Questioning: a character head with a big question mark and multiple floating "?" symbols -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Background -->
  <rect width="200" height="160" rx="8" fill="#ede7f6"/>

  <!-- Character head (tilted to side) -->
  <circle cx="80" cy="90" r="30" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M52,80 Q60,58 80,56 Q100,58 108,80 Q106,72 95,70 Q85,66 75,70 Q60,74 52,80Z" fill="#6d4c41"/>
  <!-- Eyes (one squinted / puzzled) -->
  <circle cx="70" cy="88" r="2.5" fill="#3e2723"/>
  <line x1="85" y1="87" x2="93" y2="89" stroke="#3e2723" stroke-width="2" stroke-linecap="round"/>
  <!-- Small mouth (open, confused) -->
  <ellipse cx="80" cy="102" rx="3" ry="4" fill="#6a1b9a" opacity="0.7"/>
  <!-- Blush (subtle) -->
  <circle cx="65" cy="100" r="2" fill="#f48fb1" opacity="0.5"/>
  <circle cx="95" cy="100" r="2" fill="#f48fb1" opacity="0.5"/>

  <!-- Big question mark over head -->
  <text x="135" y="65" font-family="sans-serif" font-size="56" font-weight="bold" fill="#7e57c2">?</text>

  <!-- Small question marks floating -->
  <text x="40" y="45" font-family="sans-serif" font-size="20" font-weight="bold" fill="#9575cd" opacity="0.8">?</text>
  <text x="160" y="110" font-family="sans-serif" font-size="16" font-weight="bold" fill="#9575cd" opacity="0.7">?</text>
  <text x="170" y="85" font-family="sans-serif" font-size="14" font-weight="bold" fill="#b39ddb" opacity="0.7">?</text>
  <text x="30" y="110" font-family="sans-serif" font-size="14" font-weight="bold" fill="#b39ddb" opacity="0.6">?</text>

  <!-- Exclamation-like emphasis dots above head -->
  <circle cx="60" cy="52" r="2" fill="#ba68c8" opacity="0.6"/>
  <circle cx="100" cy="48" r="2" fill="#ba68c8" opacity="0.6"/>

  <!-- Speech bubble tail from head up to the big ? -->
  <circle cx="112" cy="72" r="4" fill="#d1c4e9"/>
  <circle cx="120" cy="62" r="3" fill="#d1c4e9"/>
</svg>
