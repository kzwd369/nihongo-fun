<!-- Japanese バックミラー = rearview mirror (used for checking behind while driving) -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#e8f5e9" rx="8"/>
  <!-- Windshield frame at top (car interior) -->
  <rect x="0" y="0" width="200" height="22" fill="#81c784" opacity="0.5"/>
  <!-- Rearview mirror (trapezoid, centered top) -->
  <rect x="95" y="10" width="6" height="10" fill="#546e7a"/>
  <polygon points="60,20 140,20 135,60 65,60" fill="#bbdefb" stroke="#0288d1" stroke-width="1.5"/>
  <!-- Reflection inside mirror: road -->
  <polygon points="70,58 130,58 115,30 85,30" fill="#78909c"/>
  <!-- Road center dashes -->
  <rect x="97" y="34" width="6" height="3" fill="white"/>
  <rect x="96" y="42" width="8" height="3" fill="white"/>
  <rect x="95" y="50" width="10" height="4" fill="white"/>
  <!-- Following car in mirror -->
  <rect x="90" y="44" width="20" height="10" fill="#ef5350" rx="2"/>
  <rect x="93" y="40" width="14" height="6" fill="#ffcdd2" rx="1"/>
  <circle cx="94" cy="55" r="2" fill="#212121"/>
  <circle cx="106" cy="55" r="2" fill="#212121"/>
  <!-- Headlights -->
  <circle cx="92" cy="49" r="1" fill="#fff59d"/>
  <circle cx="108" cy="49" r="1" fill="#fff59d"/>
  <!-- Sky in mirror -->
  <rect x="65" y="22" width="70" height="8" fill="#b3e5fc"/>
  <!-- Eye icon (attention / looking) floating near mirror -->
  <ellipse cx="150" cy="40" rx="9" ry="5" fill="white" stroke="#1565c0" stroke-width="1.2"/>
  <circle cx="150" cy="40" r="3" fill="#1565c0"/>
  <circle cx="151" cy="39" r="1" fill="white"/>
  <!-- Motion lines from eye to mirror -->
  <line x1="141" y1="40" x2="136" y2="40" stroke="#1565c0" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Driver (back of head) -->
  <!-- Head -->
  <ellipse cx="80" cy="110" rx="20" ry="22" fill="#ffcc80"/>
  <!-- Hair (back of head) -->
  <path d="M60,108 Q60,85 80,83 Q100,85 100,108 Q100,98 80,95 Q60,98 60,108 Z" fill="#3e2723"/>
  <!-- Ear (side glimpse) -->
  <ellipse cx="100" cy="112" rx="2.5" ry="4" fill="#ffb74d"/>
  <!-- Neck -->
  <rect x="72" y="128" width="16" height="8" fill="#ffcc80"/>
  <!-- Shoulders / body (suit) -->
  <path d="M45,145 Q45,132 80,132 Q115,132 115,145 L115,150 L45,150 Z" fill="#37474f"/>
  <!-- Seat sides visible -->
  <rect x="20" y="125" width="18" height="25" fill="#6d4c41" rx="4"/>
  <rect x="162" y="125" width="18" height="25" fill="#6d4c41" rx="4"/>
  <!-- Label -->
  <text x="100" y="156" font-size="11" font-weight="bold" fill="#2e7d32" text-anchor="middle">バックミラーで確認</text>
</svg>
