<!-- Catchphrases: multiple speech bubbles showing signature phrases from different archetypes -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <!-- Background -->
  <rect width="200" height="160" rx="8" fill="#fff9c4"/>

  <!-- Bubble 1: だってばよ (top-left, orange, Naruto-like) -->
  <path d="M15,25 Q15,15 25,15 L75,15 Q85,15 85,25 L85,42 Q85,52 75,52 L40,52 L32,60 L35,52 L25,52 Q15,52 15,42 Z" fill="#ffb74d" stroke="#e65100" stroke-width="1.5"/>
  <text x="50" y="38" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#bf360c" font-weight="bold">だってばよ</text>

  <!-- Bubble 2: ですわ (top-right, pink, ojou-sama) -->
  <path d="M115,18 Q115,10 125,10 L180,10 Q188,10 188,18 L188,35 Q188,43 180,43 L155,43 L148,50 L150,43 L125,43 Q115,43 115,35 Z" fill="#f8bbd0" stroke="#c2185b" stroke-width="1.5"/>
  <text x="152" y="30" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#880e4f" font-weight="bold">ですわ</text>

  <!-- Bubble 3: でござる (middle-left, brown, samurai) -->
  <path d="M12,68 Q12,60 22,60 L80,60 Q90,60 90,68 L90,85 Q90,93 80,93 L55,93 L48,100 L50,93 L22,93 Q12,93 12,85 Z" fill="#d7ccc8" stroke="#5d4037" stroke-width="1.5"/>
  <text x="51" y="80" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#3e2723" font-weight="bold">でござる</text>

  <!-- Bubble 4: にゃん (middle-right, light purple, catgirl) -->
  <path d="M118,62 Q118,54 128,54 L180,54 Q188,54 188,62 L188,78 Q188,86 180,86 L155,86 L148,93 L150,86 L128,86 Q118,86 118,78 Z" fill="#e1bee7" stroke="#6a1b9a" stroke-width="1.5"/>
  <text x="153" y="74" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#4a148c" font-weight="bold">にゃん</text>

  <!-- Bubble 5: のじゃ (bottom-left, teal, loli-baba) -->
  <path d="M15,108 Q15,100 25,100 L75,100 Q85,100 85,108 L85,125 Q85,133 75,133 L45,133 L38,140 L40,133 L25,133 Q15,133 15,125 Z" fill="#b2dfdb" stroke="#00695c" stroke-width="1.5"/>
  <text x="50" y="120" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#004d40" font-weight="bold">のじゃ</text>

  <!-- Bubble 6: あらあら (bottom-right, lavender, onee-san) -->
  <path d="M115,103 Q115,95 125,95 L180,95 Q188,95 188,103 L188,120 Q188,128 180,128 L158,128 L152,135 L154,128 L125,128 Q115,128 115,120 Z" fill="#c5cae9" stroke="#283593" stroke-width="1.5"/>
  <text x="152" y="115" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#1a237e" font-weight="bold">あらあら</text>

  <!-- Small sparkle accents -->
  <circle cx="100" cy="30" r="1.5" fill="#fdd835" opacity="0.7"/>
  <circle cx="105" cy="75" r="1.5" fill="#fdd835" opacity="0.7"/>
  <circle cx="98" cy="115" r="1.5" fill="#fdd835" opacity="0.7"/>
  <path d="M100,55 L101,52 L103,55 L101,58Z" fill="#fbc02d" opacity="0.6"/>
  <path d="M102,150 L103,147 L105,150 L103,153Z" fill="#fbc02d" opacity="0.6"/>
</svg>
