<!-- English "goal in" is not used — correct: "cross the finish line" / "tie the knot" -->
<svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" style="margin: 8px auto; display: block;">
  <rect width="200" height="160" fill="#fff3e0" rx="8"/>
  <!-- Speech bubble with "goal in?" crossed out -->
  <rect x="15" y="15" width="75" height="28" fill="white" stroke="#bdbdbd" stroke-width="1" rx="6"/>
  <polygon points="35,43 45,43 40,50" fill="white" stroke="#bdbdbd" stroke-width="1"/>
  <text x="52" y="33" font-size="11" fill="#424242" text-anchor="middle">"goal in?"</text>
  <!-- Red X over phrase -->
  <line x1="20" y1="17" x2="85" y2="41" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <line x1="85" y1="17" x2="20" y2="41" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
  <!-- Confused English speaker -->
  <!-- Head -->
  <circle cx="40" cy="75" r="12" fill="#ffe0b2"/>
  <!-- Hair -->
  <path d="M28,73 Q28,62 40,60 Q52,62 52,73 L49,69 Q40,65 31,69 Z" fill="#8d6e63"/>
  <!-- Confused eyes -->
  <circle cx="36" cy="75" r="1.5" fill="#3e2723"/>
  <circle cx="44" cy="75" r="1.5" fill="#3e2723"/>
  <!-- Confused mouth (wavy) -->
  <path d="M35,82 Q38,80 41,82 Q44,84 47,82" fill="none" stroke="#3e2723" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Question marks -->
  <text x="22" y="58" font-size="14" font-weight="bold" fill="#ff7043">?</text>
  <text x="56" y="62" font-size="18" font-weight="bold" fill="#ff7043">?</text>
  <!-- Body -->
  <rect x="31" y="88" width="18" height="20" fill="#90caf9" rx="3"/>
  <!-- Shrugging arms -->
  <line x1="31" y1="91" x2="20" y2="83" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <line x1="49" y1="91" x2="60" y2="83" stroke="#90caf9" stroke-width="5" stroke-linecap="round"/>
  <!-- Marathon runner crossing finish line -->
  <!-- Finish line poles -->
  <rect x="108" y="40" width="3" height="55" fill="#616161"/>
  <rect x="178" y="40" width="3" height="55" fill="#616161"/>
  <!-- Checkered banner -->
  <rect x="108" y="40" width="73" height="12" fill="white" stroke="#424242" stroke-width="0.5"/>
  <rect x="108" y="40" width="8" height="6" fill="#212121"/>
  <rect x="124" y="40" width="8" height="6" fill="#212121"/>
  <rect x="140" y="40" width="8" height="6" fill="#212121"/>
  <rect x="156" y="40" width="8" height="6" fill="#212121"/>
  <rect x="172" y="40" width="8" height="6" fill="#212121"/>
  <rect x="116" y="46" width="8" height="6" fill="#212121"/>
  <rect x="132" y="46" width="8" height="6" fill="#212121"/>
  <rect x="148" y="46" width="8" height="6" fill="#212121"/>
  <rect x="164" y="46" width="8" height="6" fill="#212121"/>
  <!-- FINISH text -->
  <text x="144" y="63" font-size="8" font-weight="bold" fill="#424242" text-anchor="middle">FINISH</text>
  <!-- Red finish tape being broken -->
  <path d="M108,70 Q140,74 175,70" stroke="#e53935" stroke-width="2" fill="none" stroke-dasharray="2,1"/>
  <!-- Runner -->
  <!-- Head -->
  <circle cx="140" cy="80" r="8" fill="#ffcc80"/>
  <!-- Hair -->
  <path d="M132,78 Q132,70 140,69 Q148,70 148,78 L146,75 Q140,73 134,75 Z" fill="#3e2723"/>
  <!-- Determined eye -->
  <circle cx="143" cy="80" r="1" fill="#3e2723"/>
  <!-- Smile -->
  <path d="M141,84 Q144,86 146,84" fill="none" stroke="#3e2723" stroke-width="1" stroke-linecap="round"/>
  <!-- Body leaning forward -->
  <path d="M135,88 L148,90 L150,105 L137,103 Z" fill="#ff7043"/>
  <!-- Number on shirt -->
  <text x="143" y="100" font-size="7" font-weight="bold" fill="white" text-anchor="middle">1</text>
  <!-- Arms (running) -->
  <line x1="135" y1="90" x2="125" y2="85" stroke="#ffcc80" stroke-width="4" stroke-linecap="round"/>
  <line x1="148" y1="90" x2="158" y2="95" stroke="#ffcc80" stroke-width="4" stroke-linecap="round"/>
  <!-- Legs (mid-stride) -->
  <line x1="140" y1="105" x2="132" y2="118" stroke="#1976d2" stroke-width="4" stroke-linecap="round"/>
  <line x1="145" y1="105" x2="155" y2="117" stroke="#1976d2" stroke-width="4" stroke-linecap="round"/>
  <!-- Shoes -->
  <ellipse cx="131" cy="120" rx="4" ry="2" fill="#212121"/>
  <ellipse cx="156" cy="119" rx="4" ry="2" fill="#212121"/>
  <!-- Speed lines -->
  <line x1="118" y1="95" x2="108" y2="95" stroke="#ff7043" stroke-width="1.5" stroke-linecap="round"/>
  <line x1="120" y1="100" x2="112" y2="100" stroke="#ff7043" stroke-width="1.5" stroke-linecap="round"/>
  <!-- "cross the finish line ✓" label -->
  <text x="144" y="138" font-size="9" font-weight="bold" fill="#2e7d32" text-anchor="middle">cross the finish line ✓</text>
  <!-- "tie the knot ✓" small label with ring -->
  <circle cx="25" cy="128" r="5" fill="none" stroke="#fbc02d" stroke-width="2"/>
  <circle cx="25" cy="125" r="2" fill="#81d4fa"/>
  <text x="60" y="132" font-size="8" font-weight="bold" fill="#2e7d32" text-anchor="middle">tie the knot ✓</text>
  <!-- Floor -->
  <rect x="0" y="145" width="200" height="15" fill="#ffccbc" rx="0"/>
</svg>
