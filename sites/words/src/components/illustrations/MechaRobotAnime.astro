<!-- Mecha / robot anime: a giant armored robot with a cockpit and a glowing beam saber, standing against a night cityscape and starry sky -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 160" width="200" height="160" style="margin: 8px auto; display: block;">
  <defs>
    <linearGradient id="mechaSky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0d1b3e"/>
      <stop offset="60%" stop-color="#1a237e"/>
      <stop offset="100%" stop-color="#311b92"/>
    </linearGradient>
    <linearGradient id="beam" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#b3e5fc"/>
      <stop offset="100%" stop-color="#26c6da"/>
    </linearGradient>
  </defs>

  <!-- Night sky background -->
  <rect width="200" height="160" rx="8" fill="url(#mechaSky)"/>

  <!-- Stars -->
  <circle cx="20" cy="18" r="1.3" fill="#fff"/>
  <circle cx="46" cy="30" r="1" fill="#fff" opacity="0.8"/>
  <circle cx="160" cy="16" r="1.3" fill="#fff"/>
  <circle cx="182" cy="34" r="1" fill="#fff" opacity="0.8"/>
  <circle cx="120" cy="14" r="1" fill="#fff" opacity="0.7"/>
  <circle cx="90" cy="22" r="0.9" fill="#fff" opacity="0.7"/>
  <path d="M30,46 L31,49 L34,50 L31,51 L30,54 L29,51 L26,50 L29,49Z" fill="#fff" opacity="0.9"/>
  <path d="M172,52 L173,55 L176,56 L173,57 L172,60 L171,57 L168,56 L171,55Z" fill="#fff" opacity="0.85"/>

  <!-- City skyline silhouette -->
  <rect x="0" y="118" width="22" height="42" fill="#0d1230"/>
  <rect x="24" y="100" width="18" height="60" fill="#11163a"/>
  <rect x="160" y="108" width="20" height="52" fill="#11163a"/>
  <rect x="182" y="122" width="18" height="38" fill="#0d1230"/>
  <!-- City windows -->
  <rect x="6" y="124" width="3" height="4" fill="#ffd54f" opacity="0.8"/>
  <rect x="13" y="132" width="3" height="4" fill="#ffd54f" opacity="0.7"/>
  <rect x="29" y="108" width="3" height="4" fill="#ffd54f" opacity="0.8"/>
  <rect x="35" y="120" width="3" height="4" fill="#ffd54f" opacity="0.7"/>
  <rect x="166" y="116" width="3" height="4" fill="#ffd54f" opacity="0.8"/>
  <rect x="187" y="130" width="3" height="4" fill="#ffd54f" opacity="0.7"/>

  <!-- Ground -->
  <rect x="0" y="150" width="200" height="10" fill="#080b1c"/>

  <!-- ===== Giant robot ===== -->
  <!-- Legs -->
  <rect x="84" y="118" width="12" height="32" rx="2" fill="#546e7a" stroke="#263238" stroke-width="1.2"/>
  <rect x="104" y="118" width="12" height="32" rx="2" fill="#455a64" stroke="#263238" stroke-width="1.2"/>
  <!-- Feet -->
  <rect x="80" y="148" width="18" height="6" rx="1.5" fill="#37474f" stroke="#263238" stroke-width="1"/>
  <rect x="102" y="148" width="18" height="6" rx="1.5" fill="#37474f" stroke="#263238" stroke-width="1"/>
  <!-- Knee accents -->
  <circle cx="90" cy="128" r="2" fill="#ffca28"/>
  <circle cx="110" cy="128" r="2" fill="#ffca28"/>

  <!-- Torso / chest armor -->
  <rect x="78" y="78" width="44" height="42" rx="4" fill="#607d8b" stroke="#263238" stroke-width="1.5"/>
  <!-- Chest vents -->
  <rect x="84" y="86" width="14" height="4" rx="1" fill="#37474f"/>
  <rect x="102" y="86" width="14" height="4" rx="1" fill="#37474f"/>
  <!-- Cockpit (glowing core) -->
  <circle cx="100" cy="104" r="9" fill="#1de9b6" stroke="#00897b" stroke-width="1.5"/>
  <circle cx="100" cy="104" r="4.5" fill="#e0f7fa"/>
  <!-- Waist -->
  <rect x="86" y="116" width="28" height="8" rx="2" fill="#455a64" stroke="#263238" stroke-width="1.2"/>

  <!-- Shoulders -->
  <rect x="62" y="74" width="18" height="18" rx="3" fill="#78909c" stroke="#263238" stroke-width="1.4"/>
  <rect x="120" y="74" width="18" height="18" rx="3" fill="#78909c" stroke="#263238" stroke-width="1.4"/>
  <circle cx="71" cy="83" r="2.5" fill="#ef5350"/>
  <circle cx="129" cy="83" r="2.5" fill="#ef5350"/>

  <!-- Left arm (holding beam saber) -->
  <rect x="60" y="90" width="10" height="24" rx="3" fill="#546e7a" stroke="#263238" stroke-width="1.2"/>
  <!-- Beam saber hilt -->
  <rect x="58" y="80" width="6" height="12" rx="1.5" fill="#cfd8dc" stroke="#263238" stroke-width="1" transform="rotate(-18 61 86)"/>
  <!-- Beam blade glow -->
  <path d="M58,80 L44,28" stroke="url(#beam)" stroke-width="9" stroke-linecap="round" opacity="0.45"/>
  <path d="M58,80 L46,30" stroke="url(#beam)" stroke-width="4" stroke-linecap="round"/>
  <path d="M55,68 L50,46" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" opacity="0.9"/>

  <!-- Right arm (with beam cannon) -->
  <rect x="130" y="90" width="10" height="22" rx="3" fill="#455a64" stroke="#263238" stroke-width="1.2"/>
  <rect x="136" y="98" width="22" height="10" rx="2" fill="#37474f" stroke="#263238" stroke-width="1.2"/>
  <circle cx="158" cy="103" r="4" fill="#ff7043"/>
  <circle cx="158" cy="103" r="2" fill="#fff3e0"/>

  <!-- Head -->
  <rect x="90" y="62" width="20" height="18" rx="3" fill="#90a4ae" stroke="#263238" stroke-width="1.5"/>
  <!-- Visor eyes (glowing slit) -->
  <rect x="93" y="69" width="14" height="4" rx="2" fill="#ffeb3b"/>
  <!-- V-fin crest -->
  <polygon points="92,62 86,52 96,60" fill="#ffca28" stroke="#263238" stroke-width="0.8"/>
  <polygon points="108,62 114,52 104,60" fill="#ffca28" stroke="#263238" stroke-width="0.8"/>
  <!-- Head antenna -->
  <line x1="100" y1="62" x2="100" y2="54" stroke="#cfd8dc" stroke-width="1.5"/>
  <circle cx="100" cy="53" r="1.5" fill="#ef5350"/>

  <!-- Beam impact sparkles -->
  <path d="M44,28 L46,24 L48,28 L46,32Z" fill="#e0f7fa"/>
  <circle cx="40" cy="36" r="1.5" fill="#b3e5fc"/>
  <circle cx="52" cy="22" r="1.2" fill="#fff"/>
</svg>
